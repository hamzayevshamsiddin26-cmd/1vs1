		NeonColor = Color3.fromRGB(63, 82, 56), -- Classic CS 1.6 Olive Green AWP
		SecondaryColor = Color3.fromRGB(27, 29, 31),
		FireSoundId = &quot;rbxassetid://9114222085&quot;,
		ReloadSoundId = &quot;rbxassetid://9114221580&quot;,

--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ReplicatedStorage.Modules.WeaponConfig
	Description: Complete configuration and procedural 3D cyberpunk model generator
	for all 5 weapon classes (Assault Rifle, Sniper Rifle, Shotgun, SMG, Pistol).
]]

local WeaponConfig = {}

export type WeaponStats = {
	Id: string,
	Name: string,
	Category: string,
	Slot: number,
	FireMode: &quot;Auto&quot; | &quot;Semi&quot;,
	BaseDamage: number,
	HeadshotMultiplier: number,
	FireRate: number, -- Seconds between shots
	MagazineSize: number,
	ReserveAmmo: number,
	ReloadTime: number, -- Seconds
	Pellets: number,
	HipSpread: number, -- Degrees
	AdsSpread: number, -- Degrees
	AdsFov: number,
	UseSniperScope: boolean,
	MaxRange: number,
	RecoilPitch: number,
	RecoilYaw: number,
	RecoilKickback: number,
	EquipTime: number,
	NeonColor: Color3,
	SecondaryColor: Color3,
	FireSoundId: string,
	ReloadSoundId: string,
	FirePitch: number,
	ModelScale: Vector3,
	BarrelLength: number,
}

WeaponConfig.SlotOrder = {
	&quot;AssaultRifle&quot;,
	&quot;SniperRifle&quot;,
	&quot;Shotgun&quot;,
	&quot;SMG&quot;,
	&quot;Pistol&quot;,
}


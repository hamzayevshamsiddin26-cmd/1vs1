local P1KillsLabel: TextLabel? = nil
local P2KillsLabel: TextLabel? = nil
local P1HealthBarFill: Frame? = nil
local P2HealthBarFill: Frame? = nil
local P1HealthText: TextLabel? = nil
local P2HealthText: TextLabel? = nil

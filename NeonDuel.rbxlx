function HUDController.SetVisible(visible: boolean)
	if HudGui then
		HudGui.Enabled = visible
	end
	if not visible and MatchEndOverlay then
		MatchEndOverlay.Visible = false
	end
end

function HUDController.UpdateMatchSnapshot(snapshot: any)
	if type(snapshot) ~= &quot;table&quot; then
		return
	end

	if P1NameLabel then
		P1NameLabel.Text = string.upper(tostring(snapshot.P1Name or &quot;PLAYER 1&quot;))
	end
	if P2NameLabel then
		P2NameLabel.Text = string.upper(tostring(snapshot.P2Name or &quot;PLAYER 2&quot;))
	end
	if P1KillsLabel then
		P1KillsLabel.Text = tostring(snapshot.P1Kills or 0)
	end
	if P2KillsLabel then
		P2KillsLabel.Text = tostring(snapshot.P2Kills or 0)
	end

	local p1HP = math.clamp(tonumber(snapshot.P1Health) or 100, 0, 100)
	local p2HP = math.clamp(tonumber(snapshot.P2Health) or 100, 0, 100)

	if P1HealthBarFill then
		TweenService:Create(P1HealthBarFill, TweenInfo.new(0.15), {
			Size = UDim2.fromScale(p1HP / 100, 1),
		}):Play()
	end
	if P2HealthBarFill then
		TweenService:Create(P2HealthBarFill, TweenInfo.new(0.15), {
			Size = UDim2.fromScale(p2HP / 100, 1),
		}):Play()
	end
	if P1HealthText then
		P1HealthText.Text = tostring(p1HP) .. &quot; / 100 HP&quot;
	end
	if P2HealthText then
		P2HealthText.Text = tostring(p2HP) .. &quot; / 100 HP&quot;
	end

	-- Update Local Player Bottom-Left Vitals
	local myHP = if snapshot.P1Name == LocalPlayer.Name then p1HP else p2HP
	if LocalHPNumber then
		LocalHPNumber.Text = tostring(myHP)
		LocalHPNumber.TextColor3 = if myHP &gt; 35
			then Color3.fromRGB(0, 245, 255)
			else Color3.fromRGB(255, 45, 110)
	end
	if LocalHPBarFill then
		TweenService:Create(LocalHPBarFill, TweenInfo.new(0.15), {
			Size = UDim2.fromScale(myHP / 100, 1),
			BackgroundColor3 = if myHP &gt; 35
				then Color3.fromRGB(0, 245, 255)
				else Color3.fromRGB(255, 45, 110),
		}):Play()
	end

	-- Update 120-Second Arena Rotation Countdown Timer
	local remSeconds = tonumber(snapshot.ArenaTimeRemaining) or 120
	if ArenaTimerLabel then
		ArenaTimerLabel.Text = formatTimeMMSS(remSeconds)
		if remSeconds &lt;= 10 then
			ArenaTimerLabel.TextColor3 = Color3.fromRGB(255, 50, 165)
			if remSeconds ~= lastWarningSecond and remSeconds &gt; 0 then
				lastWarningSecond = remSeconds
				SoundManager.Play2D(&quot;ArenaWarning&quot;, 1.15, 0.35)
			end
		else
			ArenaTimerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end

	if ArenaNameLabel and snapshot.ArenaName then
		ArenaNameLabel.Text = tostring(snapshot.ArenaName)
	end
	if WinGoalLabel and snapshot.WinCondition then
		WinGoalLabel.Text = &quot;FIRST TO &quot; .. tostring(snapshot.WinCondition) .. &quot; KILLS&quot;
	end
end

function HUDController.UpdateWeaponHUD(equippedWeaponId: string, isReloading: boolean, ammoMap: any)
	local stats = WeaponConfig.GetWeapon(equippedWeaponId)
	if not stats then
		return
	end

	if WeaponNameLabel then
		WeaponNameLabel.Text = stats.Name
		WeaponNameLabel.TextColor3 = stats.NeonColor
	end

	local wAmmo = if type(ammoMap) == &quot;table&quot; then ammoMap[equippedWeaponId] else nil
	local mag = if wAmmo then wAmmo.Mag else stats.MagazineSize
	local res = if wAmmo then wAmmo.Reserve else stats.ReserveAmmo

	if AmmoMagLabel then
		AmmoMagLabel.Text = tostring(mag)
		AmmoMagLabel.TextColor3 = if mag &gt; 0
			then Color3.fromRGB(255, 255, 255)
			else Color3.fromRGB(255, 55, 100)
	end
	if AmmoReserveLabel then
		AmmoReserveLabel.Text = &quot;/ &quot; .. tostring(res)
	end
	if ReloadingBanner then
		ReloadingBanner.Text = if isReloading then &quot;RELOADING...&quot; else &quot;[R] RELOAD&quot;
		ReloadingBanner.TextColor3 = if isReloading
			then Color3.fromRGB(255, 50, 175)
			else Color3.fromRGB(160, 220, 255)
	end

	for wId, btn in pairs(SlotFrames) do
		local stroke = btn:FindFirstChild(&quot;SlotStroke&quot;) :: UIStroke?
		local isSelected = (wId == equippedWeaponId)
		btn.BackgroundColor3 = if isSelected
			then Color3.fromRGB(45, 24, 72)
			else Color3.fromRGB(18, 22, 36)
		if stroke then
			stroke.Color = if isSelected
				then Color3.fromRGB(0, 245, 255)
				else Color3.fromRGB(70, 80, 110)
			stroke.Thickness = if isSelected then 2.0 else 1.1
		end
	end
end

function HUDController.SetCrosshairState(spreadPixels: number, isAiming: boolean, useSniperScope: boolean)
	if SniperScopeFrame then
		SniperScopeFrame.Visible = (isAiming and useSniperScope)
	end
	if CrosshairRoot then
		CrosshairRoot.Visible = not (isAiming and useSniperScope)
	end
	if #CrosshairBars == 4 then
		local gap = math.clamp(math.floor(spreadPixels), 4, 38)
		CrosshairBars[1].Position = UDim2.fromOffset(1, -(gap + 10))
		CrosshairBars[2].Position = UDim2.fromOffset(1, gap)
		CrosshairBars[3].Position = UDim2.fromOffset(-(gap + 10), 1)
		CrosshairBars[4].Position = UDim2.fromOffset(gap, 1)
	end
end

function HUDController.PlayArenaRotationAnimation(payload: any)
	if not ArenaTransitionOverlay or not ArenaTransitionTitle or not ArenaTransitionSub or not ArenaTransitionHPNote then
		return
	end

	SoundManager.Play2D(&quot;ArenaSwitch&quot;)

	ArenaTransitionTitle.Text = &quot;ARENA CHANGING // &quot; .. tostring(payload.NewArenaName or &quot;NEXT SECTOR&quot;)
	ArenaTransitionSub.Text = tostring(payload.NewArenaSubtitle or &quot;2-MINUTE ROTATION COMPLETE&quot;)
	ArenaTransitionHPNote.Text = string.format(
		&quot;HP PRESERVED — P1: %d HP  |  P2: %d HP&quot;,
		tonumber(payload.P1PreservedHP) or 100,
		tonumber(payload.P2PreservedHP) or 100
	)

	ArenaTransitionOverlay.BackgroundTransparency = 1
	ArenaTransitionOverlay.Visible = true

	TweenService:Create(ArenaTransitionOverlay, TweenInfo.new(0.35), {
		BackgroundTransparency = 0.15,
	}):Play()

	task.delay(1.85, function()
		if ArenaTransitionOverlay then
			local fadeOut = TweenService:Create(ArenaTransitionOverlay, TweenInfo.new(0.45), {
				BackgroundTransparency = 1,
			})
			fadeOut:Play()
			fadeOut.Completed:Connect(function()
				if ArenaTransitionOverlay then
					ArenaTransitionOverlay.Visible = false
				end
			end)
		end
	end)
end

function HUDController.ShowDamageIndicator(info: any)
	if type(info) ~= &quot;table&quot; then
		return
	end

	if info.Type == &quot;Dealt&quot; then
		local isHS = (info.IsHeadshot == true)
		SoundManager.Play2D(if isHS then &quot;Headshot&quot; else &quot;Hitmarker&quot;)

		if HitmarkerFrame then
			HitmarkerFrame.Visible = true
			local color = if isHS then Color3.fromRGB(255, 40, 165) else Color3.fromRGB(0, 255, 240)
			for _, child in ipairs(HitmarkerFrame:GetChildren()) do
				if child:IsA(&quot;Frame&quot;) then
					child.BackgroundColor3 = color
				end
			end
			task.delay(0.16, function()
				if HitmarkerFrame then
					HitmarkerFrame.Visible = false
				end
			end)
		end

		if HeadshotLabel then
			HeadshotLabel.Text = if isHS
				then (&quot;CRITICAL HEADSHOT! -&quot; .. tostring(info.Damage))
				else (&quot;-&quot; .. tostring(info.Damage) .. &quot; HP&quot;)
			HeadshotLabel.TextColor3 = if isHS
				then Color3.fromRGB(255, 45, 175)
				else Color3.fromRGB(0, 245, 255)
			task.delay(0.65, function()
				if HeadshotLabel then
					HeadshotLabel.Text = &quot;&quot;
				end
			end)
		end

		-- Spawn 3D Floating Billboard Damage Number at hit position
		if typeof(info.HitPosition) == &quot;Vector3&quot; then
			local anchor = Instance.new(&quot;Part&quot;)
			anchor.Size = Vector3.new(0.2, 0.2, 0.2)
			anchor.Transparency = 1
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.Position = info.HitPosition + Vector3.new(0, 1.2, 0)
			anchor.Parent = Workspace

			local bGui = Instance.new(&quot;BillboardGui&quot;)
			bGui.Size = UDim2.fromOffset(100, 36)
			bGui.AlwaysOnTop = true
			bGui.Parent = anchor

			local txt = Instance.new(&quot;TextLabel&quot;)
			txt.Size = UDim2.fromScale(1, 1)
			txt.BackgroundTransparency = 1
			txt.Font = Enum.Font.Michroma
			txt.Text = &quot;-&quot; .. tostring(info.Damage)
			txt.TextColor3 = if isHS then Color3.fromRGB(255, 40, 165) else Color3.fromRGB(0, 255, 240)
			txt.TextSize = if isHS then 22 else 17
			txt.Parent = bGui

			TweenService:Create(anchor, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = anchor.Position + Vector3.new(0, 3.2, 0),
			}):Play()

			task.delay(0.65, function()
				anchor:Destroy()
			end)
		end
	elseif info.Type == &quot;Taken&quot; then
		if DamageVignette then
			DamageVignette.BackgroundTransparency = 0.55
			TweenService:Create(DamageVignette, TweenInfo.new(0.45), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end
end

function HUDController.PushKillFeed(killData: any)
	if not KillFeedContainer or type(killData) ~= &quot;table&quot; then
		return
	end

	local item = Instance.new(&quot;Frame&quot;)
	item.Size = UDim2.fromOffset(300, 28)
	item.BackgroundColor3 = Color3.fromRGB(14, 16, 30)
	item.BackgroundTransparency = 0.2
	item.BorderSizePixel = 0
	item.Parent = KillFeedContainer

	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.Color = if killData.IsHeadshot
		then Color3.fromRGB(255, 45, 175)
		else Color3.fromRGB(0, 235, 255)
	stroke.Thickness = 1.2
	stroke.Parent = item

	local lbl = Instance.new(&quot;TextLabel&quot;)
	lbl.Size = UDim2.new(1, -12, 1, 0)
	lbl.Position = UDim2.fromOffset(6, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.RobotoMono
	lbl.Text = string.format(
		&quot;%s  [%s%s]  %s&quot;,
		tostring(killData.Killer),
		tostring(killData.Weapon),
		if killData.IsHeadshot then &quot; ★HS&quot; else &quot;&quot;,
		tostring(killData.Victim)
	)
	lbl.TextColor3 = Color3.fromRGB(235, 245, 255)
	lbl.TextSize = 11
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Parent = item

	task.delay(4.5, function()
		if item.Parent then
			item:Destroy()
		end
	end)
end

function HUDController.ShowMatchEnded(summary: any)
	if not MatchEndOverlay or not MatchEndTitle or not MatchEndSub then
		return
	end
	SoundManager.Play2D(&quot;MatchVictory&quot;)

	local won = (summary.WinnerName == LocalPlayer.Name)
	MatchEndTitle.Text = if won
		then &quot;VICTORY // CHAMPION&quot;
		else (&quot;DEFEAT // WINNER: &quot; .. tostring(summary.WinnerName))
	MatchEndTitle.TextColor3 = if won
		then Color3.fromRGB(0, 255, 200)
		else Color3.fromRGB(255, 55, 150)

	MatchEndSub.Text = string.format(
		&quot;FINAL SCORE: %s (%d) vs %s (%d) // RETURNING TO MAIN MENU...&quot;,
		tostring(summary.P1Name),
		tonumber(summary.P1Kills) or 0,
		tostring(summary.P2Name),
		tonumber(summary.P2Kills) or 0
	)
	MatchEndOverlay.Visible = true
end

return HUDController

</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_CLI_FPS">
        <Properties>
          <string name="Name">FPSController</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: StarterPlayerScripts.FPSController
	Description: Handles the First-Person Shooting Camera, 3D Cyber Viewmodel (arms +
	neon weapon), ADS aiming, recoil recovery, bullet spread calculation, reloading,
	weapon switching (keys 1-5 &amp; scroll wheel), neon tracer beams, and hit spark effects.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local WeaponConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;WeaponConfig&quot;))
local ArenaConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ArenaConfig&quot;))
local ShopConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ShopConfig&quot;))
local SoundManager = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;SoundManager&quot;))
local HUDController = require(script.Parent:WaitForChild(&quot;HUDController&quot;))

local FPSController = {}

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;)

local InActiveMatch = false
local EquippedWeaponId = &quot;AssaultRifle&quot;
local IsReloading = false
local IsAiming = false
local IsFiringHeld = false
local IsSprinting = false
local IsCrouching = false
local InspectEndTime = 0
local LastLocalFireClock = 0

local AmmoState: { [string]: { Mag: number, Reserve: number } } = {}
local BaseFOV = 78
local EquippedSkinId = &quot;DefaultCyan&quot;

-- Viewmodel state
local ViewmodelContainer: Model? = nil
local ViewmodelRoot: BasePart? = nil
local ViewmodelMuzzle: BasePart? = nil
local RecoilKickOffset = Vector3.zero
local RecoilPitchAccum = 0
local SwayOffset = Vector2.zero

local function getCamera(): Camera
	return Workspace.CurrentCamera
end

local function destroyViewmodel()
	if ViewmodelContainer then
		ViewmodelContainer:Destroy()
		ViewmodelContainer = nil
		ViewmodelRoot = nil
		ViewmodelMuzzle = nil
	end
end

function FPSController.RebuildViewmodel()
	destroyViewmodel()
	if not InActiveMatch then
		return
	end

	local cam = getCamera()
	if not cam then
		return
	end

	local skin = ShopConfig.GetWeaponSkin(EquippedSkinId)
	local model, handle, muzzle = WeaponConfig.BuildWeaponModel(
		EquippedWeaponId,
		skin.PrimaryNeon,
		skin.SecondaryColor
	)
	model.Name = &quot;FPSViewmodel&quot;

	-- Attach sleek cybernetic right forearm to viewmodel
	local rightArm = Instance.new(&quot;Part&quot;)
	rightArm.Name = &quot;CyberArmR&quot;
	rightArm.Size = Vector3.new(0.28, 0.28, 1.35)
	rightArm.Color = Color3.fromRGB(18, 22, 34)
	rightArm.Material = Enum.Material.Metal
	rightArm.CanCollide = false
	rightArm.CanQuery = false
	rightArm.CanTouch = false
	rightArm.Massless = true
	rightArm.CFrame = handle.CFrame * CFrame.new(0.18, -0.32, 0.85)
	rightArm.Parent = model

	local armWeld = Instance.new(&quot;WeldConstraint&quot;)
	armWeld.Part0 = handle
	armWeld.Part1 = rightArm
	armWeld.Parent = rightArm

	handle.Anchored = true
	model.Parent = cam

	ViewmodelContainer = model
	ViewmodelRoot = handle
	ViewmodelMuzzle = muzzle
end

function FPSController.SetMatchActive(active: boolean)
	if InActiveMatch == active then
		return
	end
	InActiveMatch = active

	local cam = getCamera()
	if active then
		LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
		LocalPlayer.CameraMinZoomDistance = 0.5
		LocalPlayer.CameraMaxZoomDistance = 0.5
		if cam then
			cam.CameraType = Enum.CameraType.Custom
			cam.FieldOfView = BaseFOV
		end
		UserInputService.MouseIconEnabled = false
		FPSController.RebuildViewmodel()
	else
		IsFiringHeld = false
		IsAiming = false
		destroyViewmodel()
		LocalPlayer.CameraMode = Enum.CameraMode.Classic
		LocalPlayer.CameraMinZoomDistance = 8
		LocalPlayer.CameraMaxZoomDistance = 16
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	end
end

function FPSController.ApplySettings(settings: any)
	if type(settings) ~= &quot;table&quot; then
		return
	end
	if type(settings.FOV) == &quot;number&quot; then
		BaseFOV = math.clamp(settings.FOV, 60, 105)
	end
end

function FPSController.SetEquippedSkin(skinId: string)
	if type(skinId) == &quot;string&quot; and skinId ~= EquippedSkinId then
		EquippedSkinId = skinId
		if InActiveMatch then
			FPSController.RebuildViewmodel()
		end
	end
end

function FPSController.UpdateWeaponStateFromServer(state: any)
	if type(state) ~= &quot;table&quot; then
		return
	end

	local prevWeapon = EquippedWeaponId
	if type(state.EquippedWeapon) == &quot;string&quot; then
		EquippedWeaponId = state.EquippedWeapon
	end
	IsReloading = (state.IsReloading == true)
	if type(state.Ammo) == &quot;table&quot; then
		AmmoState = state.Ammo
	end

	if prevWeapon ~= EquippedWeaponId and InActiveMatch then
		SoundManager.Play2D(&quot;WeaponSwitch&quot;)
		FPSController.RebuildViewmodel()
	end

	HUDController.UpdateWeaponHUD(EquippedWeaponId, IsReloading, AmmoState)
end

function FPSController.RequestSwitchWeapon(weaponId: string)
	if not InActiveMatch or weaponId == EquippedWeaponId then
		return
	end
	local stats = WeaponConfig.GetWeapon(weaponId)
	if not stats then
		return
	end

	IsAiming = false
	local switchRemote = Remotes:FindFirstChild(&quot;SwitchWeapon&quot;) :: RemoteEvent?
	if switchRemote then
		switchRemote:FireServer(weaponId)
	end
end

function FPSController.RequestReload()
	if not InActiveMatch or IsReloading then
		return
	end
	local stats = WeaponConfig.GetWeapon(EquippedWeaponId)
	if not stats then
		return
	end
	local curAmmo = AmmoState[EquippedWeaponId]
	if curAmmo and (curAmmo.Mag &gt;= stats.MagazineSize or curAmmo.Reserve &lt;= 0) then
		return
	end

	SoundManager.Play2D(&quot;Reload&quot;)
	local reloadRemote = Remotes:FindFirstChild(&quot;ReloadWeapon&quot;) :: RemoteEvent?
	if reloadRemote then
		reloadRemote:FireServer()
	end
end

local function computeSpreadDirection(baseDirection: Vector3, spreadDegrees: number): Vector3
	if spreadDegrees &lt;= 0.01 then
		return baseDirection.Unit
	end
	local spreadRad = math.rad(spreadDegrees)
	local rx = (math.random() - 0.5) * 2 * spreadRad
	local ry = (math.random() - 0.5) * 2 * spreadRad
	local cf = CFrame.lookAt(Vector3.zero, baseDirection) * CFrame.Angles(rx, ry, 0)
	return cf.LookVector.Unit
end

local function attemptFireShot()
	if not InActiveMatch or IsReloading then
		return
	end

	local char = LocalPlayer.Character
	local hum = if char then char:FindFirstChildOfClass(&quot;Humanoid&quot;) else nil
	if not hum or hum.Health &lt;= 0 then
		return
	end

	local stats = WeaponConfig.GetWeapon(EquippedWeaponId)
	if not stats then
		return
	end

	local now = os.clock()
	if (now - LastLocalFireClock) &lt; stats.FireRate then
		return
	end

	local wAmmo = AmmoState[EquippedWeaponId]
	if wAmmo and wAmmo.Mag &lt;= 0 then
		FPSController.RequestReload()
		return
	end

	LastLocalFireClock = now
	if wAmmo then
		wAmmo.Mag = math.max(0, wAmmo.Mag - 1)
		HUDController.UpdateWeaponHUD(EquippedWeaponId, IsReloading, AmmoState)
	end

	local cam = getCamera()
	local origin = cam.CFrame.Position
	local baseLook = cam.CFrame.LookVector
	local spreadDeg = if IsAiming then stats.AdsSpread else stats.HipSpread

	local directions: { Vector3 } = {}
	for _ = 1, stats.Pellets do
		table.insert(directions, computeSpreadDirection(baseLook, spreadDeg))
	end

	-- Apply camera &amp; viewmodel recoil kick
	RecoilKickOffset = Vector3.new(
		(math.random() - 0.5) * 0.06,
		0.05,
		stats.RecoilKickback
	)
	RecoilPitchAccum = math.min(RecoilPitchAccum + stats.RecoilPitch * 0.35, 8.0)

	-- Local muzzle flash blink
	if ViewmodelMuzzle then
		local light = ViewmodelMuzzle:FindFirstChild(&quot;MuzzleFlashLight&quot;) :: PointLight?
		if light then
			light.Enabled = true
			task.delay(0.05, function()
				if light then
					light.Enabled = false
				end
			end)
		end
	end

	local fireRemote = Remotes:FindFirstChild(&quot;FireWeapon&quot;) :: RemoteEvent?
	if fireRemote then
		fireRemote:FireServer(origin, directions)
	end
end

function FPSController.RenderWeaponFiredVisual(
	shooter: Player?,
	weaponId: string,
	origin: Vector3,
	endpoints: { Vector3 },
	hitEffects: { { Pos: Vector3, IsCharacter: boolean, IsHeadshot: boolean } },
	neonColor: Color3
)
	local stats = WeaponConfig.GetWeapon(weaponId)
	if stats then
		local soundOriginPart: Instance? = nil
		if shooter and shooter.Character then
			soundOriginPart = shooter.Character:FindFirstChild(&quot;Head&quot;)
		end
		SoundManager.PlayWeaponFire(stats.FireSoundId, stats.FirePitch, soundOriginPart)
	end

	local visualStart = origin
	if shooter == LocalPlayer and ViewmodelMuzzle then
		visualStart = ViewmodelMuzzle.Position
	end

	-- Render neon laser tracer beam for each pellet
	for _, endPos in ipairs(endpoints) do
		local dist = (endPos - visualStart).Magnitude
		if dist &gt; 0.5 then
			local beamPart = Instance.new(&quot;Part&quot;)
			beamPart.Name = &quot;NeonTracer&quot;
			beamPart.Anchored = true
			beamPart.CanCollide = false
			beamPart.CanQuery = false
			beamPart.CanTouch = false
			beamPart.Material = Enum.Material.Neon
			beamPart.Color = neonColor
			beamPart.Transparency = 0.15
			beamPart.Size = Vector3.new(0.09, 0.09, dist)
			beamPart.CFrame = CFrame.lookAt(visualStart, endPos) * CFrame.new(0, 0, -dist * 0.5)
			beamPart.Parent = Workspace

			TweenService:Create(beamPart, TweenInfo.new(0.12), {
				Transparency = 1,
				Size = Vector3.new(0.02, 0.02, dist),
			}):Play()

			task.delay(0.14, function()
				beamPart:Destroy()
			end)
		end
	end

	-- Render neon impact spark cubes
	for _, hit in ipairs(hitEffects) do
		local spark = Instance.new(&quot;Part&quot;)
		spark.Name = &quot;NeonHitSpark&quot;
		spark.Anchored = true
		spark.CanCollide = false
		spark.CanQuery = false
		spark.CanTouch = false
		spark.Material = Enum.Material.Neon
		spark.Color = if hit.IsHeadshot
			then Color3.fromRGB(255, 40, 170)
			elseif hit.IsCharacter then Color3.fromRGB(0, 255, 220)
			else neonColor
		spark.Size = Vector3.new(0.45, 0.45, 0.45)
		spark.CFrame = CFrame.new(hit.Pos) * CFrame.Angles(math.random(), math.random(), math.random())
		spark.Parent = Workspace

		TweenService:Create(spark, TweenInfo.new(0.22), {
			Size = Vector3.new(1.35, 1.35, 1.35),
			Transparency = 1,
		}):Play()

		task.delay(0.24, function()
			spark:Destroy()
		end)
	end
end

function FPSController.Init()
	HUDController.OnWeaponSlotClicked = function(weaponId: string)
		FPSController.RequestSwitchWeapon(weaponId)
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.KeyCode == Enum.KeyCode.M and InActiveMatch then
			local qRemote = Remotes:FindFirstChild(&quot;QueueAction&quot;) :: RemoteEvent?
			if qRemote then
				qRemote:FireServer(&quot;LeaveMatch&quot;)
			end
			return
		end

		if gameProcessed or not InActiveMatch then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			IsFiringHeld = true
			attemptFireShot()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			IsAiming = true
			local aimRemote = Remotes:FindFirstChild(&quot;AimState&quot;) :: RemoteEvent?
			if aimRemote then
				aimRemote:FireServer(true)
			end
		elseif input.KeyCode == Enum.KeyCode.R then
			FPSController.RequestReload()
		elseif input.KeyCode == Enum.KeyCode.One then
			FPSController.RequestSwitchWeapon(&quot;AssaultRifle&quot;)
		elseif input.KeyCode == Enum.KeyCode.Two then
			FPSController.RequestSwitchWeapon(&quot;SniperRifle&quot;)
		elseif input.KeyCode == Enum.KeyCode.Three then
			FPSController.RequestSwitchWeapon(&quot;Shotgun&quot;)
		elseif input.KeyCode == Enum.KeyCode.Four then
			FPSController.RequestSwitchWeapon(&quot;SMG&quot;)
		elseif input.KeyCode == Enum.KeyCode.Five then
			FPSController.RequestSwitchWeapon(&quot;Pistol&quot;)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			IsFiringHeld = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			if IsAiming then
				IsAiming = false
				local aimRemote = Remotes:FindFirstChild(&quot;AimState&quot;) :: RemoteEvent?
				if aimRemote then
					aimRemote:FireServer(false)
				end
			end
		end
	end)

	-- Scroll wheel weapon switching
	UserInputService.InputChanged:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or not InActiveMatch then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local stats = WeaponConfig.GetWeapon(EquippedWeaponId)
			local currentSlot = if stats then stats.Slot else 1
			local direction = if input.Position.Z &gt; 0 then -1 else 1
			local nextSlot = ((currentSlot - 1 + direction) % #WeaponConfig.SlotOrder) + 1
			local nextWeapon = WeaponConfig.SlotOrder[nextSlot]
			if nextWeapon then
				FPSController.RequestSwitchWeapon(nextWeapon)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			SwayOffset = Vector2.new(
				math.clamp(-input.Delta.X * 0.002, -0.08, 0.08),
				math.clamp(-input.Delta.Y * 0.002, -0.08, 0.08)
			)
		end
	end)

	-- RenderStepped loop for Menu Camera vista OR First-Person Viewmodel + Auto-Fire
	RunService.RenderStepped:Connect(function(dt: number)
		local cam = getCamera()
		if not cam then
			return
		end

		if not InActiveMatch then
			-- Cinematic Cybercity Neon Street Camera Vista (Matches Image 1)
			cam.CameraType = Enum.CameraType.Scriptable
			cam.FieldOfView = 68
			local t = os.clock()
			local driftX = math.sin(t * 0.35) * 1.8
			local driftY = math.cos(t * 0.5) * 0.35
			cam.CFrame = ArenaConfig.MenuCameraCFrame * CFrame.new(driftX, driftY, 0)
			return
		end

		local stats = WeaponConfig.GetWeapon(EquippedWeaponId) or WeaponConfig.Weapons.AssaultRifle

		-- Full-auto firing for Assault Rifle &amp; SMG
		if IsFiringHeld and stats.FireMode == &quot;Auto&quot; then
			attemptFireShot()
		end

		-- Smooth FOV interpolation for ADS
		local targetFOV = if IsAiming then stats.AdsFov else BaseFOV
		cam.FieldOfView = cam.FieldOfView + (targetFOV - cam.FieldOfView) * math.min(1, dt * 14)

		-- Recover recoil &amp; sway
		RecoilKickOffset = RecoilKickOffset:Lerp(Vector3.zero, math.min(1, dt * 16))
		SwayOffset = SwayOffset:Lerp(Vector2.zero, math.min(1, dt * 10))
		if RecoilPitchAccum &gt; 0.01 then
			local step = math.min(RecoilPitchAccum, dt * 12)
			RecoilPitchAccum -= step
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(step * 0.15), 0, 0)
		end

		-- Calculate walk bobbing
		local char = LocalPlayer.Character
		local root = if char then char:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart? else nil
		local speed = if root then Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude else 0
		local bobTime = os.clock() * 9
		local bobX = if speed &gt; 1 then math.cos(bobTime) * 0.04 else 0
		local bobY = if speed &gt; 1 then math.abs(math.sin(bobTime)) * 0.04 else 0

		-- Position 3D First-Person Viewmodel
		if ViewmodelRoot and ViewmodelContainer then
			local hideViewmodelForScope = (IsAiming and stats.UseSniperScope)
			for _, part in ipairs(ViewmodelContainer:GetDescendants()) do
				if part:IsA(&quot;BasePart&quot;) then
					part.LocalTransparencyModifier = if hideViewmodelForScope then 1 else 0
				end
			end

			local baseOffset = if IsAiming
				then CFrame.new(0, -0.26, -1.05)
				else CFrame.new(0.52, -0.44, -1.25)

			local reloadTilt = if IsReloading
				then CFrame.new(0, -0.28, 0) * CFrame.Angles(math.rad(-32), 0, math.rad(24))
				else CFrame.identity

			ViewmodelRoot.CFrame = cam.CFrame
				* baseOffset
				* CFrame.new(
					bobX + SwayOffset.X + RecoilKickOffset.X,
					bobY + SwayOffset.Y + RecoilKickOffset.Y,
					RecoilKickOffset.Z
				)
				* reloadTilt
		end

		-- Update dynamic crosshair spread
		local spreadDeg = if IsAiming then stats.AdsSpread else stats.HipSpread
		local spreadPixels = 6 + spreadDeg * 3.5 + (speed * 0.35) + (RecoilKickOffset.Z * 18)
		HUDController.SetCrosshairState(spreadPixels, IsAiming, stats.UseSniperScope)
	end)
end

return FPSController

</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
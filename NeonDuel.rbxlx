		AdsSpread = 0.25,
		AdsFov = 64,
		UseSniperScope = false,
		MaxRange = 280,
		RecoilPitch = 1.8,
		RecoilYaw = 0.4,
		RecoilKickback = 0.36,
		EquipTime = 0.2,
		NeonColor = Color3.fromRGB(168, 176, 184), -- Brushed chrome Desert Eagle
		SecondaryColor = Color3.fromRGB(35, 38, 41),
		FireSoundId = &quot;rbxassetid://9114222085&quot;,
		ReloadSoundId = &quot;rbxassetid://9114221580&quot;,
		FirePitch = 0.88,
		ModelScale = Vector3.new(0.22, 0.34, 1.05),
		BarrelLength = 0.6,
	},
}

function WeaponConfig.GetWeapon(weaponId: string): WeaponStats?
	return WeaponConfig.Weapons[weaponId]
end

function WeaponConfig.GetWeaponBySlot(slot: number): WeaponStats?
	local id = WeaponConfig.SlotOrder[slot]
	if id then
		return WeaponConfig.Weapons[id]
	end
	return nil
end

local function createPart(
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	parent: Instance
): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function weldParts(root: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = root.CFrame * offset
	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
end

--[[
	Builds a detailed multi-part 3D futuristic cyberpunk weapon model.
	Used for both the First-Person Viewmodel and 3rd-person character appearance.
]]
function WeaponConfig.BuildWeaponModel(
	weaponId: string,
	customNeonColor: Color3?,
	customBodyColor: Color3?
): (Model, BasePart, BasePart)
	local stats = WeaponConfig.GetWeapon(weaponId) or WeaponConfig.Weapons.AssaultRifle
	local neonColor = customNeonColor or stats.NeonColor
	local bodyColor = customBodyColor or stats.SecondaryColor

	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Weapon_&quot; .. stats.Id

	-- Main Receiver / Handle
	local receiver = createPart(
		&quot;Handle&quot;,
		stats.ModelScale,
		bodyColor,
		Enum.Material.Metal,
		model
	)
	model.PrimaryPart = receiver

	-- Grip
	local grip = createPart(
		&quot;Grip&quot;,
		Vector3.new(stats.ModelScale.X * 0.75, 0.55, 0.28),
		Color3.fromRGB(14, 16, 22),
		Enum.Material.SmoothPlastic,
		model
	)
	weldParts(receiver, grip, CFrame.new(0, -0.35, 0.25) * CFrame.Angles(math.rad(-16), 0, 0))

	-- Neon Energy Strip Left &amp; Right
	local stripLength = stats.ModelScale.Z * 0.82
	local stripLeft = createPart(
		&quot;NeonStripL&quot;,
		Vector3.new(0.04, 0.07, stripLength),
		neonColor,
		Enum.Material.Neon,
		model
	)
	weldParts(receiver, stripLeft, CFrame.new(-stats.ModelScale.X * 0.51, 0.04, -0.05))

	local stripRight = createPart(
		&quot;NeonStripR&quot;,
		Vector3.new(0.04, 0.07, stripLength),
		neonColor,
		Enum.Material.Neon,
		model
	)
	weldParts(receiver, stripRight, CFrame.new(stats.ModelScale.X * 0.51, 0.04, -0.05))

	-- Top Rail &amp; Futuristic Holographic Sight
	local topRail = createPart(
		&quot;TopRail&quot;,
		Vector3.new(stats.ModelScale.X * 0.6, 0.08, stats.ModelScale.Z * 0.65),
		Color3.fromRGB(32, 36, 48),
		Enum.Material.Metal,
		model
	)
	weldParts(receiver, topRail, CFrame.new(0, stats.ModelScale.Y * 0.5 + 0.03, 0))

	if stats.Id == &quot;SniperRifle&quot; then
		-- High-Power Cyber Scope
		local scopeBody = createPart(
			&quot;Scope&quot;,
			Vector3.new(0.22, 0.22, 1.15),
			bodyColor,
			Enum.Material.Metal,
			model
		)
		weldParts(receiver, scopeBody, CFrame.new(0, stats.ModelScale.Y * 0.5 + 0.20, 0.05))

		local scopeLens = createPart(
			&quot;ScopeLens&quot;,
			Vector3.new(0.18, 0.18, 1.18),
			neonColor,
			Enum.Material.Neon,
			model
		)
		weldParts(receiver, scopeLens, CFrame.new(0, stats.ModelScale.Y * 0.5 + 0.20, 0.05))
	else
		-- Holo Sight Frame + Glowing Reticle Glass
		local sightFrame = createPart(
			&quot;HoloSight&quot;,
			Vector3.new(stats.ModelScale.X * 0.7, 0.22, 0.32),
			bodyColor,
			Enum.Material.Metal,
			model
		)
		weldParts(receiver, sightFrame, CFrame.new(0, stats.ModelScale.Y * 0.5 + 0.14, 0.1))

		local sightGlass = createPart(
			&quot;HoloGlass&quot;,
			Vector3.new(stats.ModelScale.X * 0.52, 0.16, 0.04),
			neonColor,
			Enum.Material.Glass,
			model
		)
		sightGlass.Transparency = 0.45
		weldParts(receiver, sightGlass, CFrame.new(0, stats.ModelScale.Y * 0.5 + 0.15, 0.1))
	end

	-- Magazine (for non-shotgun)
	if stats.Id ~= &quot;Shotgun&quot; and stats.Id ~= &quot;Pistol&quot; then
		local mag = createPart(
			&quot;Magazine&quot;,
			Vector3.new(stats.ModelScale.X * 0.62, 0.62, 0.32),
			Color3.fromRGB(24, 28, 38),
			Enum.Material.Metal,
			model
		)
		weldParts(receiver, mag, CFrame.new(0, -0.38, -0.25) * CFrame.Angles(math.rad(10), 0, 0))

		local magNeon = createPart(
			&quot;MagNeon&quot;,
			Vector3.new(stats.ModelScale.X * 0.66, 0.45, 0.06),
			neonColor,
			Enum.Material.Neon,
			model
		)
		weldParts(mag, magNeon, CFrame.new(0, 0, -0.14))
	end

	-- Barrel &amp; Muzzle Point
	local barrel = createPart(
		&quot;Barrel&quot;,
		Vector3.new(0.12, 0.12, stats.BarrelLength),
		Color3.fromRGB(36, 40, 54),
		Enum.Material.Metal,
		model
	)
	local barrelZ = -(stats.ModelScale.Z * 0.5 + stats.BarrelLength * 0.35)
	weldParts(receiver, barrel, CFrame.new(0, 0.06, barrelZ))

	local muzzle = createPart(
		&quot;Muzzle&quot;,
		Vector3.new(0.15, 0.15, 0.15),
		neonColor,
		Enum.Material.Neon,
		model
	)
	local muzzleZ = barrelZ - (stats.BarrelLength * 0.5)
	weldParts(receiver, muzzle, CFrame.new(0, 0.06, muzzleZ))

	local muzzleLight = Instance.new(&quot;PointLight&quot;)
	muzzleLight.Name = &quot;MuzzleFlashLight&quot;
	muzzleLight.Color = neonColor
	muzzleLight.Brightness = 3
	muzzleLight.Range = 9
	muzzleLight.Enabled = false
	muzzleLight.Parent = muzzle

	return model, receiver, muzzle
end

return WeaponConfig

</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_MOD_ARENA">
        <Properties>
          <string name="Name">ArenaConfig</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ReplicatedStorage.Modules.ArenaConfig
	Description: Configuration for the 5 unique futuristic cyberpunk arenas and the
	mandatory 120-second (2-minute) arena rotation cycle.
]]

local ArenaConfig = {}

-- IMPORTANT REQUIREMENT: Arena rotation happens every 2 MINUTES (120 seconds), NOT 30 seconds.
ArenaConfig.ROTATION_INTERVAL = 120 -- Seconds per arena
ArenaConfig.TRANSITION_DURATION = 2.5 -- Smooth transition visual overlay duration
ArenaConfig.DEFAULT_WIN_KILLS = 10 -- Default kills needed to win a 1v1 match

export type ArenaDefinition = {
	Index: number,
	Id: string,
	Name: string,
	Subtitle: string,
	ThemeDescription: string,
	Origin: Vector3,
	Size: Vector3,
	PrimaryNeon: Color3,
	SecondaryNeon: Color3,
	FloorColor: Color3,
	AmbientColor: Color3,
	FogColor: Color3,
	Spawn1Offset: Vector3,
	Spawn2Offset: Vector3,
}

ArenaConfig.Arenas = {
	{
		Index = 1,
		Id = &quot;CybercityStreet&quot;,
		Name = &quot;DE_DUST2 (LONG &amp; MID DOORS)&quot;,
		Subtitle = &quot;SECTOR 01 // SANDSTONE COURTYARD &amp; WOODEN CRATES&quot;,
		ThemeDescription = &quot;Classic Dust II sandstone courtyard with wooden double doors and tactical crates.&quot;,
		Origin = Vector3.new(0, 50, 0),
		Size = Vector3.new(130, 60, 190),
		PrimaryNeon = Color3.fromRGB(196, 171, 124),
		SecondaryNeon = Color3.fromRGB(156, 112, 64),
		FloorColor = Color3.fromRGB(196, 171, 124),
		AmbientColor = Color3.fromRGB(95, 88, 72),
		FogColor = Color3.fromRGB(185, 168, 136),
		Spawn1Offset = Vector3.new(0, 4, 72),
		Spawn2Offset = Vector3.new(0, 4, -72),
	},
	{
		Index = 2,
		Id = &quot;QuantumReactor&quot;,
		Name = &quot;FY_POOL_DAY / AIM_MAP&quot;,
		Subtitle = &quot;SECTOR 02 // SYMMETRICAL TACTICAL AIM ARENA&quot;,
		ThemeDescription = &quot;Classic symmetrical CS 1.6 1v1 arena with brick divider walls and wooden cover boxes.&quot;,
		Origin = Vector3.new(400, 50, 0),
		Size = Vector3.new(150, 65, 150),
		PrimaryNeon = Color3.fromRGB(143, 75, 60),
		SecondaryNeon = Color3.fromRGB(153, 110, 63),
		FloorColor = Color3.fromRGB(141, 150, 158),
		AmbientColor = Color3.fromRGB(85, 92, 98),
		FogColor = Color3.fromRGB(155, 168, 178),
		Spawn1Offset = Vector3.new(0, 4, 58),
		Spawn2Offset = Vector3.new(0, 4, -58),
	},
	{
		Index = 3,
		Id = &quot;SynthwaveRooftop&quot;,
		Name = &quot;DE_INFERNO (COURTYARD)&quot;,
		Subtitle = &quot;SECTOR 03 // COBBLESTONE PLAZA &amp; TERRACOTTA WALLS&quot;,
		ThemeDescription = &quot;European cobblestone courtyard with stucco walls, archways, and dark oak crates.&quot;,
		Origin = Vector3.new(800, 50, 0),
		Size = Vector3.new(145, 70, 175),
		PrimaryNeon = Color3.fromRGB(196, 178, 146),
		SecondaryNeon = Color3.fromRGB(120, 82, 46),
		FloorColor = Color3.fromRGB(122, 115, 104),
		AmbientColor = Color3.fromRGB(88, 82, 74),
		FogColor = Color3.fromRGB(168, 158, 142),
		Spawn1Offset = Vector3.new(0, 4, 68),
		Spawn2Offset = Vector3.new(0, 4, -68),
	},
	{
		Index = 4,
		Id = &quot;VoidCitadel&quot;,
		Name = &quot;DE_NUKE (WAREHOUSE YARD)&quot;,
		Subtitle = &quot;SECTOR 04 // INDUSTRIAL CONCRETE &amp; CONTAINERS&quot;,
		ThemeDescription = &quot;Industrial concrete yard featuring steel shipping containers and tactical bunkers.&quot;,
		Origin = Vector3.new(1200, 50, 0),
		Size = Vector3.new(140, 60, 165),
		PrimaryNeon = Color3.fromRGB(104, 112, 120),
		SecondaryNeon = Color3.fromRGB(73, 89, 68),
		FloorColor = Color3.fromRGB(92, 98, 104),
		AmbientColor = Color3.fromRGB(72, 78, 84),
		FogColor = Color3.fromRGB(128, 136, 144),
		Spawn1Offset = Vector3.new(0, 4, 64),
		Spawn2Offset = Vector3.new(0, 4, -64),
	},
	{
		Index = 5,
		Id = &quot;HyperloopTerminal&quot;,
		Name = &quot;DE_TRAIN (RAIL TERMINAL)&quot;,
		Subtitle = &quot;SECTOR 05 // FREIGHT YARD &amp; ARMORED TRAIN CARS&quot;,
		ThemeDescription = &quot;Concrete transit platforms divided by olive and rust freight train cars.&quot;,
		Origin = Vector3.new(1600, 50, 0),
		Size = Vector3.new(135, 58, 185),
		PrimaryNeon = Color3.fromRGB(70, 84, 64),
		SecondaryNeon = Color3.fromRGB(110, 84, 72),
		FloorColor = Color3.fromRGB(82, 86, 90),
		AmbientColor = Color3.fromRGB(68, 72, 76),
		FogColor = Color3.fromRGB(118, 124, 130),
		Spawn1Offset = Vector3.new(0, 4, 70),
		Spawn2Offset = Vector3.new(0, 4, -70),
	},
}

-- Menu Background Camera CFrame (looks down the Cybercity Neon Street like Image 1)
ArenaConfig.MenuCameraCFrame = CFrame.lookAt(
	Vector3.new(0, 58.5, 62),
	Vector3.new(0, 57.5, -60)
)

function ArenaConfig.GetArenaByIndex(index: number): ArenaDefinition
	local wrapped = ((index - 1) % #ArenaConfig.Arenas) + 1
	return ArenaConfig.Arenas[wrapped]
end

function ArenaConfig.GetArenaById(arenaId: string): ArenaDefinition?
	for _, arena in ipairs(ArenaConfig.Arenas) do
		if arena.Id == arenaId then
			return arena
		end
	end
	return nil
end

function ArenaConfig.GetNextArenaIndex(currentIndex: number): number
	return (currentIndex % #ArenaConfig.Arenas) + 1
end

return ArenaConfig


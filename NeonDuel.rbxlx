          <string name="Name">ShopConfig</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ReplicatedStorage.Modules.ShopConfig
	Description: Weapon skins, Player character skins, rarities, prices, and XP/Level progression formulas.
]]

local ShopConfig = {}

export type SkinItem = {
	Id: string,
	Name: string,
	Category: &quot;WeaponSkin&quot; | &quot;CharacterSkin&quot;,
	Rarity: &quot;Common&quot; | &quot;Rare&quot; | &quot;Epic&quot; | &quot;Legendary&quot; | &quot;Mythic&quot;,
	Price: number,
	Description: string,
	PrimaryNeon: Color3,
	SecondaryColor: Color3,
}

ShopConfig.RarityColors = {
	Common = Color3.fromRGB(0, 225, 255),
	Rare = Color3.fromRGB(85, 130, 255),
	Epic = Color3.fromRGB(190, 55, 255),
	Legendary = Color3.fromRGB(255, 50, 175),
	Mythic = Color3.fromRGB(255, 210, 55),
}

ShopConfig.WeaponSkins = {
	{
		Id = &quot;DefaultCyan&quot;,
		Name = &quot;CYBER CYAN MK-I&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Common&quot;,
		Price = 0,
		Description = &quot;Standard-issue Cybercity tactical neon cyan energy core.&quot;,
		PrimaryNeon = Color3.fromRGB(0, 240, 255),
		SecondaryColor = Color3.fromRGB(22, 26, 38),
	},
	{
		Id = &quot;SynthMagenta&quot;,
		Name = &quot;SYNTHWAVE OVERDRIVE&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Rare&quot;,
		Price = 250,
		Description = &quot;High-voltage magenta plasma conduits with obsidian alloy casing.&quot;,
		PrimaryNeon = Color3.fromRGB(255, 40, 185),
		SecondaryColor = Color3.fromRGB(24, 14, 34),
	},
	{
		Id = &quot;VoidPurple&quot;,
		Name = &quot;VOID SINGULARITY&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Epic&quot;,
		Price = 500,
		Description = &quot;Dark matter violet core harvested from the Void Citadel reactor.&quot;,
		PrimaryNeon = Color3.fromRGB(170, 45, 255),
		SecondaryColor = Color3.fromRGB(14, 12, 24),
	},
	{
		Id = &quot;EmeraldMatrix&quot;,
		Name = &quot;NEURAL MATRIX&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Epic&quot;,
		Price = 650,
		Description = &quot;Encrypted bio-luminescent emerald circuitry with carbon frame.&quot;,
		PrimaryNeon = Color3.fromRGB(0, 255, 165),
		SecondaryColor = Color3.fromRGB(15, 28, 24),
	},
	{
		Id = &quot;CrimsonProtocol&quot;,
		Name = &quot;REDLINE PROTOCOL&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Legendary&quot;,
		Price = 1000,
		Description = &quot;Overclocked crimson laser core built for elite cyber assassins.&quot;,
		PrimaryNeon = Color3.fromRGB(255, 35, 65),
		SecondaryColor = Color3.fromRGB(28, 12, 16),
	},
	{
		Id = &quot;SolarArchon&quot;,
		Name = &quot;AURELIA PRIME&quot;,
		Category = &quot;WeaponSkin&quot;,
		Rarity = &quot;Mythic&quot;,
		Price = 1800,
		Description = &quot;Prestige gold-plated titanium chassis with radiant solar plasma.&quot;,
		PrimaryNeon = Color3.fromRGB(255, 215, 50),
		SecondaryColor = Color3.fromRGB(36, 30, 18),
	},
}

ShopConfig.CharacterSkins = {
	{
		Id = &quot;CyberOperative&quot;,
		Name = &quot;CYBER OPERATIVE&quot;,
		Category = &quot;CharacterSkin&quot;,
		Rarity = &quot;Common&quot;,
		Price = 0,
		Description = &quot;Standard neon-visor tactical exosuit for Sector 01 duelists.&quot;,
		PrimaryNeon = Color3.fromRGB(0, 235, 255),
		SecondaryColor = Color3.fromRGB(20, 25, 38),
	},
	{
		Id = &quot;PhantomStriker&quot;,
		Name = &quot;PHANTOM STRIKER&quot;,
		Category = &quot;CharacterSkin&quot;,
		Rarity = &quot;Rare&quot;,
		Price = 350,
		Description = &quot;Stealth infiltrate armor infused with ultraviolet stealth emitters.&quot;,
		PrimaryNeon = Color3.fromRGB(165, 55, 255),
		SecondaryColor = Color3.fromRGB(18, 14, 28),
	},
	{
		Id = &quot;NeonSamurai&quot;,
		Name = &quot;RONIN ZERO-X&quot;,
		Category = &quot;CharacterSkin&quot;,
		Rarity = &quot;Epic&quot;,
		Price = 750,
		Description = &quot;Cybernetic street samurai plating with magenta plasma pauldrons.&quot;,
		PrimaryNeon = Color3.fromRGB(255, 40, 165),
		SecondaryColor = Color3.fromRGB(28, 16, 26),
	},
	{
		Id = &quot;HyperVanguard&quot;,
		Name = &quot;HYPERION VANGUARD&quot;,
		Category = &quot;CharacterSkin&quot;,
		Rarity = &quot;Legendary&quot;,
		Price = 1200,
		Description = &quot;Heavy quantum-shielded combat rig with turquoise reactor core.&quot;,
		PrimaryNeon = Color3.fromRGB(0, 255, 200),
		SecondaryColor = Color3.fromRGB(14, 26, 32),
	},
	{
		Id = &quot;ArchonOverlord&quot;,
		Name = &quot;ARCHON CELESTIAL&quot;,
		Category = &quot;CharacterSkin&quot;,
		Rarity = &quot;Mythic&quot;,
		Price = 2200,
		Description = &quot;Supreme champion cyber-armor radiating golden sovereign energy.&quot;,
		PrimaryNeon = Color3.fromRGB(255, 210, 50),
		SecondaryColor = Color3.fromRGB(30, 26, 16),
	},
}

ShopConfig.Rewards = {
	CoinsPerKill = 25,
	CoinsPerWin = 150,
	CoinsPerLoss = 50,
	CoinsPerLevelUp = 100,
	XPPerKill = 40,
	XPPerWin = 200,
	XPPerLoss = 75,
}

function ShopConfig.GetXPRequiredForLevel(level: number): number
	return math.max(100, level * 150)
end

function ShopConfig.GetWeaponSkin(skinId: string): SkinItem
	for _, item in ipairs(ShopConfig.WeaponSkins) do
		if item.Id == skinId then
			return item
		end
	end
	return ShopConfig.WeaponSkins[1]
end

function ShopConfig.GetCharacterSkin(skinId: string): SkinItem
	for _, item in ipairs(ShopConfig.CharacterSkins) do
		if item.Id == skinId then
			return item
		end
	end
	return ShopConfig.CharacterSkins[1]
end

return ShopConfig

</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_MOD_SOUND">
        <Properties>
          <string name="Name">SoundManager</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ReplicatedStorage.Modules.SoundManager
	Description: Centralized sound controller for weapons, hitmarkers, UI, and arena rotation events.
]]

local SoundService = game:GetService(&quot;SoundService&quot;)

local SoundManager = {}

SoundManager.SfxVolume = 0.8
SoundManager.MusicVolume = 0.45

SoundManager.Presets = {
	UIClick = { Id = &quot;rbxassetid://6895079853&quot;, Pitch = 1.15, Volume = 0.5 },
	UIHover = { Id = &quot;rbxassetid://6895079853&quot;, Pitch = 1.45, Volume = 0.25 },
	Hitmarker = { Id = &quot;rbxassetid://160432334&quot;, Pitch = 1.2, Volume = 0.65 },
	Headshot = { Id = &quot;rbxassetid://160432334&quot;, Pitch = 0.85, Volume = 0.95 },
	Reload = { Id = &quot;rbxassetid://9114221580&quot;, Pitch = 1.0, Volume = 0.6 },
	WeaponSwitch = { Id = &quot;rbxassetid://9114221580&quot;, Pitch = 1.35, Volume = 0.45 },
	ArenaWarning = { Id = &quot;rbxassetid://9114074725&quot;, Pitch = 0.95, Volume = 0.7 },
	ArenaSwitch = { Id = &quot;rbxassetid://9114074725&quot;, Pitch = 1.25, Volume = 0.85 },
	MatchVictory = { Id = &quot;rbxassetid://1843529634&quot;, Pitch = 1.0, Volume = 0.8 },
}

function SoundManager.Play2D(presetName: string, customPitch: number?, customVolume: number?)
	local preset = SoundManager.Presets[presetName]
	if not preset then
		return
	end

	local sound = Instance.new(&quot;Sound&quot;)
	sound.Name = &quot;SFX_&quot; .. presetName
	sound.SoundId = preset.Id
	sound.PlaybackSpeed = customPitch or preset.Pitch
	sound.Volume = (customVolume or preset.Volume) * SoundManager.SfxVolume
	sound.Parent = SoundService
	sound:Play()

	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	task.delay(4, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function SoundManager.PlayWeaponFire(soundId: string, pitch: number, parentPart: Instance?)
	local sound = Instance.new(&quot;Sound&quot;)
	sound.Name = &quot;WeaponFireSFX&quot;
	sound.SoundId = soundId
	sound.PlaybackSpeed = pitch + (math.random(-4, 4) * 0.01)
	sound.Volume = 0.75 * SoundManager.SfxVolume
	sound.RollOffMaxDistance = 180
	sound.RollOffMinDistance = 12
	sound.Parent = parentPart or SoundService
	sound:Play()

	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	task.delay(3, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function SoundManager.SetVolumes(sfxVolume: number, musicVolume: number)
	SoundManager.SfxVolume = math.clamp(sfxVolume, 0, 1)
	SoundManager.MusicVolume = math.clamp(musicVolume, 0, 1)
end

return SoundManager

</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX_SSS">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX_SRV_MAIN">
      <Properties>
        <string name="Name">MainServer</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Script: ServerScriptService.MainServer
	Description: Main server bootstrapper. Initializes RemoteEvents, builds the 5
	futuristic cyberpunk arenas, starts the 120-second arena rotation loop, and
	connects client-server network endpoints.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local DataManager = require(script.Parent:WaitForChild(&quot;DataManager&quot;))
local ArenaBuilder = require(script.Parent:WaitForChild(&quot;ArenaBuilder&quot;))
local CombatServer = require(script.Parent:WaitForChild(&quot;CombatServer&quot;))
local MatchManager = require(script.Parent:WaitForChild(&quot;MatchManager&quot;))
local ShopServer = require(script.Parent:WaitForChild(&quot;ShopServer&quot;))

-- 1. Create RemoteEvents &amp; RemoteFunctions in ReplicatedStorage.Remotes
local remotesFolder = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
if not remotesFolder then
	remotesFolder = Instance.new(&quot;Folder&quot;)
	remotesFolder.Name = &quot;Remotes&quot;
	remotesFolder.Parent = ReplicatedStorage
end

local remoteEventNames = {
	&quot;FireWeapon&quot;,
	&quot;ReloadWeapon&quot;,
	&quot;SwitchWeapon&quot;,
	&quot;AimState&quot;,
	&quot;WeaponStateUpdate&quot;,
	&quot;WeaponFiredVisual&quot;,
	&quot;QueueAction&quot;,
	&quot;PracticeAction&quot;,
	&quot;FriendMatchAction&quot;,
	&quot;UpdateSettings&quot;,
	&quot;MatchStateUpdate&quot;,
	&quot;ArenaRotationUpdate&quot;,
	&quot;DamageIndicator&quot;,
	&quot;KillFeedEvent&quot;,
	&quot;MatchEndedEvent&quot;,
	&quot;PlayerDataUpdate&quot;,
	&quot;MenuNotification&quot;,
}

local Remotes: { [string]: RemoteEvent } = {}
for _, name in ipairs(remoteEventNames) do
	local ev = remotesFolder:FindFirstChild(name) :: RemoteEvent?
	if not ev then
		ev = Instance.new(&quot;RemoteEvent&quot;)
		ev.Name = name
		ev.Parent = remotesFolder
	end
	Remotes[name] = ev :: RemoteEvent
end

local shopFunction = remotesFolder:FindFirstChild(&quot;ShopAction&quot;) :: RemoteFunction?
if not shopFunction then
	shopFunction = Instance.new(&quot;RemoteFunction&quot;)
	shopFunction.Name = &quot;ShopAction&quot;
	shopFunction.Parent = remotesFolder
end

-- 2. Build all 5 Futuristic Cyberpunk Arenas &amp; Lighting
ArenaBuilder.BuildAllArenas()

-- 3. Start Match &amp; 120-Second Arena Rotation Loop
MatchManager.StartLoop()

-- 4. Connect Combat Remotes
Remotes.FireWeapon.OnServerEvent:Connect(function(player: Player, origin: any, directions: any)
	CombatServer.HandleFireWeapon(player, origin, directions)
end)

Remotes.ReloadWeapon.OnServerEvent:Connect(function(player: Player)
	CombatServer.ReloadWeapon(player)
end)

Remotes.SwitchWeapon.OnServerEvent:Connect(function(player: Player, weaponId: any)
	if type(weaponId) == &quot;string&quot; then
		CombatServer.SwitchWeapon(player, weaponId)
	end
end)

Remotes.AimState.OnServerEvent:Connect(function(player: Player, isAiming: any)
	CombatServer.SetAimState(player, isAiming == true)
end)

-- 5. Connect Matchmaking, Friend Match, Private Room, and Practice Mode Remotes
Remotes.QueueAction.OnServerEvent:Connect(function(player: Player, action: any)
	if type(action) == &quot;string&quot; then
		MatchManager.HandleQueueAction(player, action)
	end
end)

Remotes.PracticeAction.OnServerEvent:Connect(function(
	player: Player,
	winCondition: any,
	startArenaIndex: any,
	botFiresBack: any
)
	MatchManager.HandlePracticeAction(
		player,
		tonumber(winCondition),
		tonumber(startArenaIndex),
		if type(botFiresBack) == &quot;boolean&quot; then botFiresBack else true
	)
end)

Remotes.FriendMatchAction.OnServerEvent:Connect(function(player: Player, action: any, payload: any)
	if type(action) == &quot;string&quot; then
		MatchManager.HandleFriendAndPrivateAction(player, action, if type(payload) == &quot;table&quot; then payload else nil)
	end
end)

-- 6. Connect Shop &amp; Settings Remotes
if shopFunction then
	shopFunction.OnServerInvoke = function(player: Player, action: any, category: any, itemId: any)
		if type(action) == &quot;string&quot; and type(category) == &quot;string&quot; and type(itemId) == &quot;string&quot; then
			return ShopServer.HandleShopAction(player, action, category, itemId)
		end
		return false, &quot;Invalid request parameters.&quot;
	end
end

Remotes.UpdateSettings.OnServerEvent:Connect(function(player: Player, newSettings: any)
	if type(newSettings) == &quot;table&quot; then
		DataManager.UpdateSettings(player, newSettings)
	end
end)

-- 7. Player Lifecycle Management
local function onPlayerAdded(player: Player)
	DataManager.LoadProfile(player)
	CombatServer.GetOrCreateState(player)

	player.CharacterAdded:Connect(function(character: Model)
		task.defer(function()
			ShopServer.ApplyCharacterSkin(player, character)
			CombatServer.AttachThirdPersonWeapon(player)
		end)
	end)

	-- Spawn in safe lobby box initially while viewing the Cybercity Main Menu
	player:LoadCharacter()
	if player.Character then
		player.Character:PivotTo(CFrame.new(0, 505, 0))
	end

	task.delay(0.5, function()
		if player.Parent == Players then
			DataManager.SyncToClient(player)
			CombatServer.SyncWeaponState(player)
		end
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)

Players.PlayerRemoving:Connect(function(player: Player)
	MatchManager.LeaveMatch(player)
	CombatServer.CleanupPlayer(player)
	DataManager.CleanupPlayer(player)
end)

-- Periodically refresh global OrderedDataStore leaderboard
task.spawn(function()
	while true do
		DataManager.RefreshGlobalLeaderboard()
		task.wait(60)
	end
end)

</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SRV_DATA">
      <Properties>
        <string name="Name">DataManager</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ServerScriptService.DataManager
	Description: Handles DataStoreService persistence for player progression,
	Coins, XP, Level, Wins/Losses, Weapon/Character skins, Settings, and Leaderboards.
]]

local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)

local ShopConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ShopConfig&quot;))

local DataManager = {}

export type PlayerProfile = {
	Coins: number,
	XP: number,
	Level: number,
	Wins: number,
	Losses: number,
	Kills: number,
	Deaths: number,
	WinStreak: number,
	OwnedWeaponSkins: { [string]: boolean },
	EquippedWeaponSkin: string,
	OwnedCharacterSkins: { [string]: boolean },
	EquippedCharacterSkin: string,
	Settings: {
		FOV: number,
		Sensitivity: number,
		AimSensitivity: number,
		SfxVolume: number,
		MusicVolume: number,
		HighQualityNeon: boolean,
	},
}

local DATASTORE_NAME = &quot;NeonDuel_PlayerData_v2&quot;
local LEADERBOARD_STORE_NAME = &quot;NeonDuel_WinsLeaderboard_v2&quot;

local playerStore: DataStore? = nil
local winsOrderedStore: OrderedDataStore? = nil

pcall(function()
	playerStore = DataStoreService:GetDataStore(DATASTORE_NAME)
	winsOrderedStore = DataStoreService:GetOrderedDataStore(LEADERBOARD_STORE_NAME)
end)

local Profiles: { [Player]: PlayerProfile } = {}
local CachedLeaderboard: { { Name: string, Wins: number, Level: number } } = {
	{ Name = &quot;VORTEX_99&quot;, Wins = 48, Level = 19 },
	{ Name = &quot;CYBER_VALKYRIE&quot;, Wins = 39, Level = 16 },
	{ Name = &quot;KRYPTON_X&quot;, Wins = 31, Level = 14 },
	{ Name = &quot;NEON_GHOST&quot;, Wins = 24, Level = 11 },
	{ Name = &quot;SYNTH_ZERO&quot;, Wins = 18, Level = 9 },
}

local function getDefaultProfile(): PlayerProfile
	return {
		Coins = 350,
		XP = 0,
		Level = 1,
		Wins = 0,
		Losses = 0,
		Kills = 0,
		Deaths = 0,
		WinStreak = 0,
		OwnedWeaponSkins = {
			DefaultCyan = true,
		},
		EquippedWeaponSkin = &quot;DefaultCyan&quot;,
		OwnedCharacterSkins = {
			CyberOperative = true,
		},
		EquippedCharacterSkin = &quot;CyberOperative&quot;,
		Settings = {
			FOV = 78,
			Sensitivity = 0.5,
			AimSensitivity = 0.35,
			SfxVolume = 0.8,
			MusicVolume = 0.45,
			HighQualityNeon = true,
		},
	}
end

local function reconcileProfile(saved: any): PlayerProfile
	local defaultData = getDefaultProfile()
	if type(saved) ~= &quot;table&quot; then
		return defaultData
	end

	for key, val in pairs(defaultData) do
		if saved[key] == nil then
			saved[key] = val
		elseif type(val) == &quot;table&quot; and type(saved[key]) == &quot;table&quot; then
			for subKey, subVal in pairs(val) do
				if saved[key][subKey] == nil then
					saved[key][subKey] = subVal
				end
			end
		end
	end

	return saved :: PlayerProfile
end

local function syncLeaderstats(player: Player, profile: PlayerProfile)
	local leaderstats = player:FindFirstChild(&quot;leaderstats&quot;)
	if not leaderstats then
		leaderstats = Instance.new(&quot;Folder&quot;)
		leaderstats.Name = &quot;leaderstats&quot;
		leaderstats.Parent = player
	end

	local function setStat(name: string, value: number)
		local stat = leaderstats:FindFirstChild(name) :: IntValue?
		if not stat then
			stat = Instance.new(&quot;IntValue&quot;)
			stat.Name = name
			stat.Parent = leaderstats
		end
		if stat then
			stat.Value = value
		end
	end

	setStat(&quot;Level&quot;, profile.Level)
	setStat(&quot;Wins&quot;, profile.Wins)
	setStat(&quot;Kills&quot;, profile.Kills)
	setStat(&quot;Coins&quot;, profile.Coins)
end

function DataManager.LoadProfile(player: Player): PlayerProfile
	if Profiles[player] then
		return Profiles[player]
	end

	local loadedData: any = nil
	if playerStore and player.UserId &gt; 0 then
		local ok, result = pcall(function()
			return (playerStore :: DataStore):GetAsync(&quot;Player_&quot; .. tostring(player.UserId))
		end)
		if ok and result then
			loadedData = result
		end
	end

	local profile = reconcileProfile(loadedData)
	Profiles[player] = profile
	syncLeaderstats(player, profile)
	DataManager.SyncToClient(player)
	return profile
end

function DataManager.GetProfile(player: Player): PlayerProfile
	return Profiles[player] or DataManager.LoadProfile(player)
end

function DataManager.SaveProfile(player: Player)
	local profile = Profiles[player]
	if not profile then
		return
	end

	if playerStore and player.UserId &gt; 0 and not RunService:IsStudio() then
		pcall(function()
			(playerStore :: DataStore):UpdateAsync(&quot;Player_&quot; .. tostring(player.UserId), function()
				return profile
			end)
		end)
	elseif playerStore and player.UserId &gt; 0 then
		-- Also attempt save in Studio if API services are enabled
		pcall(function()
			(playerStore :: DataStore):SetAsync(&quot;Player_&quot; .. tostring(player.UserId), profile)
		end)
	end

	if winsOrderedStore and player.UserId &gt; 0 and profile.Wins &gt; 0 then
		pcall(function()
			(winsOrderedStore :: OrderedDataStore):SetAsync(player.Name, profile.Wins)
		end)
	end
end

function DataManager.SyncToClient(player: Player)
	local profile = Profiles[player]
	if not profile then
		return
	end
	syncLeaderstats(player, profile)

	local remotes = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if remotes then
		local dataRemote = remotes:FindFirstChild(&quot;PlayerDataUpdate&quot;) :: RemoteEvent?
		if dataRemote then
			dataRemote:FireClient(player, profile, DataManager.GetLeaderboard())
		end
	end
end

function DataManager.AddCoins(player: Player, amount: number)
	local profile = DataManager.GetProfile(player)
	profile.Coins = math.max(0, profile.Coins + math.floor(amount))
	DataManager.SyncToClient(player)
end

function DataManager.AddXP(player: Player, amount: number): boolean
	local profile = DataManager.GetProfile(player)
	profile.XP += math.floor(amount)

	local leveledUp = false
	local required = ShopConfig.GetXPRequiredForLevel(profile.Level)
	while profile.XP &gt;= required do
		profile.XP -= required
		profile.Level += 1
		profile.Coins += ShopConfig.Rewards.CoinsPerLevelUp
		leveledUp = true
		required = ShopConfig.GetXPRequiredForLevel(profile.Level)
	end

	DataManager.SyncToClient(player)
	return leveledUp
end

function DataManager.RecordKill(player: Player)
	local profile = DataManager.GetProfile(player)
	profile.Kills += 1
	profile.Coins += ShopConfig.Rewards.CoinsPerKill
	DataManager.AddXP(player, ShopConfig.Rewards.XPPerKill)
end

function DataManager.RecordDeath(player: Player)
	local profile = DataManager.GetProfile(player)
	profile.Deaths += 1
	DataManager.SyncToClient(player)
end

function DataManager.RecordMatchOutcome(player: Player, won: boolean)
	local profile = DataManager.GetProfile(player)
	if won then
		profile.Wins += 1
		profile.WinStreak += 1
		profile.Coins += ShopConfig.Rewards.CoinsPerWin
		DataManager.AddXP(player, ShopConfig.Rewards.XPPerWin)
	else
		profile.Losses += 1
		profile.WinStreak = 0
		profile.Coins += ShopConfig.Rewards.CoinsPerLoss
		DataManager.AddXP(player, ShopConfig.Rewards.XPPerLoss)
	end
	DataManager.SaveProfile(player)
end

function DataManager.UpdateSettings(player: Player, newSettings: { [string]: any })
	local profile = DataManager.GetProfile(player)
	if type(newSettings) ~= &quot;table&quot; then
		return
	end
	if type(newSettings.FOV) == &quot;number&quot; then
		profile.Settings.FOV = math.clamp(newSettings.FOV, 60, 105)
	end
	if type(newSettings.Sensitivity) == &quot;number&quot; then
		profile.Settings.Sensitivity = math.clamp(newSettings.Sensitivity, 0.1, 2.0)
	end
	if type(newSettings.AimSensitivity) == &quot;number&quot; then
		profile.Settings.AimSensitivity = math.clamp(newSettings.AimSensitivity, 0.1, 1.5)
	end
	if type(newSettings.SfxVolume) == &quot;number&quot; then
		profile.Settings.SfxVolume = math.clamp(newSettings.SfxVolume, 0, 1)
	end
	if type(newSettings.MusicVolume) == &quot;number&quot; then
		profile.Settings.MusicVolume = math.clamp(newSettings.MusicVolume, 0, 1)
	end
	if type(newSettings.HighQualityNeon) == &quot;boolean&quot; then
		profile.Settings.HighQualityNeon = newSettings.HighQualityNeon
	end
	DataManager.SyncToClient(player)
end

function DataManager.GetLeaderboard(): { { Name: string, Wins: number, Level: number } }
	local entries: { { Name: string, Wins: number, Level: number } } = {}
	local seenNames: { [string]: boolean } = {}

	-- Include all active players in server
	for _, plr in ipairs(Players:GetPlayers()) do
		local prof = Profiles[plr]
		if prof then
			table.insert(entries, {
				Name = plr.Name,
				Wins = prof.Wins,
				Level = prof.Level,
			})
			seenNames[plr.Name] = true
		end
	end

	-- Merge cached global entries
	for _, item in ipairs(CachedLeaderboard) do
		if not seenNames[item.Name] then
			table.insert(entries, item)
			seenNames[item.Name] = true
		end
	end

	table.sort(entries, function(a, b)
		if a.Wins == b.Wins then
			return a.Level &gt; b.Level
		end
		return a.Wins &gt; b.Wins
	end)

	local top10 = {}
	for i = 1, math.min(10, #entries) do
		table.insert(top10, entries[i])
	end
	return top10
end

function DataManager.RefreshGlobalLeaderboard()
	if not winsOrderedStore then
		return
	end
	pcall(function()
		local pages = (winsOrderedStore :: OrderedDataStore):GetSortedAsync(false, 10)
		local topPage = pages:GetCurrentPage()
		if #topPage &gt; 0 then
			local updated = {}
			for _, entry in ipairs(topPage) do
				table.insert(updated, {
					Name = tostring(entry.key),
					Wins = tonumber(entry.value) or 0,
					Level = math.max(1, math.floor((tonumber(entry.value) or 0) / 2) + 1),
				})
			end
			CachedLeaderboard = updated
		end
	end)
end

function DataManager.CleanupPlayer(player: Player)
	DataManager.SaveProfile(player)
	Profiles[player] = nil
end

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		DataManager.SaveProfile(player)
	end
end)

return DataManager

</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SRV_ARENA">
      <Properties>
        <string name="Name">ArenaBuilder</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ServerScriptService.ArenaBuilder
	Description: Procedurally constructs all 5 unique futuristic cyberpunk 3D arenas
	and configures Roblox Lighting (Bloom, ColorCorrection, Atmosphere) for a dark
	neon blue, purple, and cyan aesthetic.
]]

local Lighting = game:GetService(&quot;Lighting&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local ArenaConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ArenaConfig&quot;))

local ArenaBuilder = {}

local ArenasFolder: Folder? = nil

local function makePart(props: {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	Reflectance: number?,
	CanCollide: boolean?,
	Shape: Enum.PartType?,
	Parent: Instance,
}): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Name = props.Name or &quot;CyberPart&quot;
	part.Anchored = true
	part.CanCollide = if props.CanCollide ~= nil then props.CanCollide else true
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.Transparency = props.Transparency or 0
	part.Reflectance = props.Reflectance or 0
	if props.Shape then
		part.Shape = props.Shape
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = props.Parent
	return part
end

local function addPointLight(parent: Instance, color: Color3, brightness: number, range: number)
	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = true
	light.Parent = parent
end

local function addNeonSignText(parent: BasePart, face: Enum.NormalId, text: string, textColor: Color3)
	local sg = Instance.new(&quot;SurfaceGui&quot;)
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 24
	sg.LightInfluence = 0
	sg.Brightness = 3
	sg.Parent = parent

	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor
	label.Font = Enum.Font.Michroma
	label.TextScaled = true
	label.Parent = sg
end

local function buildPerimeterWalls(folder: Instance, origin: Vector3, size: Vector3, primaryNeon: Color3, secondaryNeon: Color3)
	local halfX = size.X * 0.5
	local halfZ = size.Z * 0.5
	local wallHeight = 32
	local wallColor = Color3.fromRGB(10, 12, 22)

	-- Boundary walls (semi-transparent dark cyber barriers with neon grid trim)
	local walls = {
		{ Pos = Vector3.new(0, wallHeight * 0.5, halfZ), Size = Vector3.new(size.X, wallHeight, 2) },
		{ Pos = Vector3.new(0, wallHeight * 0.5, -halfZ), Size = Vector3.new(size.X, wallHeight, 2) },
		{ Pos = Vector3.new(halfX, wallHeight * 0.5, 0), Size = Vector3.new(2, wallHeight, size.Z) },
		{ Pos = Vector3.new(-halfX, wallHeight * 0.5, 0), Size = Vector3.new(2, wallHeight, size.Z) },
	}

	for i, w in ipairs(walls) do
		makePart({
			Name = &quot;BoundaryWall_&quot; .. i,
			Size = w.Size,
			CFrame = CFrame.new(origin + w.Pos),
			Color = wallColor,
			Material = Enum.Material.Metal,
			Transparency = 0.25,
			Parent = folder,
		})

		-- Bottom &amp; Mid Neon Trim
		local trimSize = Vector3.new(
			if w.Size.X &gt; 4 then w.Size.X else 2.3,
			0.45,
			if w.Size.Z &gt; 4 then w.Size.Z else 2.3
		)
		makePart({
			Name = &quot;NeonTrimBottom_&quot; .. i,
			Size = trimSize,
			CFrame = CFrame.new(origin + Vector3.new(w.Pos.X, 0.5, w.Pos.Z)),
			Color = primaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		makePart({
			Name = &quot;NeonTrimTop_&quot; .. i,
			Size = trimSize,
			CFrame = CFrame.new(origin + Vector3.new(w.Pos.X, 14, w.Pos.Z)),
			Color = secondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Invisible ceiling to prevent escaping
	makePart({
		Name = &quot;CeilingBarrier&quot;,
		Size = Vector3.new(size.X, 2, size.Z),
		CFrame = CFrame.new(origin + Vector3.new(0, wallHeight + 1, 0)),
		Color = wallColor,
		Transparency = 1,
		Parent = folder,
	})
end

local function buildSpawnPad(folder: Instance, pos: Vector3, neonColor: Color3, label: string)
	local base = makePart({
		Name = label,
		Size = Vector3.new(10, 0.5, 10),
		CFrame = CFrame.new(pos - Vector3.new(0, 3.6, 0)),
		Color = Color3.fromRGB(18, 22, 34),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	makePart({
		Name = label .. &quot;_NeonRing&quot;,
		Size = Vector3.new(10.6, 0.3, 10.6),
		CFrame = base.CFrame,
		Color = neonColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	-- Spawn Cover Shield in front of spawn to prevent instant spawn-sniping
	local zDir = if pos.Z &gt; 0 then -1 else 1
	local shieldPos = pos + Vector3.new(0, -0.5, zDir * 11)
	makePart({
		Name = label .. &quot;_SpawnCover&quot;,
		Size = Vector3.new(12, 7.5, 1.5),
		CFrame = CFrame.new(shieldPos),
		Color = Color3.fromRGB(20, 24, 38),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	makePart({
		Name = label .. &quot;_SpawnCoverNeon&quot;,
		Size = Vector3.new(12.3, 0.4, 1.7),
		CFrame = CFrame.new(shieldPos + Vector3.new(0, 3.6, 0)),
		Color = neonColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
end

local function buildCyberCar(folder: Instance, cframe: CFrame, neonColor: Color3, bodyColor: Color3)
	-- Futuristic Cyber Sports Car (like Image 1 street cars, doubles as tactical waist/chest cover)
	makePart({
		Name = &quot;CyberCarChassis&quot;,
		Size = Vector3.new(7.5, 2.6, 15.5),
		CFrame = cframe * CFrame.new(0, 1.8, 0),
		Color = bodyColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.25,
		Parent = folder,
	})
	makePart({
		Name = &quot;CyberCarCabin&quot;,
		Size = Vector3.new(6.4, 2.0, 8.2),
		CFrame = cframe * CFrame.new(0, 3.8, -0.5),
		Color = Color3.fromRGB(12, 16, 26),
		Material = Enum.Material.Glass,
		Reflectance = 0.35,
		Parent = folder,
	})
	-- Tail &amp; Headlight Neon Bars
	local tailLight = makePart({
		Name = &quot;CyberCarTailNeon&quot;,
		Size = Vector3.new(7.2, 0.45, 0.3),
		CFrame = cframe * CFrame.new(0, 2.3, 7.75),
		Color = Color3.fromRGB(255, 35, 110),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	addPointLight(tailLight, Color3.fromRGB(255, 35, 110), 2.2, 18)

	local headLight = makePart({
		Name = &quot;CyberCarHeadNeon&quot;,
		Size = Vector3.new(7.2, 0.4, 0.3),
		CFrame = cframe * CFrame.new(0, 2.1, -7.75),
		Color = neonColor,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	addPointLight(headLight, neonColor, 2.2, 20)
end

-- ============================================================================
-- ARENA 1: CYBERCITY NEON STREET (Matches Image 1 Aesthetic &amp; Vista)
-- ============================================================================
local function buildArena1_CybercityStreet(folder: Instance, def: ArenaConfig.ArenaDefinition)
	local o = def.Origin
	-- Wet reflective dark asphalt floor
	makePart({
		Name = &quot;WetAsphaltRoad&quot;,
		Size = Vector3.new(def.Size.X, 2, def.Size.Z),
		CFrame = CFrame.new(o - Vector3.new(0, 1, 0)),
		Color = def.FloorColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.32,
		Parent = folder,
	})

	-- Reflective puddle strips &amp; tram rails down the center street (just like Image 1)
	for _, xOff in ipairs({ -6, -2, 2, 6 }) do
		makePart({
			Name = &quot;StreetTramRail&quot;,
			Size = Vector3.new(0.35, 0.12, def.Size.Z - 10),
			CFrame = CFrame.new(o + Vector3.new(xOff, 0.06, 0)),
			Color = Color3.fromRGB(45, 55, 85),
			Material = Enum.Material.Metal,
			Reflectance = 0.55,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Glowing Neon Sidewalk Curbs Left &amp; Right
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = &quot;Sidewalk&quot;,
			Size = Vector3.new(26, 1.2, def.Size.Z),
			CFrame = CFrame.new(o + Vector3.new(side * 50, 0.6, 0)),
			Color = Color3.fromRGB(18, 20, 34),
			Material = Enum.Material.Concrete,
			Parent = folder,
		})
		makePart({
			Name = &quot;CurbNeon&quot;,
			Size = Vector3.new(0.45, 0.45, def.Size.Z - 6),
			CFrame = CFrame.new(o + Vector3.new(side * 36.8, 0.9, 0)),
			Color = if side == -1 then def.PrimaryNeon else def.SecondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Cyberpunk Storefronts, Skyscrapers, and Glowing Billboards along both sides
	local signTexts = { &quot;CYBER // 2099&quot;, &quot;NEON DUEL&quot;, &quot;SYNTH CORP&quot;, &quot;PULSE ARMS&quot;, &quot;VOID TECH&quot;, &quot;NEXUS BAR&quot; }
	for zIdx = -3, 3 do
		local zPos = zIdx * 24
		for _, side in ipairs({ -1, 1 }) do
			local bHeight = 34 + (math.abs(zIdx * 7 + side * 3) % 24)
			local building = makePart({
				Name = &quot;CyberBuilding&quot;,
				Size = Vector3.new(18, bHeight, 20),
				CFrame = CFrame.new(o + Vector3.new(side * 55, bHeight * 0.5, zPos)),
				Color = Color3.fromRGB(12, 14, 26),
				Material = Enum.Material.Metal,
				Parent = folder,
			})

			local signColor = if (zIdx + side) % 2 == 0 then def.PrimaryNeon else def.SecondaryNeon
			local billboard = makePart({
				Name = &quot;NeonBillboard&quot;,
				Size = Vector3.new(0.6, 5.5, 13),
				CFrame = CFrame.new(o + Vector3.new(side * 45.2, 12 + (math.abs(zIdx) % 2) * 5, zPos)),
				Color = signColor,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
			addPointLight(billboard, signColor, 1.8, 28)

			local face = if side == -1 then Enum.NormalId.Right else Enum.NormalId.Left
			addNeonSignText(
				building,
				face,
				signTexts[((math.abs(zIdx) + (if side == 1 then 2 else 0)) % #signTexts) + 1],
				signColor
			)
		end
	end

	-- Distant Center Skyline Towers (visible behind the north/south ends like Image 1)
	for i = -2, 2 do
		local towerH = 85 + (2 - math.abs(i)) * 22
		local tower = makePart({
			Name = &quot;SkylineTower_&quot; .. i,
			Size = Vector3.new(22, towerH, 22),
			CFrame = CFrame.new(o + Vector3.new(i * 26, towerH * 0.5 - 10, -125)),
			Color = Color3.fromRGB(10, 16, 32),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = folder,
		})
		makePart({
			Name = &quot;TowerCrownNeon_&quot; .. i,
			Size = Vector3.new(22.6, 2.5, 22.6),
			CFrame = tower.CFrame * CFrame.new(0, towerH * 0.42, 0),
			Color = if i % 2 == 0 then def.PrimaryNeon else def.SecondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Parked Cyber Sports Cars &amp; Tactical Cover Crates in the street
	buildCyberCar(folder, CFrame.new(o + Vector3.new(-16, 0, 26)), def.PrimaryNeon, Color3.fromRGB(22, 18, 36))
	buildCyberCar(folder, CFrame.new(o + Vector3.new(16, 0, 26)) * CFrame.Angles(0, math.pi, 0), def.SecondaryNeon, Color3.fromRGB(18, 22, 38))
	buildCyberCar(folder, CFrame.new(o + Vector3.new(-16, 0, -26)), def.SecondaryNeon, Color3.fromRGB(22, 18, 36))
	buildCyberCar(folder, CFrame.new(o + Vector3.new(16, 0, -26)) * CFrame.Angles(0, math.pi, 0), def.PrimaryNeon, Color3.fromRGB(18, 22, 38))

	-- Central Holo-Kiosk Hub for Mid-Map Duels
	local centerKiosk = makePart({
		Name = &quot;CenterHoloKiosk&quot;,
		Size = Vector3.new(10, 9, 10),
		CFrame = CFrame.new(o + Vector3.new(0, 4.5, 0)),
		Color = Color3.fromRGB(18, 20, 34),
		Material = Enum.Material.Metal,
		Parent = folder,
	})
	local holoRing = makePart({
		Name = &quot;CenterHoloRing&quot;,
		Size = Vector3.new(11, 1.2, 11),
		CFrame = centerKiosk.CFrame * CFrame.new(0, 3.8, 0),
		Color = def.PrimaryNeon,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	addPointLight(holoRing, def.PrimaryNeon, 2.5, 32)

	-- Side Tactical Barriers
	for _, coords in ipairs({
		Vector3.new(-26, 3, 0),
		Vector3.new(26, 3, 0),
		Vector3.new(0, 3, 42),
		Vector3.new(0, 3, -42),
	}) do
		makePart({
			Name = &quot;TacticalBarrier&quot;,
			Size = Vector3.new(11, 6, 2.5),
			CFrame = CFrame.new(o + coords),
			Color = Color3.fromRGB(24, 28, 44),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		makePart({
			Name = &quot;BarrierNeon&quot;,
			Size = Vector3.new(11.3, 0.4, 2.7),
			CFrame = CFrame.new(o + coords + Vector3.new(0, 2.8, 0)),
			Color = def.SecondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end
end

-- ============================================================================
-- ARENA 2: QUANTUM CORE REACTOR
-- ============================================================================
local function buildArena2_QuantumReactor(folder: Instance, def: ArenaConfig.ArenaDefinition)
	local o = def.Origin
	makePart({
		Name = &quot;ReactorFloor&quot;,
		Size = Vector3.new(def.Size.X, 2, def.Size.Z),
		CFrame = CFrame.new(o - Vector3.new(0, 1, 0)),
		Color = def.FloorColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.25,
		Parent = folder,
	})

	-- Central Towering Quantum Plasma Core
	local coreCylinder = makePart({
		Name = &quot;QuantumCoreColumn&quot;,
		Size = Vector3.new(28, 14, 14),
		CFrame = CFrame.new(o + Vector3.new(0, 14, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = def.PrimaryNeon,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		Parent = folder,
	})
	addPointLight(coreCylinder, def.PrimaryNeon, 3.2, 48)

	-- Outer Ring Pillars around Core
	for angleDeg = 0, 315, 45 do
		local rad = math.rad(angleDeg)
		local pPos = Vector3.new(math.cos(rad) * 26, 6, math.sin(rad) * 26)
		makePart({
			Name = &quot;ReactorPillar&quot;,
			Size = Vector3.new(5, 12, 5),
			CFrame = CFrame.new(o + pPos) * CFrame.Angles(0, -rad, 0),
			Color = Color3.fromRGB(20, 26, 42),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		makePart({
			Name = &quot;PillarNeon&quot;,
			Size = Vector3.new(5.3, 1.2, 5.3),
			CFrame = CFrame.new(o + pPos + Vector3.new(0, 4, 0)) * CFrame.Angles(0, -rad, 0),
			Color = if angleDeg % 90 == 0 then def.PrimaryNeon else def.SecondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Elevated Sniper Platforms Left &amp; Right with Ramps
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = &quot;OverwatchDeck&quot;,
			Size = Vector3.new(20, 1.5, 46),
			CFrame = CFrame.new(o + Vector3.new(side * 48, 8, 0)),
			Color = Color3.fromRGB(18, 24, 38),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		makePart({
			Name = &quot;DeckCoverWall&quot;,
			Size = Vector3.new(1.2, 4.2, 30),
			CFrame = CFrame.new(o + Vector3.new(side * 38.5, 10.5, 0)),
			Color = def.SecondaryNeon,
			Material = Enum.Material.Glass,
			Transparency = 0.35,
			Parent = folder,
		})
		-- Access Ramps North &amp; South
		for _, zDir in ipairs({ -1, 1 }) do
			makePart({
				Name = &quot;DeckRamp&quot;,
				Size = Vector3.new(10, 1, 22),
				CFrame = CFrame.new(o + Vector3.new(side * 48, 4, zDir * 32))
					* CFrame.Angles(math.rad(zDir * 22), 0, 0),
				Color = Color3.fromRGB(26, 32, 48),
				Material = Enum.Material.Metal,
				Parent = folder,
			})
		end
	end
end

-- ============================================================================
-- ARENA 3: SYNTHWAVE SKY MATRIX
-- ============================================================================
local function buildArena3_SynthwaveRooftop(folder: Instance, def: ArenaConfig.ArenaDefinition)
	local o = def.Origin
	makePart({
		Name = &quot;RooftopDeck&quot;,
		Size = Vector3.new(def.Size.X, 2, def.Size.Z),
		CFrame = CFrame.new(o - Vector3.new(0, 1, 0)),
		Color = def.FloorColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.28,
		Parent = folder,
	})

	-- Neon Grid Lines across the floor
	for z = -70, 70, 20 do
		makePart({
			Name = &quot;GridLineZ&quot;,
			Size = Vector3.new(def.Size.X - 6, 0.1, 0.35),
			CFrame = CFrame.new(o + Vector3.new(0, 0.05, z)),
			Color = def.PrimaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Central Elevated Skybridge + Holographic Arches
	makePart({
		Name = &quot;CenterSkybridge&quot;,
		Size = Vector3.new(28, 1.2, 56),
		CFrame = CFrame.new(o + Vector3.new(0, 7.5, 0)),
		Color = Color3.fromRGB(24, 16, 38),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Parent = folder,
	})
	for _, zDir in ipairs({ -1, 1 }) do
		makePart({
			Name = &quot;CenterRamp&quot;,
			Size = Vector3.new(14, 1, 20),
			CFrame = CFrame.new(o + Vector3.new(0, 3.8, zDir * 36)) * CFrame.Angles(math.rad(zDir * 22), 0, 0),
			Color = def.SecondaryNeon,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end

	-- Rooftop HVAC / Cyber Server Cover Blocks
	local blocks = {
		Vector3.new(-32, 3.5, 32),
		Vector3.new(32, 3.5, 32),
		Vector3.new(-32, 3.5, -32),
		Vector3.new(32, 3.5, -32),
		Vector3.new(-22, 3.5, 0),
		Vector3.new(22, 3.5, 0),
	}
	for i, bPos in ipairs(blocks) do
		makePart({
			Name = &quot;CyberServerUnit_&quot; .. i,
			Size = Vector3.new(10, 7, 10),
			CFrame = CFrame.new(o + bPos),
			Color = Color3.fromRGB(22, 18, 34),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		makePart({
			Name = &quot;ServerNeon_&quot; .. i,
			Size = Vector3.new(10.4, 0.6, 10.4),
			CFrame = CFrame.new(o + bPos + Vector3.new(0, 2.8, 0)),
			Color = if i % 2 == 0 then def.PrimaryNeon else def.SecondaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end
end

-- ============================================================================
-- ARENA 4: VOID CITADEL LAB
-- ============================================================================
local function buildArena4_VoidCitadel(folder: Instance, def: ArenaConfig.ArenaDefinition)
	local o = def.Origin
	makePart({
		Name = &quot;ObsidianFloor&quot;,
		Size = Vector3.new(def.Size.X, 2, def.Size.Z),
		CFrame = CFrame.new(o - Vector3.new(0, 1, 0)),
		Color = def.FloorColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.35,
		Parent = folder,
	})

	-- 6 Glowing Stasis Cryo-Pods for Tactical Pillar Cover
	local podCoords = {
		Vector3.new(-24, 7, 28),
		Vector3.new(24, 7, 28),
		Vector3.new(-24, 7, -28),
		Vector3.new(24, 7, -28),
		Vector3.new(-16, 7, 0),
		Vector3.new(16, 7, 0),
	}
	for i, cPos in ipairs(podCoords) do
		local pod = makePart({
			Name = &quot;CryoStasisPod_&quot; .. i,
			Size = Vector3.new(14, 7.5, 7.5),
			CFrame = CFrame.new(o + cPos) * CFrame.Angles(0, 0, math.rad(90)),
			Color = if i % 2 == 0 then def.PrimaryNeon else def.SecondaryNeon,
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Cylinder,
			Parent = folder,
		})
		addPointLight(pod, pod.Color, 2.0, 24)

		-- Metal Caps
		makePart({
			Name = &quot;PodBase_&quot; .. i,
			Size = Vector3.new(9, 1.5, 9),
			CFrame = CFrame.new(o + Vector3.new(cPos.X, 0.75, cPos.Z)),
			Color = Color3.fromRGB(18, 18, 30),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- Central Obsidian Monolith &amp; Cover Bunkers
	makePart({
		Name = &quot;VoidMonolith&quot;,
		Size = Vector3.new(7, 18, 7),
		CFrame = CFrame.new(o + Vector3.new(0, 9, 0)) * CFrame.Angles(0, math.rad(45), 0),
		Color = Color3.fromRGB(14, 12, 24),
		Material = Enum.Material.Metal,
		Reflectance = 0.4,
		Parent = folder,
	})
end

-- ============================================================================
-- ARENA 5: HYPERLOOP STATION ZERO
-- ============================================================================
local function buildArena5_HyperloopTerminal(folder: Instance, def: ArenaConfig.ArenaDefinition)
	local o = def.Origin
	makePart({
		Name = &quot;TerminalFloor&quot;,
		Size = Vector3.new(def.Size.X, 2, def.Size.Z),
		CFrame = CFrame.new(o - Vector3.new(0, 1, 0)),
		Color = def.FloorColor,
		Material = Enum.Material.Metal,
		Reflectance = 0.25,
		Parent = folder,
	})

	-- Central Maglev Train Car Segments (with pass-through gaps between cars for flanking)
	for _, zCenter in ipairs({ -34, 0, 34 }) do
		local car = makePart({
			Name = &quot;MaglevTrainCar&quot;,
			Size = Vector3.new(11, 8.5, 22),
			CFrame = CFrame.new(o + Vector3.new(0, 4.5, zCenter)),
			Color = Color3.fromRGB(20, 26, 38),
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
			Parent = folder,
		})
		makePart({
			Name = &quot;TrainStripeNeon&quot;,
			Size = Vector3.new(11.3, 0.7, 22.2),
			CFrame = car.CFrame * CFrame.new(0, 1.2, 0),
			Color = def.PrimaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end

	-- Twin Passenger Platforms Left &amp; Right with Ticket Kiosk Cover
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = &quot;PassengerPlatform&quot;,
			Size = Vector3.new(26, 2.2, 130),
			CFrame = CFrame.new(o + Vector3.new(side * 36, 1.1, 0)),
			Color = Color3.fromRGB(18, 22, 32),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		makePart({
			Name = &quot;PlatformEdgeNeon&quot;,
			Size = Vector3.new(0.5, 0.4, 130),
			CFrame = CFrame.new(o + Vector3.new(side * 23, 2.2, 0)),
			Color = def.PrimaryNeon,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})

		for _, zKiosk in ipairs({ -40, 0, 40 }) do
			makePart({
				Name = &quot;PlatformCoverKiosk&quot;,
				Size = Vector3.new(8, 6.5, 3),
				CFrame = CFrame.new(o + Vector3.new(side * 32, 5.2, zKiosk)),
				Color = Color3.fromRGB(24, 30, 44),
				Material = Enum.Material.Metal,
				Parent = folder,
			})
			makePart({
				Name = &quot;KioskHolo&quot;,
				Size = Vector3.new(7.4, 4.5, 3.2),
				CFrame = CFrame.new(o + Vector3.new(side * 32, 5.4, zKiosk)),
				Color = def.SecondaryNeon,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
end

function ArenaBuilder.ConfigureCyberpunkLighting()
	Lighting.Ambient = Color3.fromRGB(18, 20, 38)
	Lighting.OutdoorAmbient = Color3.fromRGB(24, 26, 48)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 0 -- Midnight cyberpunk atmosphere
	Lighting.ColorShift_Top = Color3.fromRGB(40, 175, 255)
	Lighting.ColorShift_Bottom = Color3.fromRGB(145, 35, 220)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.85

	-- Clear existing post effects before adding clean cyberpunk suite
	for _, child in ipairs(Lighting:GetChildren()) do
		if
			child:IsA(&quot;BloomEffect&quot;)
			or child:IsA(&quot;ColorCorrectionEffect&quot;)
			or child:IsA(&quot;Atmosphere&quot;)
		then
			child:Destroy()
		end
	end

	local bloom = Instance.new(&quot;BloomEffect&quot;)
	bloom.Name = &quot;CyberNeonBloom&quot;
	bloom.Intensity = 1.35
	bloom.Size = 28
	bloom.Threshold = 0.82
	bloom.Parent = Lighting

	local cc = Instance.new(&quot;ColorCorrectionEffect&quot;)
	cc.Name = &quot;CyberColorGrading&quot;
	cc.Brightness = 0.03
	cc.Contrast = 0.18
	cc.Saturation = 0.25
	cc.TintColor = Color3.fromRGB(235, 240, 255)
	cc.Parent = Lighting

	local atmosphere = Instance.new(&quot;Atmosphere&quot;)
	atmosphere.Name = &quot;CyberAtmosphere&quot;
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(18, 14, 36)
	atmosphere.Decay = Color3.fromRGB(10, 18, 38)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting
end

local function buildJumpPad(folder: Instance, pos: Vector3, neonColor: Color3, name: string)
	makePart({
		Name = name,
		Size = Vector3.new(6, 0.4, 6),
		CFrame = CFrame.new(pos),
		Color = Color3.fromRGB(22, 26, 40),
		Material = Enum.Material.Metal,
		Parent = folder,
	})

	local ring = makePart({
		Name = name .. &quot;_Glow&quot;,
		Size = Vector3.new(5.2, 0.5, 5.2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)),
		Color = neonColor,
		Material = Enum.Material.Neon,
		Parent = folder,
	})
	addPointLight(ring, neonColor, 2.2, 16)

	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Color = ColorSequence.new(neonColor)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Lifetime = NumberRange.new(0.6, 1.0)
	emitter.Rate = 18
	emitter.Speed = NumberRange.new(14, 22)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = ring

	ring.Touched:Connect(function(hit: BasePart)
		local model = hit.Parent
		if not model then
			return
		end
		local hum = model:FindFirstChildOfClass(&quot;Humanoid&quot;)
		local root = model:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
		if hum and root and hum.Health &gt; 0 then
			local vel = root.AssemblyLinearVelocity
			if vel.Y &lt; 45 then
				root.AssemblyLinearVelocity = Vector3.new(vel.X * 1.15, 76, vel.Z * 1.15)
			end
		end
	end)
end

local function buildCyberRainCanopy(folder: Instance, origin: Vector3, size: Vector3, neonColor: Color3)
	local canopy = makePart({
		Name = &quot;NeonRainEmitterCanopy&quot;,
		Size = Vector3.new(size.X * 0.85, 1, size.Z * 0.85),
		CFrame = CFrame.new(origin + Vector3.new(0, 29, 0)),
		Color = neonColor,
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})

	local rain = Instance.new(&quot;ParticleEmitter&quot;)
	rain.Name = &quot;CyberNeonRain&quot;
	rain.Color = ColorSequence.new(neonColor, Color3.fromRGB(210, 140, 255))
	rain.LightEmission = 0.85
	rain.Transparency = NumberSequence.new(0.45, 0.9)
	rain.Size = NumberSequence.new(0.15)
	rain.Lifetime = NumberRange.new(1.1, 1.5)
	rain.Rate = 65
	rain.Speed = NumberRange.new(38, 48)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Parent = canopy
end

function ArenaBuilder.BuildAllArenas(): Folder
	ArenaBuilder.ConfigureCyberpunkLighting()

	local existing = Workspace:FindFirstChild(&quot;NeonDuelArenas&quot;)
	if existing then
		existing:Destroy()
	end

	local rootFolder = Instance.new(&quot;Folder&quot;)
	rootFolder.Name = &quot;NeonDuelArenas&quot;
	rootFolder.Parent = Workspace
	ArenasFolder = rootFolder

	for _, def in ipairs(ArenaConfig.Arenas) do
		local arenaFolder = Instance.new(&quot;Folder&quot;)
		arenaFolder.Name = def.Id
		arenaFolder.Parent = rootFolder

		buildPerimeterWalls(arenaFolder, def.Origin, def.Size, def.PrimaryNeon, def.SecondaryNeon)
		buildSpawnPad(arenaFolder, def.Origin + def.Spawn1Offset, def.PrimaryNeon, &quot;SpawnPoint1&quot;)
		buildSpawnPad(arenaFolder, def.Origin + def.Spawn2Offset, def.SecondaryNeon, &quot;SpawnPoint2&quot;)
		buildJumpPad(arenaFolder, def.Origin + Vector3.new(-32, 0.2, 0), def.PrimaryNeon, &quot;JumpPad_West&quot;)
		buildJumpPad(arenaFolder, def.Origin + Vector3.new(32, 0.2, 0), def.SecondaryNeon, &quot;JumpPad_East&quot;)
		buildCyberRainCanopy(arenaFolder, def.Origin, def.Size, def.PrimaryNeon)

		if def.Id == &quot;CybercityStreet&quot; then
			buildArena1_CybercityStreet(arenaFolder, def)
		elseif def.Id == &quot;QuantumReactor&quot; then
			buildArena2_QuantumReactor(arenaFolder, def)
		elseif def.Id == &quot;SynthwaveRooftop&quot; then
			buildArena3_SynthwaveRooftop(arenaFolder, def)
		elseif def.Id == &quot;VoidCitadel&quot; then
			buildArena4_VoidCitadel(arenaFolder, def)
		elseif def.Id == &quot;HyperloopTerminal&quot; then
			buildArena5_HyperloopTerminal(arenaFolder, def)
		end
	end

	-- Create Lobby Safe Box far away so menu players never fall into the void
	local lobbyBox = Instance.new(&quot;Folder&quot;)
	lobbyBox.Name = &quot;LobbySafeZone&quot;
	lobbyBox.Parent = rootFolder
	makePart({
		Name = &quot;LobbyFloor&quot;,
		Size = Vector3.new(60, 2, 60),
		CFrame = CFrame.new(0, 500, 0),
		Color = Color3.fromRGB(10, 12, 20),
		Material = Enum.Material.Metal,
		Parent = lobbyBox,
	})

	return rootFolder
end

function ArenaBuilder.GetSpawnCFrames(arenaIndex: number): (CFrame, CFrame)
	local def = ArenaConfig.GetArenaByIndex(arenaIndex)
	local pos1 = def.Origin + def.Spawn1Offset
	local pos2 = def.Origin + def.Spawn2Offset
	return CFrame.lookAt(pos1, Vector3.new(pos2.X, pos1.Y, pos2.Z)),
		CFrame.lookAt(pos2, Vector3.new(pos1.X, pos2.Y, pos1.Z))
end

return ArenaBuilder

</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SRV_COMBAT">
      <Properties>
        <string name="Name">CombatServer</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ServerScriptService.CombatServer
	Description: Server-authoritative weapon state, ammo &amp; reload validation,
	anti-cheat raycast verification, headshot detection, and 3rd-person weapon rigging.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local WeaponConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;WeaponConfig&quot;))
local ShopConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ShopConfig&quot;))
local DataManager = require(script.Parent:WaitForChild(&quot;DataManager&quot;))

local CombatServer = {}

export type WeaponAmmoState = {
	Mag: number,
	Reserve: number,
}

export type PlayerCombatState = {
	EquippedWeapon: string,
	IsReloading: boolean,
	ReloadToken: number,
	IsAiming: boolean,
	LastShotClock: number,
	Ammo: { [string]: WeaponAmmoState },
}

local PlayerStates: { [Player]: PlayerCombatState } = {}

-- Hooked by MatchManager to process damage, health updates, kills, and win condition
CombatServer.CanPlayerAttack = nil :: ((player: Player) -&gt; boolean)?
CombatServer.OnValidatedHit = nil :: ((
	attacker: Player,
	victimModel: Model,
	damage: number,
	isHeadshot: boolean,
	weaponId: string,
	hitPosition: Vector3
) -&gt; ())?

local function createFreshAmmoTable(): { [string]: WeaponAmmoState }
	local ammoTable: { [string]: WeaponAmmoState } = {}
	for _, weaponId in ipairs(WeaponConfig.SlotOrder) do
		local w = WeaponConfig.GetWeapon(weaponId)
		if w then
			ammoTable[weaponId] = {
				Mag = w.MagazineSize,
				Reserve = w.ReserveAmmo,
			}
		end
	end
	return ammoTable
end

function CombatServer.GetOrCreateState(player: Player): PlayerCombatState
	local state = PlayerStates[player]
	if not state then
		state = {
			EquippedWeapon = &quot;AssaultRifle&quot;,
			IsReloading = false,
			ReloadToken = 0,
			IsAiming = false,
			LastShotClock = 0,
			Ammo = createFreshAmmoTable(),
		}
		PlayerStates[player] = state
	end
	return state
end

function CombatServer.ResetLoadout(player: Player)
	local state = CombatServer.GetOrCreateState(player)
	state.IsReloading = false
	state.ReloadToken += 1
	state.IsAiming = false
	state.Ammo = createFreshAmmoTable()
	CombatServer.SyncWeaponState(player)
	CombatServer.AttachThirdPersonWeapon(player)
end

function CombatServer.SyncWeaponState(player: Player)
	local state = PlayerStates[player]
	if not state then
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if not remotes then
		return
	end
	local weaponUpdate = remotes:FindFirstChild(&quot;WeaponStateUpdate&quot;) :: RemoteEvent?
	if weaponUpdate then
		weaponUpdate:FireClient(player, {
			EquippedWeapon = state.EquippedWeapon,
			IsReloading = state.IsReloading,
			Ammo = state.Ammo,
		})
	end
end

function CombatServer.AttachThirdPersonWeapon(player: Player)
	local char = player.Character
	if not char then
		return
	end

	local existing = char:FindFirstChild(&quot;EquippedCyberWeapon&quot;)
	if existing then
		existing:Destroy()
	end

	local state = CombatServer.GetOrCreateState(player)
	local profile = DataManager.GetProfile(player)
	local skin = ShopConfig.GetWeaponSkin(profile.EquippedWeaponSkin)

	local handPart = (
		char:FindFirstChild(&quot;RightHand&quot;)
		or char:FindFirstChild(&quot;Right Arm&quot;)
		or char:FindFirstChild(&quot;HumanoidRootPart&quot;)
	) :: BasePart?

	if not handPart then
		return
	end

	local model, handle = WeaponConfig.BuildWeaponModel(
		state.EquippedWeapon,
		skin.PrimaryNeon,
		skin.SecondaryColor
	)
	model.Name = &quot;EquippedCyberWeapon&quot;
	model.Parent = char

	handle.CFrame = handPart.CFrame * CFrame.new(0, -0.25, -0.65)
	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = handPart
	weld.Part1 = handle
	weld.Parent = handle
end

function CombatServer.SwitchWeapon(player: Player, weaponId: string)
	if type(weaponId) ~= &quot;string&quot; then
		return
	end
	local stats = WeaponConfig.GetWeapon(weaponId)
	if not stats then
		return
	end

	local state = CombatServer.GetOrCreateState(player)
	if state.EquippedWeapon == weaponId then
		return
	end

	state.EquippedWeapon = weaponId
	state.IsReloading = false
	state.ReloadToken += 1
	state.IsAiming = false
	state.LastShotClock = os.clock() - stats.FireRate + stats.EquipTime

	CombatServer.AttachThirdPersonWeapon(player)
	CombatServer.SyncWeaponState(player)
end

function CombatServer.ReloadWeapon(player: Player)
	local state = CombatServer.GetOrCreateState(player)
	if state.IsReloading then
		return
	end

	local stats = WeaponConfig.GetWeapon(state.EquippedWeapon)
	if not stats then
		return
	end

	local ammoInfo = state.Ammo[state.EquippedWeapon]
	if not ammoInfo or ammoInfo.Mag &gt;= stats.MagazineSize or ammoInfo.Reserve &lt;= 0 then
		return
	end

	state.IsReloading = true
	state.ReloadToken += 1
	local currentToken = state.ReloadToken
	local reloadingWeapon = state.EquippedWeapon
	CombatServer.SyncWeaponState(player)

	task.delay(stats.ReloadTime, function()
		local latestState = PlayerStates[player]
		if not latestState then
			return
		end
		if latestState.ReloadToken ~= currentToken or latestState.EquippedWeapon ~= reloadingWeapon then
			return
		end

		local currentAmmo = latestState.Ammo[reloadingWeapon]
		if currentAmmo then
			local needed = stats.MagazineSize - currentAmmo.Mag
			local transfer = math.min(needed, currentAmmo.Reserve)
			currentAmmo.Mag += transfer
			currentAmmo.Reserve -= transfer
		end

		latestState.IsReloading = false
		CombatServer.SyncWeaponState(player)
	end)
end

function CombatServer.SetAimState(player: Player, isAiming: boolean)
	local state = CombatServer.GetOrCreateState(player)
	state.IsAiming = (isAiming == true)
end

local function findCharacterModel(instance: Instance?): (Model?, Humanoid?)
	local curr = instance
	while curr and curr ~= Workspace do
		if curr:IsA(&quot;Model&quot;) then
			local hum = curr:FindFirstChildOfClass(&quot;Humanoid&quot;)
			if hum then
				return curr, hum
			end
		end
		curr = curr.Parent
	end
	return nil, nil
end

function CombatServer.HandleFireWeapon(
	player: Player,
	clientOrigin: Vector3,
	clientDirections: { Vector3 }
)
	if typeof(clientOrigin) ~= &quot;Vector3&quot; or type(clientDirections) ~= &quot;table&quot; then
		return
	end

	if CombatServer.CanPlayerAttack and not CombatServer.CanPlayerAttack(player) then
		return
	end

	local char = player.Character
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local head = (char:FindFirstChild(&quot;Head&quot;) or char:FindFirstChild(&quot;HumanoidRootPart&quot;)) :: BasePart?
	if not hum or hum.Health &lt;= 0 or not head then
		return
	end

	local state = CombatServer.GetOrCreateState(player)
	if state.IsReloading then
		return
	end

	local stats = WeaponConfig.GetWeapon(state.EquippedWeapon)
	if not stats then
		return
	end

	local ammoInfo = state.Ammo[state.EquippedWeapon]
	if not ammoInfo or ammoInfo.Mag &lt;= 0 then
		CombatServer.ReloadWeapon(player)
		return
	end

	-- Server-side fire rate anti-cheat check (allow 15% network jitter tolerance)
	local now = os.clock()
	if (now - state.LastShotClock) &lt; (stats.FireRate * 0.85) then
		return
	end

	-- Validate ray origin is near the player&apos;s head/camera (prevent wallhack origin spoofing)
	local validatedOrigin = clientOrigin
	if (clientOrigin - head.Position).Magnitude &gt; 14 then
		validatedOrigin = head.Position
	end

	-- Consume 1 round
	ammoInfo.Mag -= 1
	state.LastShotClock = now
	CombatServer.SyncWeaponState(player)

	-- Auto-reload if magazine hits 0
	if ammoInfo.Mag &lt;= 0 and ammoInfo.Reserve &gt; 0 then
		task.defer(function()
			CombatServer.ReloadWeapon(player)
		end)
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char }
	rayParams.IgnoreWater = true

	local profile = DataManager.GetProfile(player)
	local skin = ShopConfig.GetWeaponSkin(profile.EquippedWeaponSkin)

	local pelletCount = math.min(stats.Pellets, math.max(1, #clientDirections))
	local tracerEndpoints: { Vector3 } = {}
	local hitEffects: { { Pos: Vector3, IsCharacter: boolean, IsHeadshot: boolean } } = {}

	-- Track aggregated damage per victim model for multi-pellet weapons like Shotgun
	local aggregatedHits: {
		[Model]: {
			TotalDamage: number,
			AnyHeadshot: boolean,
			LastHitPos: Vector3,
		},
	} = {}

	for i = 1, pelletCount do
		local rawDir = clientDirections[i]
		if typeof(rawDir) == &quot;Vector3&quot; and rawDir.Magnitude &gt; 0.001 then
			local unitDir = rawDir.Unit
			local result = Workspace:Raycast(validatedOrigin, unitDir * stats.MaxRange, rayParams)

			if result then
				table.insert(tracerEndpoints, result.Position)
				local hitModel, hitHum = findCharacterModel(result.Instance)

				if hitModel and hitHum and hitHum.Health &gt; 0 and hitModel ~= char then
					local partName = result.Instance.Name
					local isHeadshot = (partName == &quot;Head&quot; or partName == &quot;CyberArmor_Visor&quot;)
					local pelletDamage = stats.BaseDamage * (if isHeadshot then stats.HeadshotMultiplier else 1)

					-- Distance falloff for Shotgun &amp; SMG
					local dist = (result.Position - validatedOrigin).Magnitude
					if stats.Id == &quot;Shotgun&quot; and dist &gt; 45 then
						local falloff = math.clamp(1 - ((dist - 45) / (stats.MaxRange - 45)), 0.35, 1)
						pelletDamage *= falloff
					end

					local entry = aggregatedHits[hitModel]
					if not entry then
						entry = {
							TotalDamage = 0,
							AnyHeadshot = false,
							LastHitPos = result.Position,
						}
						aggregatedHits[hitModel] = entry
					end
					entry.TotalDamage += pelletDamage
					if isHeadshot then
						entry.AnyHeadshot = true
					end
					entry.LastHitPos = result.Position

					table.insert(hitEffects, {
						Pos = result.Position,
						IsCharacter = true,
						IsHeadshot = isHeadshot,
					})
				else
					table.insert(hitEffects, {
						Pos = result.Position,
						IsCharacter = false,
						IsHeadshot = false,
					})
				end
			else
				table.insert(tracerEndpoints, validatedOrigin + unitDir * stats.MaxRange)
			end
		end
	end

	-- Apply server-validated damage to each hit victim
	if CombatServer.OnValidatedHit then
		for victimModel, hitData in pairs(aggregatedHits) do
			local finalDamage = math.max(1, math.floor(hitData.TotalDamage + 0.5))
			CombatServer.OnValidatedHit(
				player,
				victimModel,
				finalDamage,
				hitData.AnyHeadshot,
				stats.Id,
				hitData.LastHitPos
			)
		end
	end

	-- Broadcast weapon fire visuals (tracers, sounds, impact sparks) to clients
	local remotes = ReplicatedStorage:FindFirstChild(&quot;Remotes&quot;)
	if remotes then
		local visualRemote = remotes:FindFirstChild(&quot;WeaponFiredVisual&quot;) :: RemoteEvent?
		if visualRemote then
			visualRemote:FireAllClients(
				player,
				state.EquippedWeapon,
				validatedOrigin,
				tracerEndpoints,
				hitEffects,
				skin.PrimaryNeon
			)
		end
	end
end

function CombatServer.CleanupPlayer(player: Player)
	PlayerStates[player] = nil
end

return CombatServer

</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SRV_MATCH">
      <Properties>
        <string name="Name">MatchManager</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ServerScriptService.MatchManager
	Description: Server-authoritative 1v1 matchmaking, Friend Challenges, Private Matches,
	Practice Mode (Training Dummy), 100 HP combat loop, and the mandatory 120-second
	(2-minute) seamless Arena Rotation system that preserves both players&apos; HP.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local ArenaConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ArenaConfig&quot;))
local WeaponConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;WeaponConfig&quot;))
local DataManager = require(script.Parent:WaitForChild(&quot;DataManager&quot;))
local ArenaBuilder = require(script.Parent:WaitForChild(&quot;ArenaBuilder&quot;))
local CombatServer = require(script.Parent:WaitForChild(&quot;CombatServer&quot;))
local ShopServer = require(script.Parent:WaitForChild(&quot;ShopServer&quot;))

local MatchManager = {}

export type MatchSession = {
	MatchId: string,
	Mode: &quot;Quick1v1&quot; | &quot;FriendMatch&quot; | &quot;PrivateMatch&quot; | &quot;PracticeMode&quot;,
	Player1: Player,
	Player2: Player?, -- nil in PracticeMode (uses DummyModel instead)
	DummyModel: Model?,
	DummyCombatEnabled: boolean,
	DummyNextFireClock: number,
	P1Kills: number,
	P2Kills: number,
	WinCondition: number,
	CurrentArenaIndex: number,
	ArenaTimeRemaining: number, -- Counts down from 120s (2 minutes)
	IsRotatingArena: boolean,
	IsEnded: boolean,
}

export type PrivateRoom = {
	RoomCode: string,
	Host: Player,
	WinCondition: number,
	StartArenaIndex: number,
}

local ActiveMatches: { [string]: MatchSession } = {}
local PlayerToMatch: { [Player]: MatchSession } = {}
local QuickQueue: { Player } = {}
local PrivateRooms: { [string]: PrivateRoom } = {}
local PendingFriendChallenges: { [Player]: Player } = {} -- [TargetPlayer] = ChallengerPlayer

local matchCounter = 0

local function getRemotes(): Folder
	return ReplicatedStorage:WaitForChild(&quot;Remotes&quot;) :: Folder
end

local function getCharacterHealth(char: Model?): number
	if not char then
		return 0
	end
	local hum = char:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not hum then
		return 0
	end
	return math.clamp(math.ceil(hum.Health), 0, 100)
end

local function buildMatchSnapshot(match: MatchSession)
	local arenaDef = ArenaConfig.GetArenaByIndex(match.CurrentArenaIndex)
	local p1Health = getCharacterHealth(match.Player1.Character)
	local p2Health = if match.Player2
		then getCharacterHealth(match.Player2.Character)
		else getCharacterHealth(match.DummyModel)
	local p2Name = if match.Player2 then match.Player2.Name else &quot;CYBER BOT [MK-IV]&quot;

	return {
		MatchId = match.MatchId,
		Mode = match.Mode,
		P1Name = match.Player1.Name,
		P2Name = p2Name,
		P1Kills = match.P1Kills,
		P2Kills = match.P2Kills,
		P1Health = p1Health,
		P1MaxHealth = 100,
		P2Health = p2Health,
		P2MaxHealth = 100,
		WinCondition = match.WinCondition,
		ArenaIndex = match.CurrentArenaIndex,
		ArenaId = arenaDef.Id,
		ArenaName = arenaDef.Name,
		ArenaSubtitle = arenaDef.Subtitle,
		ArenaTimeRemaining = math.ceil(match.ArenaTimeRemaining),
		ArenaDuration = ArenaConfig.ROTATION_INTERVAL, -- 120 seconds
		IsEnded = match.IsEnded,
	}
end

function MatchManager.BroadcastMatchState(match: MatchSession)
	local remotes = getRemotes()
	local stateRemote = remotes:FindFirstChild(&quot;MatchStateUpdate&quot;) :: RemoteEvent?
	if not stateRemote then
		return
	end

	local snapshot = buildMatchSnapshot(match)
	stateRemote:FireClient(match.Player1, snapshot)
	if match.Player2 then
		stateRemote:FireClient(match.Player2, snapshot)
	end
end

local function spawnOrTeleportCharacter(
	player: Player,
	targetCFrame: CFrame,
	preserveCurrentHealth: boolean,
	savedHealth: number?
)
	local char = player.Character
	if not char or not char:FindFirstChildOfClass(&quot;Humanoid&quot;) or (char:FindFirstChildOfClass(&quot;Humanoid&quot;) :: Humanoid).Health &lt;= 0 then
		player:LoadCharacter()
		char = player.Character or player.CharacterAdded:Wait()
	end

	local hum = char:WaitForChild(&quot;Humanoid&quot;, 5) :: Humanoid?
	local root = char:WaitForChild(&quot;HumanoidRootPart&quot;, 5) :: BasePart?

	if hum then
		hum.MaxHealth = 100
		if preserveCurrentHealth and savedHealth and savedHealth &gt; 0 then
			-- CRITICAL: Keep exact player HP during 120-second arena rotation
			hum.Health = math.clamp(savedHealth, 1, 100)
		else
			hum.Health = 100
		end
		hum.WalkSpeed = 19
		hum.JumpPower = 52
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		char:PivotTo(targetCFrame)
	end

	ShopServer.ApplyCharacterSkin(player, char)

	if not preserveCurrentHealth then
		CombatServer.ResetLoadout(player)
	else
		CombatServer.AttachThirdPersonWeapon(player)
		CombatServer.SyncWeaponState(player)
	end
end

local function createTrainingDummy(spawnCFrame: CFrame, preserveHealth: number?): Model
	local dummy = Instance.new(&quot;Model&quot;)
	dummy.Name = &quot;CYBER BOT [MK-IV]&quot;

	local root = Instance.new(&quot;Part&quot;)
	root.Name = &quot;HumanoidRootPart&quot;
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.Anchored = true
	root.CFrame = spawnCFrame
	root.Parent = dummy
	dummy.PrimaryPart = root

	local torso = Instance.new(&quot;Part&quot;)
	torso.Name = &quot;UpperTorso&quot;
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = Color3.fromRGB(24, 18, 36)
	torso.Material = Enum.Material.Metal
	torso.CanCollide = true
	torso.CFrame = spawnCFrame
	torso.Parent = dummy

	local weldTorso = Instance.new(&quot;WeldConstraint&quot;)
	weldTorso.Part0 = root
	weldTorso.Part1 = torso
	weldTorso.Parent = torso

	local head = Instance.new(&quot;Part&quot;)
	head.Name = &quot;Head&quot;
	head.Size = Vector3.new(1.25, 1.25, 1.25)
	head.Color = Color3.fromRGB(20, 22, 32)
	head.Material = Enum.Material.Metal
	head.CanCollide = true
	head.CFrame = spawnCFrame * CFrame.new(0, 1.65, 0)
	head.Parent = dummy

	local weldHead = Instance.new(&quot;WeldConstraint&quot;)
	weldHead.Part0 = root
	weldHead.Part1 = head
	weldHead.Parent = head

	local visor = Instance.new(&quot;Part&quot;)
	visor.Name = &quot;CyberArmor_Visor&quot;
	visor.Size = Vector3.new(1.28, 0.36, 0.65)
	visor.Color = Color3.fromRGB(255, 40, 175)
	visor.Material = Enum.Material.Neon
	visor.CanCollide = false
	visor.CFrame = head.CFrame * CFrame.new(0, 0.1, -0.35)
	visor.Parent = dummy

	local weldVisor = Instance.new(&quot;WeldConstraint&quot;)
	weldVisor.Part0 = head
	weldVisor.Part1 = visor
	weldVisor.Parent = visor

	local core = Instance.new(&quot;Part&quot;)
	core.Name = &quot;CyberArmor_ChestCore&quot;
	core.Size = Vector3.new(0.9, 0.9, 0.25)
	core.Color = Color3.fromRGB(0, 240, 255)
	core.Material = Enum.Material.Neon
	core.CanCollide = false
	core.CFrame = torso.CFrame * CFrame.new(0, 0.2, -0.45) * CFrame.Angles(0, 0, math.rad(45))
	core.Parent = dummy

	local weldCore = Instance.new(&quot;WeldConstraint&quot;)
	weldCore.Part0 = torso
	weldCore.Part1 = core
	weldCore.Parent = core

	-- Limbs
	local limbOffsets = {
		{ Name = &quot;LeftArm&quot;, Offset = CFrame.new(-1.5, 0, 0), Size = Vector3.new(1, 2, 1) },
		{ Name = &quot;RightArm&quot;, Offset = CFrame.new(1.5, 0, 0), Size = Vector3.new(1, 2, 1) },
		{ Name = &quot;LeftLeg&quot;, Offset = CFrame.new(-0.55, -2, 0), Size = Vector3.new(1, 2, 1) },
		{ Name = &quot;RightLeg&quot;, Offset = CFrame.new(0.55, -2, 0), Size = Vector3.new(1, 2, 1) },
	}
	for _, limbInfo in ipairs(limbOffsets) do
		local limb = Instance.new(&quot;Part&quot;)
		limb.Name = limbInfo.Name
		limb.Size = limbInfo.Size
		limb.Color = Color3.fromRGB(18, 22, 34)
		limb.Material = Enum.Material.Metal
		limb.CanCollide = false
		limb.CFrame = spawnCFrame * limbInfo.Offset
		limb.Parent = dummy

		local w = Instance.new(&quot;WeldConstraint&quot;)
		w.Part0 = root
		w.Part1 = limb
		w.Parent = limb
	end

	local hum = Instance.new(&quot;Humanoid&quot;)
	hum.MaxHealth = 100
	hum.Health = if preserveHealth and preserveHealth &gt; 0 then math.clamp(preserveHealth, 1, 100) else 100
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.Parent = dummy

	dummy.Parent = Workspace
	return dummy
end

--[[
	IMPORTANT ARENA ROTATION LOGIC:
	Triggered every 120 seconds (2 minutes).
	Switches to the next unique arena smoothly while keeping both players&apos; exact HP!
]]
local function rotateMatchArena(match: MatchSession)
	if match.IsEnded or match.IsRotatingArena then
		return
	end
	match.IsRotatingArena = true

	-- Record both players&apos; exact current HP BEFORE switching arenas
	local p1SavedHP = getCharacterHealth(match.Player1.Character)
	if p1SavedHP &lt;= 0 then
		p1SavedHP = 100
	end

	local p2SavedHP = 100
	if match.Player2 then
		p2SavedHP = getCharacterHealth(match.Player2.Character)
		if p2SavedHP &lt;= 0 then
			p2SavedHP = 100
		end
	elseif match.DummyModel then
		p2SavedHP = getCharacterHealth(match.DummyModel)
		if p2SavedHP &lt;= 0 then
			p2SavedHP = 100
		end
	end

	local nextArenaIndex = ArenaConfig.GetNextArenaIndex(match.CurrentArenaIndex)
	local nextArenaDef = ArenaConfig.GetArenaByIndex(nextArenaIndex)

	match.CurrentArenaIndex = nextArenaIndex
	match.ArenaTimeRemaining = ArenaConfig.ROTATION_INTERVAL -- Reset to 120 seconds

	-- Notify clients to play smooth ARENA CHANGING animation
	local remotes = getRemotes()
	local rotationRemote = remotes:FindFirstChild(&quot;ArenaRotationUpdate&quot;) :: RemoteEvent?
	if rotationRemote then
		local payload = {
			NewArenaIndex = nextArenaIndex,
			NewArenaId = nextArenaDef.Id,
			NewArenaName = nextArenaDef.Name,
			NewArenaSubtitle = nextArenaDef.Subtitle,
			Duration = ArenaConfig.ROTATION_INTERVAL,
			P1PreservedHP = p1SavedHP,
			P2PreservedHP = p2SavedHP,
		}
		rotationRemote:FireClient(match.Player1, payload)
		if match.Player2 then
			rotationRemote:FireClient(match.Player2, payload)
		end
	end

	-- Teleport both players mid-transition and preserve their exact HP
	task.delay(0.45, function()
		if match.IsEnded then
			return
		end

		local spawn1, spawn2 = ArenaBuilder.GetSpawnCFrames(nextArenaIndex)
		spawnOrTeleportCharacter(match.Player1, spawn1, true, p1SavedHP)

		if match.Player2 then
			spawnOrTeleportCharacter(match.Player2, spawn2, true, p2SavedHP)
		elseif match.DummyModel then
			match.DummyModel:Destroy()
			match.DummyModel = createTrainingDummy(spawn2, p2SavedHP)
		end

		match.IsRotatingArena = false
		MatchManager.BroadcastMatchState(match)
	end)
end

function MatchManager.StartMatch(
	player1: Player,
	player2: Player?,
	mode: &quot;Quick1v1&quot; | &quot;FriendMatch&quot; | &quot;PrivateMatch&quot; | &quot;PracticeMode&quot;,
	winCondition: number?,
	startArenaIndex: number?,
	dummyCombatEnabled: boolean?
): MatchSession
	-- Clean up any previous match for these players
	if PlayerToMatch[player1] then
		MatchManager.LeaveMatch(player1)
	end
	if player2 and PlayerToMatch[player2] then
		MatchManager.LeaveMatch(player2)
	end

	matchCounter += 1
	local matchId = &quot;Match_&quot; .. tostring(matchCounter) .. &quot;_&quot; .. tostring(math.floor(os.clock()))
	local arenaIdx = startArenaIndex or math.random(1, #ArenaConfig.Arenas)
	local targetWins = math.clamp(winCondition or ArenaConfig.DEFAULT_WIN_KILLS, 3, 30)

	local spawn1, spawn2 = ArenaBuilder.GetSpawnCFrames(arenaIdx)
	local dummyModel: Model? = nil
	if not player2 then
		dummyModel = createTrainingDummy(spawn2, 100)
	end

	local session: MatchSession = {
		MatchId = matchId,
		Mode = mode,
		Player1 = player1,
		Player2 = player2,
		DummyModel = dummyModel,
		DummyCombatEnabled = if dummyCombatEnabled ~= nil then dummyCombatEnabled else true,
		DummyNextFireClock = os.clock() + 2.5,
		P1Kills = 0,
		P2Kills = 0,
		WinCondition = targetWins,
		CurrentArenaIndex = arenaIdx,
		ArenaTimeRemaining = ArenaConfig.ROTATION_INTERVAL, -- 120 seconds (2 minutes)
		IsRotatingArena = false,
		IsEnded = false,
	}

	ActiveMatches[matchId] = session
	PlayerToMatch[player1] = session
	if player2 then
		PlayerToMatch[player2] = session
	end

	spawnOrTeleportCharacter(player1, spawn1, false, 100)
	if player2 then
		spawnOrTeleportCharacter(player2, spawn2, false, 100)
	end

	MatchManager.BroadcastMatchState(session)
	return session
end

function MatchManager.EndMatch(match: MatchSession, winnerName: string, winnerPlayer: Player?)
	if match.IsEnded then
		return
	end
	match.IsEnded = true

	-- Award progression stats &amp; Coins/XP
	if match.Mode ~= &quot;PracticeMode&quot; then
		if winnerPlayer == match.Player1 then
			DataManager.RecordMatchOutcome(match.Player1, true)
			if match.Player2 then
				DataManager.RecordMatchOutcome(match.Player2, false)
			end
		elseif match.Player2 and winnerPlayer == match.Player2 then
			DataManager.RecordMatchOutcome(match.Player2, true)
			DataManager.RecordMatchOutcome(match.Player1, false)
		end
	else
		-- Practice mode completion reward
		DataManager.AddCoins(match.Player1, 50)
		DataManager.AddXP(match.Player1, 75)
	end

	local remotes = getRemotes()
	local endRemote = remotes:FindFirstChild(&quot;MatchEndedEvent&quot;) :: RemoteEvent?
	if endRemote then
		local summary = {
			MatchId = match.MatchId,
			Mode = match.Mode,
			WinnerName = winnerName,
			P1Name = match.Player1.Name,
			P2Name = if match.Player2 then match.Player2.Name else &quot;CYBER BOT [MK-IV]&quot;,
			P1Kills = match.P1Kills,
			P2Kills = match.P2Kills,
			WinCondition = match.WinCondition,
		}
		endRemote:FireClient(match.Player1, summary)
		if match.Player2 then
			endRemote:FireClient(match.Player2, summary)
		end
	end

	task.delay(4.5, function()
		MatchManager.CleanupMatch(match)
	end)
end

function MatchManager.CleanupMatch(match: MatchSession)
	ActiveMatches[match.MatchId] = nil

	if match.DummyModel then
		match.DummyModel:Destroy()
		match.DummyModel = nil
	end

	local function returnToMenu(plr: Player?)
		if not plr then
			return
		end
		if PlayerToMatch[plr] == match then
			PlayerToMatch[plr] = nil
		end
		if plr.Parent == Players then
			local char = plr.Character
			if char then
				char:PivotTo(CFrame.new(0, 505, 0))
			end
			local remotes = getRemotes()
			local stateRemote = remotes:FindFirstChild(&quot;MatchStateUpdate&quot;) :: RemoteEvent?
			if stateRemote then
				stateRemote:FireClient(plr, nil)
			end
		end
	end

	returnToMenu(match.Player1)
	returnToMenu(match.Player2)
end

function MatchManager.LeaveMatch(player: Player)
	-- Remove from queue if queued
	for i = #QuickQueue, 1, -1 do
		if QuickQueue[i] == player then
			table.remove(QuickQueue, i)
		end
	end

	-- Remove any hosted private room
	for code, room in pairs(PrivateRooms) do
		if room.Host == player then
			PrivateRooms[code] = nil
		end
	end

	local match = PlayerToMatch[player]
	if not match then
		return
	end

	if not match.IsEnded then
		if match.Player2 then
			local otherPlayer = if match.Player1 == player then match.Player2 else match.Player1
			if otherPlayer then
				MatchManager.EndMatch(match, otherPlayer.Name, otherPlayer)
				return
			end
		end
	end

	MatchManager.CleanupMatch(match)
end

-- ============================================================================
-- COMBAT DAMAGE &amp; KILL VALIDATION HOOKS
-- ============================================================================
CombatServer.CanPlayerAttack = function(player: Player): boolean
	local match = PlayerToMatch[player]
	if not match or match.IsEnded or match.IsRotatingArena then
		return false
	end
	return true
end

CombatServer.OnValidatedHit = function(
	attacker: Player,
	victimModel: Model,
	damage: number,
	isHeadshot: boolean,
	weaponId: string,
	hitPosition: Vector3
)
	local match = PlayerToMatch[attacker]
	if not match or match.IsEnded or match.IsRotatingArena then
		return
	end

	-- Verify victim belongs to this match
	local victimPlayer = Players:GetPlayerFromCharacter(victimModel)
	local isDummyVictim = (match.DummyModel ~= nil and victimModel == match.DummyModel)

	if victimPlayer then
		if victimPlayer ~= match.Player1 and victimPlayer ~= match.Player2 then
			return
		end
		if victimPlayer == attacker then
			return
		end
	elseif not isDummyVictim then
		return
	end

	local hum = victimModel:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not hum or hum.Health &lt;= 0 then
		return
	end

	local newHealth = math.max(0, hum.Health - damage)
	hum.Health = newHealth

	-- Send floating damage &amp; hitmarker confirmation to attacker and victim
	local remotes = getRemotes()
	local dmgRemote = remotes:FindFirstChild(&quot;DamageIndicator&quot;) :: RemoteEvent?
	if dmgRemote then
		dmgRemote:FireClient(attacker, {
			Type = &quot;Dealt&quot;,
			Damage = damage,
			IsHeadshot = isHeadshot,
			HitPosition = hitPosition,
			VictimRemainingHP = math.ceil(newHealth),
		})
		if victimPlayer then
			dmgRemote:FireClient(victimPlayer, {
				Type = &quot;Taken&quot;,
				Damage = damage,
				IsHeadshot = isHeadshot,
				AttackerName = attacker.Name,
			})
		end
	end

	MatchManager.BroadcastMatchState(match)

	-- Handle Elimination &amp; Win Condition
	if newHealth &lt;= 0 then
		if attacker == match.Player1 then
			match.P1Kills += 1
		else
			match.P2Kills += 1
		end

		DataManager.RecordKill(attacker)
		if victimPlayer then
			DataManager.RecordDeath(victimPlayer)
		end

		local weaponStats = WeaponConfig.GetWeapon(weaponId)
		local weaponDisplayName = if weaponStats then weaponStats.Name else weaponId
		local victimName = if victimPlayer then victimPlayer.Name else &quot;CYBER BOT [MK-IV]&quot;

		local killRemote = remotes:FindFirstChild(&quot;KillFeedEvent&quot;) :: RemoteEvent?
		if killRemote then
			local killPayload = {
				Killer = attacker.Name,
				Victim = victimName,
				Weapon = weaponDisplayName,
				IsHeadshot = isHeadshot,
				P1Kills = match.P1Kills,
				P2Kills = match.P2Kills,
			}
			killRemote:FireClient(match.Player1, killPayload)
			if match.Player2 then
				killRemote:FireClient(match.Player2, killPayload)
			end
		end

		MatchManager.BroadcastMatchState(match)

		-- Check if attacker reached the configured Win Condition
		if match.P1Kills &gt;= match.WinCondition then
			MatchManager.EndMatch(match, match.Player1.Name, match.Player1)
			return
		elseif match.P2Kills &gt;= match.WinCondition then
			local p2Name = if match.Player2 then match.Player2.Name else &quot;CYBER BOT [MK-IV]&quot;
			MatchManager.EndMatch(match, p2Name, match.Player2)
			return
		end

		-- Respawn eliminated player/dummy in current arena after 2.2 seconds
		task.delay(2.2, function()
			if match.IsEnded then
				return
			end
			local spawn1, spawn2 = ArenaBuilder.GetSpawnCFrames(match.CurrentArenaIndex)
			if victimPlayer == match.Player1 then
				spawnOrTeleportCharacter(match.Player1, spawn1, false, 100)
			elseif victimPlayer and victimPlayer == match.Player2 then
				spawnOrTeleportCharacter(victimPlayer, spawn2, false, 100)
			elseif isDummyVictim then
				if match.DummyModel then
					match.DummyModel:Destroy()
				end
				match.DummyModel = createTrainingDummy(spawn2, 100)
			end
			MatchManager.BroadcastMatchState(match)
		end)
	end
end

-- ============================================================================
-- QUEUE, FRIEND MATCH, PRIVATE ROOM, AND PRACTICE HANDLERS
-- ============================================================================
function MatchManager.HandleQueueAction(player: Player, action: string)
	local remotes = getRemotes()
	local notifyRemote = remotes:FindFirstChild(&quot;MenuNotification&quot;) :: RemoteEvent?

	if action == &quot;JoinQueue&quot; then
		if PlayerToMatch[player] then
			return
		end
		for _, queuedPlr in ipairs(QuickQueue) do
			if queuedPlr == player then
				return
			end
		end
		table.insert(QuickQueue, player)

		if #QuickQueue &gt;= 2 then
			local p1 = table.remove(QuickQueue, 1) :: Player
			local p2 = table.remove(QuickQueue, 1) :: Player
			if p1 and p2 and p1.Parent == Players and p2.Parent == Players then
				MatchManager.StartMatch(p1, p2, &quot;Quick1v1&quot;, ArenaConfig.DEFAULT_WIN_KILLS)
				return
			end
		end

		if notifyRemote then
			notifyRemote:FireClient(player, &quot;QueueStatus&quot;, {
				InQueue = true,
				QueueCount = #QuickQueue,
				Message = &quot;SEARCHING FOR 1VS1 OPPONENT... (OR CLICK SOLO CYBER DUEL)&quot;,
			})
		end
	elseif action == &quot;LeaveQueue&quot; then
		for i = #QuickQueue, 1, -1 do
			if QuickQueue[i] == player then
				table.remove(QuickQueue, i)
			end
		end
		if notifyRemote then
			notifyRemote:FireClient(player, &quot;QueueStatus&quot;, {
				InQueue = false,
				QueueCount = #QuickQueue,
				Message = &quot;QUEUE CANCELLED&quot;,
			})
		end
	elseif action == &quot;LeaveMatch&quot; then
		MatchManager.LeaveMatch(player)
	end
end

function MatchManager.HandlePracticeAction(
	player: Player,
	winCondition: number?,
	startArenaIndex: number?,
	botFiresBack: boolean?
)
	MatchManager.StartMatch(
		player,
		nil,
		&quot;PracticeMode&quot;,
		winCondition or 10,
		startArenaIndex or 1,
		if botFiresBack ~= nil then botFiresBack else true
	)
end

function MatchManager.HandleFriendAndPrivateAction(player: Player, action: string, data: { [string]: any }?)
	local remotes = getRemotes()
	local notifyRemote = remotes:FindFirstChild(&quot;MenuNotification&quot;) :: RemoteEvent?
	local payload = data or {}

	if action == &quot;CreatePrivateRoom&quot; then
		local code = &quot;NEON&quot; .. tostring(math.random(10, 99))
		local winCond = math.clamp(tonumber(payload.WinCondition) or 10, 5, 25)
		local startArena = math.clamp(tonumber(payload.ArenaIndex) or 1, 1, #ArenaConfig.Arenas)
		PrivateRooms[code] = {
			RoomCode = code,
			Host = player,
			WinCondition = winCond,
			StartArenaIndex = startArena,
		}
		if notifyRemote then
			notifyRemote:FireClient(player, &quot;PrivateRoomCreated&quot;, {
				RoomCode = code,
				WinCondition = winCond,
				ArenaIndex = startArena,
			})
		end
	elseif action == &quot;JoinPrivateRoom&quot; then
		local code = string.upper(tostring(payload.RoomCode or &quot;&quot;))
		local room = PrivateRooms[code]
		if not room or not room.Host or room.Host.Parent ~= Players then
			if notifyRemote then
				notifyRemote:FireClient(player, &quot;Error&quot;, { Message = &quot;ROOM CODE NOT FOUND: &quot; .. code })
			end
			return
		end
		if room.Host == player then
			-- Allow host to launch immediately into the room against Cyber Bot if testing solo
			PrivateRooms[code] = nil
			MatchManager.StartMatch(player, nil, &quot;PrivateMatch&quot;, room.WinCondition, room.StartArenaIndex, true)
			return
		end
		local host = room.Host
		PrivateRooms[code] = nil
		MatchManager.StartMatch(host, player, &quot;PrivateMatch&quot;, room.WinCondition, room.StartArenaIndex)
	elseif action == &quot;ChallengePlayer&quot; then
		local targetName = tostring(payload.TargetName or &quot;&quot;)
		local targetPlayer = Players:FindFirstChild(targetName) :: Player?
		if not targetPlayer or targetPlayer == player then
			if notifyRemote then
				notifyRemote:FireClient(player, &quot;Error&quot;, { Message = &quot;PLAYER UNAVAILABLE FOR DUEL&quot; })
			end
			return
		end
		PendingFriendChallenges[targetPlayer] = player
		if notifyRemote then
			notifyRemote:FireClient(targetPlayer, &quot;IncomingChallenge&quot;, {
				ChallengerName = player.Name,
			})
			notifyRemote:FireClient(player, &quot;Info&quot;, {
				Message = &quot;CHALLENGE SENT TO &quot; .. targetPlayer.Name,
			})
		end
	elseif action == &quot;AcceptChallenge&quot; then
		local challenger = PendingFriendChallenges[player]
		PendingFriendChallenges[player] = nil
		if challenger and challenger.Parent == Players then
			MatchManager.StartMatch(challenger, player, &quot;FriendMatch&quot;, ArenaConfig.DEFAULT_WIN_KILLS, 1)
		end
	end
end

-- ============================================================================
-- MASTER 1-SECOND &amp; HEARTBEAT LOOP (120s ARENA ROTATION &amp; TRAINING DUMMY AI)
-- ============================================================================
function MatchManager.StartLoop()
	-- 1-second authoritative timer for 120-second Arena Rotation
	task.spawn(function()
		while true do
			task.wait(1)
			for _, match in pairs(ActiveMatches) do
				if not match.IsEnded and not match.IsRotatingArena then
					match.ArenaTimeRemaining = math.max(0, match.ArenaTimeRemaining - 1)
					if match.ArenaTimeRemaining &lt;= 0 then
						rotateMatchArena(match)
					else
						MatchManager.BroadcastMatchState(match)
					end
				end
			end
		end
	end)

	-- Smooth Training Dummy movement &amp; sparring loop (60Hz)
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, match in pairs(ActiveMatches) do
			if not match.IsEnded and not match.IsRotatingArena and match.DummyModel then
				local dummy = match.DummyModel
				local dummyHum = dummy:FindFirstChildOfClass(&quot;Humanoid&quot;)
				local dummyRoot = dummy.PrimaryPart
				if dummyHum and dummyHum.Health &gt; 0 and dummyRoot then
					local _, baseSpawn2 = ArenaBuilder.GetSpawnCFrames(match.CurrentArenaIndex)
					local strafeX = math.sin(now * 1.9) * 18
					local advanceZ = math.cos(now * 1.1) * 10
					local targetPos = baseSpawn2.Position + Vector3.new(strafeX, 0, advanceZ)

					local p1Char = match.Player1.Character
					local p1Root = if p1Char then p1Char:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart? else nil
					local lookTarget = if p1Root
						then Vector3.new(p1Root.Position.X, targetPos.Y, p1Root.Position.Z)
						else (targetPos + baseSpawn2.LookVector * 10)

					dummy:PivotTo(CFrame.lookAt(targetPos, lookTarget))

					-- Optional sparring fire from Cyber Bot so the player can test taking damage &amp; health HUD
					if match.DummyCombatEnabled and p1Root and now &gt;= match.DummyNextFireClock then
						match.DummyNextFireClock = now + 1.65
						local p1Hum = if p1Char then p1Char:FindFirstChildOfClass(&quot;Humanoid&quot;) else nil
						if p1Hum and p1Hum.Health &gt; 0 then
							local botOrigin = targetPos + Vector3.new(0, 1.4, 0)
							local toPlayer = (p1Root.Position - botOrigin)
							if toPlayer.Magnitude &lt; 160 then
								local rayParams = RaycastParams.new()
								rayParams.FilterType = Enum.RaycastFilterType.Exclude
								rayParams.FilterDescendantsInstances = { dummy }
								local res = Workspace:Raycast(botOrigin, toPlayer.Unit * 160, rayParams)
								if res and p1Char and res.Instance:IsDescendantOf(p1Char) then
									-- Deal light sparring damage (8 HP)
									local nextHP = math.max(0, p1Hum.Health - 8)
									p1Hum.Health = nextHP

									local remotes = getRemotes()
									local visualRemote = remotes:FindFirstChild(&quot;WeaponFiredVisual&quot;) :: RemoteEvent?
									if visualRemote then
										visualRemote:FireClient(
											match.Player1,
											nil,
											&quot;SMG&quot;,
											botOrigin,
											{ res.Position },
											{ { Pos = res.Position, IsCharacter = true, IsHeadshot = false } },
											Color3.fromRGB(255, 45, 175)
										)
									end
									local dmgRemote = remotes:FindFirstChild(&quot;DamageIndicator&quot;) :: RemoteEvent?
									if dmgRemote then
										dmgRemote:FireClient(match.Player1, {
											Type = &quot;Taken&quot;,
											Damage = 8,
											IsHeadshot = false,
											AttackerName = &quot;CYBER BOT [MK-IV]&quot;,
										})
									end

									if nextHP &lt;= 0 then
										match.P2Kills += 1
										DataManager.RecordDeath(match.Player1)
										if match.P2Kills &gt;= match.WinCondition then
											MatchManager.EndMatch(match, &quot;CYBER BOT [MK-IV]&quot;, nil)
										else
											task.delay(2.2, function()
												if not match.IsEnded then
													local s1, _ = ArenaBuilder.GetSpawnCFrames(match.CurrentArenaIndex)
													spawnOrTeleportCharacter(match.Player1, s1, false, 100)
													MatchManager.BroadcastMatchState(match)
												end
											end)
										end
									end
									MatchManager.BroadcastMatchState(match)
								end
							end
						end
					end
				end
			end
		end
	end)
end

return MatchManager

</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX_SRV_SHOP">
      <Properties>
        <string name="Name">ShopServer</string>
        <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: ServerScriptService.ShopServer
	Description: Server-authoritative Shop handler for purchasing and equipping
	Weapon Skins and Player Character Skins, plus applying 3D cyber armor cosmetics.
]]

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local ShopConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ShopConfig&quot;))
local DataManager = require(script.Parent:WaitForChild(&quot;DataManager&quot;))

local ShopServer = {}

local function attachArmorPiece(
	character: Model,
	targetPartName: string,
	pieceName: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material
)
	local targetPart = character:FindFirstChild(targetPartName) :: BasePart?
	if not targetPart then
		return
	end

	local part = Instance.new(&quot;Part&quot;)
	part.Name = pieceName
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = targetPart.CFrame * offset
	part.Parent = character

	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = targetPart
	weld.Part1 = part
	weld.Parent = part
end

function ShopServer.ApplyCharacterSkin(player: Player, character: Model?)
	local char = character or player.Character
	if not char then
		return
	end

	local profile = DataManager.GetProfile(player)
	local skin = ShopConfig.GetCharacterSkin(profile.EquippedCharacterSkin)

	-- Clean previous armor pieces
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA(&quot;BasePart&quot;) and string.sub(child.Name, 1, 10) == &quot;CyberArmor&quot; then
			child:Destroy()
		end
	end

	-- Recolor body parts to sleek cyber suit colors
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA(&quot;BasePart&quot;) and part.Name ~= &quot;HumanoidRootPart&quot; then
			if part.Name == &quot;Head&quot; then
				part.Color = Color3.fromRGB(22, 24, 34)
			else
				part.Color = skin.SecondaryColor
			end
		end
	end

	-- Attach glowing neon visor to Head
	attachArmorPiece(
		char,
		&quot;Head&quot;,
		&quot;CyberArmor_Visor&quot;,
		Vector3.new(1.18, 0.34, 0.65),
		CFrame.new(0, 0.12, -0.32),
		skin.PrimaryNeon,
		Enum.Material.Neon
	)

	-- Attach glowing chest reactor core to UpperTorso or Torso
	local torsoName = if char:FindFirstChild(&quot;UpperTorso&quot;) then &quot;UpperTorso&quot; else &quot;Torso&quot;
	attachArmorPiece(
		char,
		torsoName,
		&quot;CyberArmor_ChestCore&quot;,
		Vector3.new(0.85, 0.85, 0.25),
		CFrame.new(0, 0.15, -0.52) * CFrame.Angles(0, 0, math.rad(45)),
		skin.PrimaryNeon,
		Enum.Material.Neon
	)
end

function ShopServer.HandleShopAction(
	player: Player,
	action: string,
	category: string,
	itemId: string
): (boolean, string)
	local profile = DataManager.GetProfile(player)

	if category == &quot;WeaponSkin&quot; then
		local skin = ShopConfig.GetWeaponSkin(itemId)
		if not skin or skin.Id ~= itemId then
			return false, &quot;Invalid weapon skin.&quot;
		end

		if action == &quot;Buy&quot; then
			if profile.OwnedWeaponSkins[itemId] then
				profile.EquippedWeaponSkin = itemId
				DataManager.SyncToClient(player)
				return true, &quot;Equipped &quot; .. skin.Name
			end
			if profile.Coins &lt; skin.Price then
				return false, &quot;Insufficient Coins (&quot; .. tostring(skin.Price) .. &quot; required).&quot;
			end
			profile.Coins -= skin.Price
			profile.OwnedWeaponSkins[itemId] = true
			profile.EquippedWeaponSkin = itemId
			DataManager.SaveProfile(player)
			DataManager.SyncToClient(player)
			return true, &quot;Purchased &amp; Equipped &quot; .. skin.Name
		elseif action == &quot;Equip&quot; then
			if not profile.OwnedWeaponSkins[itemId] then
				return false, &quot;You do not own this weapon skin yet.&quot;
			end
			profile.EquippedWeaponSkin = itemId
			DataManager.SaveProfile(player)
			DataManager.SyncToClient(player)
			return true, &quot;Equipped &quot; .. skin.Name
		end
	elseif category == &quot;CharacterSkin&quot; then
		local skin = ShopConfig.GetCharacterSkin(itemId)
		if not skin or skin.Id ~= itemId then
			return false, &quot;Invalid character skin.&quot;
		end

		if action == &quot;Buy&quot; then
			if profile.OwnedCharacterSkins[itemId] then
				profile.EquippedCharacterSkin = itemId
				ShopServer.ApplyCharacterSkin(player)
				DataManager.SyncToClient(player)
				return true, &quot;Equipped &quot; .. skin.Name
			end
			if profile.Coins &lt; skin.Price then
				return false, &quot;Insufficient Coins (&quot; .. tostring(skin.Price) .. &quot; required).&quot;
			end
			profile.Coins -= skin.Price
			profile.OwnedCharacterSkins[itemId] = true
			profile.EquippedCharacterSkin = itemId
			ShopServer.ApplyCharacterSkin(player)
			DataManager.SaveProfile(player)
			DataManager.SyncToClient(player)
			return true, &quot;Purchased &amp; Equipped &quot; .. skin.Name
		elseif action == &quot;Equip&quot; then
			if not profile.OwnedCharacterSkins[itemId] then
				return false, &quot;You do not own this character skin yet.&quot;
			end
			profile.EquippedCharacterSkin = itemId
			ShopServer.ApplyCharacterSkin(player)
			DataManager.SaveProfile(player)
			DataManager.SyncToClient(player)
			return true, &quot;Equipped &quot; .. skin.Name
		end
	end

	return false, &quot;Unknown shop action.&quot;
end

return ShopServer

</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX_STARTERPLAYER">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX_SPS">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX_CLI_MAIN">
        <Properties>
          <string name="Name">ClientMain</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Script: StarterPlayerScripts.ClientMain
	Description: Main client entry point. Initializes MainMenuUI, HUDController, and
	FPSController, and wires all client-side RemoteEvent listeners.
]]

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local StarterGui = game:GetService(&quot;StarterGui&quot;)

local MainMenuUI = require(script.Parent:WaitForChild(&quot;MainMenuUI&quot;))
local HUDController = require(script.Parent:WaitForChild(&quot;HUDController&quot;))
local FPSController = require(script.Parent:WaitForChild(&quot;FPSController&quot;))

-- Disable default Roblox CoreGui backpack &amp; health bar for clean competitive FPS UI
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local Remotes = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;)

-- Initialize Controllers
HUDController.Init()
MainMenuUI.Init()
FPSController.Init()

MainMenuUI.OnSettingsChanged = function(settings: any)
	FPSController.ApplySettings(settings)
end

-- Connect Server -&gt; Client RemoteEvents
local matchStateRemote = Remotes:WaitForChild(&quot;MatchStateUpdate&quot;) :: RemoteEvent
matchStateRemote.OnClientEvent:Connect(function(snapshot: any)
	if type(snapshot) == &quot;table&quot; then
		MainMenuUI.SetVisible(false)
		HUDController.SetVisible(true)
		FPSController.SetMatchActive(true)
		HUDController.UpdateMatchSnapshot(snapshot)
	else
		-- Returned to Main Menu
		FPSController.SetMatchActive(false)
		HUDController.SetVisible(false)
		MainMenuUI.SetVisible(true)
	end
end)

local arenaRotationRemote = Remotes:WaitForChild(&quot;ArenaRotationUpdate&quot;) :: RemoteEvent
arenaRotationRemote.OnClientEvent:Connect(function(payload: any)
	if type(payload) == &quot;table&quot; then
		HUDController.PlayArenaRotationAnimation(payload)
	end
end)

local weaponStateRemote = Remotes:WaitForChild(&quot;WeaponStateUpdate&quot;) :: RemoteEvent
weaponStateRemote.OnClientEvent:Connect(function(state: any)
	FPSController.UpdateWeaponStateFromServer(state)
end)

local weaponFiredRemote = Remotes:WaitForChild(&quot;WeaponFiredVisual&quot;) :: RemoteEvent
weaponFiredRemote.OnClientEvent:Connect(function(
	shooter: Player?,
	weaponId: string,
	origin: Vector3,
	endpoints: { Vector3 },
	hitEffects: any,
	neonColor: Color3
)
	FPSController.RenderWeaponFiredVisual(shooter, weaponId, origin, endpoints, hitEffects, neonColor)
end)

local damageRemote = Remotes:WaitForChild(&quot;DamageIndicator&quot;) :: RemoteEvent
damageRemote.OnClientEvent:Connect(function(info: any)
	HUDController.ShowDamageIndicator(info)
end)

local killFeedRemote = Remotes:WaitForChild(&quot;KillFeedEvent&quot;) :: RemoteEvent
killFeedRemote.OnClientEvent:Connect(function(killData: any)
	HUDController.PushKillFeed(killData)
end)

local matchEndedRemote = Remotes:WaitForChild(&quot;MatchEndedEvent&quot;) :: RemoteEvent
matchEndedRemote.OnClientEvent:Connect(function(summary: any)
	HUDController.ShowMatchEnded(summary)
end)

local playerDataRemote = Remotes:WaitForChild(&quot;PlayerDataUpdate&quot;) :: RemoteEvent
playerDataRemote.OnClientEvent:Connect(function(profile: any, leaderboard: any)
	MainMenuUI.UpdateProfileData(profile, leaderboard)
	if type(profile) == &quot;table&quot; and type(profile.EquippedWeaponSkin) == &quot;string&quot; then
		FPSController.SetEquippedSkin(profile.EquippedWeaponSkin)
	end
end)

local menuNotifRemote = Remotes:WaitForChild(&quot;MenuNotification&quot;) :: RemoteEvent
menuNotifRemote.OnClientEvent:Connect(function(notifType: string, payload: any)
	MainMenuUI.HandleNotification(notifType, if type(payload) == &quot;table&quot; then payload else {})
end)

</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_CLI_MENU">
        <Properties>
          <string name="Name">MainMenuUI</string>
          <ProtectedString name="Source">--!strict
--[[
	NEON DUEL — 1VS1 FPS SHOOTER
	Module: StarterPlayerScripts.MainMenuUI
	Description: Implements the Cybercity Edition 2.0 (Image 1) Main Menu layout with
	translucent left sidebar, glowing NEON DUEL Edition 2.0 logo, purple highlight box
	with corner targeting brackets, bottom-right navigation prompts, and full interactive
	modals for PLAY 1VS1, FRIEND MATCH / PRIVATE / PRACTICE, SHOP, PLAYER PROFILE, and SETTINGS.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)

local WeaponConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;WeaponConfig&quot;))
local ArenaConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ArenaConfig&quot;))
local ShopConfig = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;ShopConfig&quot;))
local SoundManager = require(ReplicatedStorage:WaitForChild(&quot;Modules&quot;):WaitForChild(&quot;SoundManager&quot;))

local MainMenuUI = {}

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild(&quot;PlayerGui&quot;)
local Remotes = ReplicatedStorage:WaitForChild(&quot;Remotes&quot;)

local MenuGui: ScreenGui? = nil
local RightModalContainer: Frame? = nil
local StatusBannerLabel: TextLabel? = nil
local TopProfileBadge: TextLabel? = nil

local CurrentProfile: any = {
	Coins = 350,
	XP = 0,
	Level = 1,
	Wins = 0,
	Losses = 0,
	Kills = 0,
	Deaths = 0,
	WinStreak = 0,
	OwnedWeaponSkins = { DefaultCyan = true },
	EquippedWeaponSkin = &quot;DefaultCyan&quot;,
	OwnedCharacterSkins = { CyberOperative = true },
	EquippedCharacterSkin = &quot;CyberOperative&quot;,
	Settings = {
		FOV = 78,
		Sensitivity = 0.5,
		AimSensitivity = 0.35,
		SfxVolume = 0.8,
		MusicVolume = 0.45,
		HighQualityNeon = true,
	},
}
local CurrentLeaderboard: { { Name: string, Wins: number, Level: number } } = {}
local SelectedMenuIndex = 1
local ActivePanelName = &quot;Play1v1&quot;
local InQueue = false

MainMenuUI.OnSettingsChanged = nil :: ((settings: any) -&gt; ())?

local function createCornerBrackets(parent: GuiObject): Frame
	local holder = Instance.new(&quot;Frame&quot;)
	holder.Name = &quot;CornerBrackets&quot;
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local len = 10
	local thick = 2
	local color = Color3.fromRGB(235, 245, 255)

	local segments = {
		-- Top Left
		{ Pos = UDim2.new(0, -4, 0, -4), Size = UDim2.fromOffset(len, thick) },
		{ Pos = UDim2.new(0, -4, 0, -4), Size = UDim2.fromOffset(thick, len) },
		-- Top Right
		{ Pos = UDim2.new(1, -len + 4, 0, -4), Size = UDim2.fromOffset(len, thick) },
		{ Pos = UDim2.new(1, 2, 0, -4), Size = UDim2.fromOffset(thick, len) },
		-- Bottom Left
		{ Pos = UDim2.new(0, -4, 1, 2), Size = UDim2.fromOffset(len, thick) },
		{ Pos = UDim2.new(0, -4, 1, -len + 4), Size = UDim2.fromOffset(thick, len) },
		-- Bottom Right
		{ Pos = UDim2.new(1, -len + 4, 1, 2), Size = UDim2.fromOffset(len, thick) },
		{ Pos = UDim2.new(1, 2, 1, -len + 4), Size = UDim2.fromOffset(thick, len) },
	}

	for _, seg in ipairs(segments) do
		local bar = Instance.new(&quot;Frame&quot;)
		bar.Position = seg.Pos
		bar.Size = seg.Size
		bar.BackgroundColor3 = color
		bar.BorderSizePixel = 0
		bar.Parent = holder
	end

	return holder
end

local function makeCyberButton(
	parent: Instance,
	text: string,
	size: UDim2,
	pos: UDim2,
	accentColor: Color3,
	onClick: () -&gt; ()
): TextButton
	local btn = Instance.new(&quot;TextButton&quot;)
	btn.Size = size
	btn.Position = pos
	btn.BackgroundColor3 = Color3.fromRGB(22, 18, 42)
	btn.BackgroundTransparency = 0.2
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Font = Enum.Font.GothamBold
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(240, 248, 255)
	btn.TextSize = 15
	btn.Parent = parent

	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.Color = accentColor
	stroke.Thickness = 1.6
	stroke.Transparency = 0.15
	stroke.Parent = btn

	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	btn.MouseEnter:Connect(function()
		SoundManager.Play2D(&quot;UIHover&quot;)
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = accentColor,
			TextColor3 = Color3.fromRGB(10, 12, 20),
		}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(22, 18, 42),
			TextColor3 = Color3.fromRGB(240, 248, 255),
		}):Play()
	end)

	btn.MouseButton1Click:Connect(function()
		SoundManager.Play2D(&quot;UIClick&quot;)
		onClick()
	end)

	return btn
end

local function clearModal()
	if not RightModalContainer then
		return
	end
	for _, child in ipairs(RightModalContainer:GetChildren()) do
		if not child:IsA(&quot;UIStroke&quot;) and not child:IsA(&quot;UICorner&quot;) then
			child:Destroy()
		end
	end
end

local function makeModalHeader(title: string, subtitle: string)
	if not RightModalContainer then
		return
	end
	local header = Instance.new(&quot;Frame&quot;)
	header.Name = &quot;Header&quot;
	header.Size = UDim2.new(1, -36, 0, 58)
	header.Position = UDim2.fromOffset(18, 14)
	header.BackgroundTransparency = 1
	header.Parent = RightModalContainer

	local titleLbl = Instance.new(&quot;TextLabel&quot;)
	titleLbl.Size = UDim2.new(1, 0, 0, 30)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Font = Enum.Font.Michroma
	titleLbl.Text = title
	titleLbl.TextColor3 = Color3.fromRGB(0, 240, 255)
	titleLbl.TextSize = 22
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = header

	local subLbl = Instance.new(&quot;TextLabel&quot;)
	subLbl.Size = UDim2.new(1, 0, 0, 20)
	subLbl.Position = UDim2.fromOffset(0, 32)
	subLbl.BackgroundTransparency = 1
	subLbl.Font = Enum.Font.RobotoMono
	subLbl.Text = subtitle
	subLbl.TextColor3 = Color3.fromRGB(195, 140, 255)
	subLbl.TextSize = 13
	subLbl.TextXAlignment = Enum.TextXAlignment.Left
	subLbl.Parent = header

	local divider = Instance.new(&quot;Frame&quot;)
	divider.Size = UDim2.new(1, 0, 0, 2)
	divider.Position = UDim2.fromOffset(0, 56)
	divider.BackgroundColor3 = Color3.fromRGB(165, 50, 255)
	divider.BorderSizePixel = 0
	divider.Parent = header
end

-- ============================================================================
-- MODAL 1: PLAY 1VS1 (Quick Matchmaking + Instant Cyber Duel)
-- ============================================================================
function MainMenuUI.RenderPlay1v1Modal()
	ActivePanelName = &quot;Play1v1&quot;
	clearModal()
	if not RightModalContainer then
		return
	end

	makeModalHeader(
		&quot;COMPETITIVE 1VS1 DUEL&quot;,
		&quot;2 PLAYERS // 100 HP // 5 WEAPON CLASSES // 120s ARENA ROTATION&quot;
	)

	local infoBox = Instance.new(&quot;Frame&quot;)
	infoBox.Size = UDim2.new(1, -36, 0, 155)
	infoBox.Position = UDim2.fromOffset(18, 84)
	infoBox.BackgroundColor3 = Color3.fromRGB(14, 16, 30)
	infoBox.BackgroundTransparency = 0.25
	infoBox.BorderSizePixel = 0
	infoBox.Parent = RightModalContainer

	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.Color = Color3.fromRGB(0, 225, 255)
	stroke.Thickness = 1.2
	stroke.Transparency = 0.4
	stroke.Parent = infoBox

	local rulesText = Instance.new(&quot;TextLabel&quot;)
	rulesText.Size = UDim2.new(1, -24, 1, -20)
	rulesText.Position = UDim2.fromOffset(12, 10)
	rulesText.BackgroundTransparency = 1
	rulesText.Font = Enum.Font.RobotoMono
	rulesText.TextColor3 = Color3.fromRGB(220, 235, 255)
	rulesText.TextSize = 14
	rulesText.TextWrapped = true
	rulesText.TextXAlignment = Enum.TextXAlignment.Left
	rulesText.TextYAlignment = Enum.TextYAlignment.Top
	rulesText.Text = &quot;• MATCH FORMAT: Strictly 1v1 First-Person Cyberpunk Duel (100 HP)\n&quot;
		.. &quot;• ARENA ROTATION: Switches across 5 Futuristic Arenas every 2 MINUTES (120s)\n&quot;
		.. &quot;• HP PERSISTENCE: Both players keep their exact HP during Arena Rotations\n&quot;
		.. &quot;• FULL ARSENAL: Assault Rifle [1], Sniper [2], Shotgun [3], SMG [4], Pistol [5]\n&quot;
		.. &quot;• WIN CONDITION: First player to reach 10 Kills wins (+150 Coins &amp; +200 XP)&quot;
	rulesText.Parent = infoBox

	-- Quick 1v1 Queue Button
	local queueBtnText = if InQueue then &quot;CANCEL 1VS1 MATCHMAKING QUEUE&quot; else &quot;FIND 1VS1 MULTIPLAYER MATCH&quot;
	local queueBtnColor = if InQueue then Color3.fromRGB(255, 50, 120) else Color3.fromRGB(0, 240, 255)

	makeCyberButton(
		RightModalContainer,
		queueBtnText,
		UDim2.new(1, -36, 0, 48),
		UDim2.fromOffset(18, 256),
		queueBtnColor,
		function()
			local qRemote = Remotes:FindFirstChild(&quot;QueueAction&quot;) :: RemoteEvent?
			if qRemote then
				InQueue = not InQueue
				qRemote:FireServer(if InQueue then &quot;JoinQueue&quot; else &quot;LeaveQueue&quot;)
				MainMenuUI.RenderPlay1v1Modal()
			end
		end
	)

	-- Instant 1v1 vs Cyber Bot (so solo testers can jump into a full 1v1 duel immediately!)
	makeCyberButton(
		RightModalContainer,
		&quot;INSTANT 1VS1 DUEL VS CYBER BOT [SOLO / PRACTICE]&quot;,
		UDim2.new(1, -36, 0, 46),
		UDim2.fromOffset(18, 316),
		Color3.fromRGB(215, 45, 255),
		function()
			local pRemote = Remotes:FindFirstChild(&quot;PracticeAction&quot;) :: RemoteEvent?
			if pRemote then
				pRemote:FireServer(10, 1, true)
			end
		end
	)

	-- Arena Preview Strip (All 5 Arenas)
	local arenaHeader = Instance.new(&quot;TextLabel&quot;)
	arenaHeader.Size = UDim2.new(1, -36, 0, 22)
	arenaHeader.Position = UDim2.fromOffset(18, 376)
	arenaHeader.BackgroundTransparency = 1
	arenaHeader.Font = Enum.Font.GothamBold
	arenaHeader.Text = &quot;5 ROTATING ARENAS (SWITCHES EVERY 02:00 / 120 SECONDS):&quot;
	arenaHeader.TextColor3 = Color3.fromRGB(0, 235, 255)
	arenaHeader.TextSize = 13
	arenaHeader.TextXAlignment = Enum.TextXAlignment.Left
	arenaHeader.Parent = RightModalContainer

	local listFrame = Instance.new(&quot;Frame&quot;)
	listFrame.Size = UDim2.new(1, -36, 0, 88)
	listFrame.Position = UDim2.fromOffset(18, 402)
	listFrame.BackgroundTransparency = 1
	listFrame.Parent = RightModalContainer

	local layout = Instance.new(&quot;UIGridLayout&quot;)
	layout.CellSize = UDim2.new(0.32, 0, 0, 38)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.Parent = listFrame

	for i, arena in ipairs(ArenaConfig.Arenas) do
		makeCyberButton(
			listFrame,
			tostring(i) .. &quot;. &quot; .. arena.Name,
			UDim2.fromOffset(100, 36),
			UDim2.new(),
			arena.PrimaryNeon,
			function()
				local pRemote = Remotes:FindFirstChild(&quot;PracticeAction&quot;) :: RemoteEvent?
				if pRemote then
					pRemote:FireServer(10, arena.Index, true)
				end
			end
		)
	end
end

-- ============================================================================
-- MODAL 2: FRIEND MATCH, PRIVATE ROOM &amp; TRAINING DUMMY
-- ============================================================================
function MainMenuUI.RenderFriendMatchModal()
	ActivePanelName = &quot;FriendMatch&quot;
	clearModal()
	if not RightModalContainer then
		return
	end

	makeModalHeader(
		&quot;FRIEND MATCH // PRIVATE &amp; PRACTICE&quot;,
		&quot;CHALLENGE SERVER FRIENDS, HOST PRIVATE CODES, OR TRAIN VS DUMMY&quot;
	)

	local selectedWinCondition = 10
	local selectedArenaIdx = 1

	-- Private Match Section
	local privLabel = Instance.new(&quot;TextLabel&quot;)
	privLabel.Size = UDim2.new(1, -36, 0, 22)
	privLabel.Position = UDim2.fromOffset(18, 80)
	privLabel.BackgroundTransparency = 1
	privLabel.Font = Enum.Font.GothamBold
	privLabel.Text = &quot;PRIVATE MATCH CONFIGURATION:&quot;
	privLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
	privLabel.TextSize = 14
	privLabel.TextXAlignment = Enum.TextXAlignment.Left
	privLabel.Parent = RightModalContainer

	local winBtn = nil :: TextButton?
	winBtn = makeCyberButton(
		RightModalContainer,
		&quot;WIN CONDITION: 10 KILLS (CLICK TO CYCLE)&quot;,
		UDim2.new(0.48, -22, 0, 38),
		UDim2.fromOffset(18, 106),
		Color3.fromRGB(0, 235, 255),
		function()
			local options = { 5, 10, 15, 20 }
			local nextIdx = 1
			for idx, v in ipairs(options) do
				if v == selectedWinCondition then
					nextIdx = (idx % #options) + 1
					break
				end
			end
			selectedWinCondition = options[nextIdx]
			if winBtn then
				winBtn.Text = &quot;WIN CONDITION: &quot; .. tostring(selectedWinCondition) .. &quot; KILLS&quot;
			end
		end
	)

	local arenaBtn = nil :: TextButton?
	arenaBtn = makeCyberButton(
		RightModalContainer,
		&quot;START ARENA: 1. CYBERCITY&quot;,
		UDim2.new(0.48, -22, 0, 38),
		UDim2.new(0.52, 4, 0, 106),
		Color3.fromRGB(195, 55, 255),
		function()
			selectedArenaIdx = (selectedArenaIdx % #ArenaConfig.Arenas) + 1
			local aDef = ArenaConfig.GetArenaByIndex(selectedArenaIdx)
			if arenaBtn then
				arenaBtn.Text = &quot;START ARENA: &quot; .. tostring(selectedArenaIdx) .. &quot;. &quot; .. string.sub(aDef.Name, 1, 12)
			end
		end
	)

	makeCyberButton(
		RightModalContainer,
		&quot;CREATE PRIVATE MATCH ROOM CODE&quot;,
		UDim2.new(0.48, -22, 0, 40),
		UDim2.fromOffset(18, 154),
		Color3.fromRGB(255, 45, 175),
		function()
			local fmRemote = Remotes:FindFirstChild(&quot;FriendMatchAction&quot;) :: RemoteEvent?
			if fmRemote then
				fmRemote:FireServer(&quot;CreatePrivateRoom&quot;, {
					WinCondition = selectedWinCondition,
					ArenaIndex = selectedArenaIdx,
				})
			end
		end
	)

	-- Room Code Input + Join Button
	local codeInput = Instance.new(&quot;TextBox&quot;)
	codeInput.Size = UDim2.new(0.24, -12, 0, 40)
	codeInput.Position = UDim2.new(0.52, 4, 0, 154)
	codeInput.BackgroundColor3 = Color3.fromRGB(14, 16, 28)
	codeInput.BorderSizePixel = 0
	codeInput.Font = Enum.Font.RobotoMono
	codeInput.PlaceholderText = &quot;CODE (NEON12)&quot;
	codeInput.Text = &quot;&quot;
	codeInput.TextColor3 = Color3.fromRGB(0, 245, 255)
	codeInput.TextSize = 14
	codeInput.Parent = RightModalContainer

	local inputStroke = Instance.new(&quot;UIStroke&quot;)
	inputStroke.Color = Color3.fromRGB(0, 240, 255)
	inputStroke.Thickness = 1.2
	inputStroke.Parent = codeInput

	makeCyberButton(
		RightModalContainer,
		&quot;JOIN CODE&quot;,
		UDim2.new(0.24, -14, 0, 40),
		UDim2.new(0.76, 2, 0, 154),
		Color3.fromRGB(0, 245, 200),
		function()
			local fmRemote = Remotes:FindFirstChild(&quot;FriendMatchAction&quot;) :: RemoteEvent?
			if fmRemote and #codeInput.Text &gt; 0 then
				fmRemote:FireServer(&quot;JoinPrivateRoom&quot;, { RoomCode = codeInput.Text })
			end
		end
	)

	-- Practice Mode vs Training Dummy Section
	local pracLabel = Instance.new(&quot;TextLabel&quot;)
	pracLabel.Size = UDim2.new(1, -36, 0, 22)
	pracLabel.Position = UDim2.fromOffset(18, 208)
	pracLabel.BackgroundTransparency = 1
	pracLabel.Font = Enum.Font.GothamBold
	pracLabel.Text = &quot;PRACTICE MODE (TRAINING DUMMY):&quot;
	pracLabel.TextColor3 = Color3.fromRGB(255, 55, 185)
	pracLabel.TextSize = 14
	pracLabel.TextXAlignment = Enum.TextXAlignment.Left
	pracLabel.Parent = RightModalContainer

	makeCyberButton(
		RightModalContainer,
		&quot;LAUNCH PRACTICE MODE (PASSIVE TARGET DUMMY)&quot;,
		UDim2.new(0.48, -22, 0, 42),
		UDim2.fromOffset(18, 234),
		Color3.fromRGB(0, 245, 200),
		function()
			local pRemote = Remotes:FindFirstChild(&quot;PracticeAction&quot;) :: RemoteEvent?
			if pRemote then
				pRemote:FireServer(selectedWinCondition, selectedArenaIdx, false)
			end
		end
	)

	makeCyberButton(
		RightModalContainer,
		&quot;LAUNCH SPARRING BOT (BOT SHOOTS BACK)&quot;,
		UDim2.new(0.48, -22, 0, 42),
		UDim2.new(0.52, 4, 0, 234),
		Color3.fromRGB(215, 50, 255),
		function()
			local pRemote = Remotes:FindFirstChild(&quot;PracticeAction&quot;) :: RemoteEvent?
			if pRemote then
				pRemote:FireServer(selectedWinCondition, selectedArenaIdx, true)
			end
		end
	)

	-- Online Players / Friends List to Challenge
	local friendHdr = Instance.new(&quot;TextLabel&quot;)
	friendHdr.Size = UDim2.new(1, -36, 0, 22)
	friendHdr.Position = UDim2.fromOffset(18, 290)
	friendHdr.BackgroundTransparency = 1
	friendHdr.Font = Enum.Font.GothamBold
	friendHdr.Text = &quot;ONLINE PLAYERS IN SERVER (CLICK TO CHALLENGE 1VS1):&quot;
	friendHdr.TextColor3 = Color3.fromRGB(0, 235, 255)
	friendHdr.TextSize = 14
	friendHdr.TextXAlignment = Enum.TextXAlignment.Left
	friendHdr.Parent = RightModalContainer

	local scroll = Instance.new(&quot;ScrollingFrame&quot;)
	scroll.Size = UDim2.new(1, -36, 0, 175)
	scroll.Position = UDim2.fromOffset(18, 316)
	scroll.BackgroundColor3 = Color3.fromRGB(12, 14, 24)
	scroll.BackgroundTransparency = 0.3
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.Parent = RightModalContainer

	local listLayout = Instance.new(&quot;UIListLayout&quot;)
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = scroll

	local otherPlayersCount = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			otherPlayersCount += 1
			makeCyberButton(
				scroll,
				&quot;CHALLENGE &quot; .. string.upper(plr.Name) .. &quot; TO 1VS1 DUEL&quot;,
				UDim2.new(1, -10, 0, 38),
				UDim2.new(),
				Color3.fromRGB(0, 235, 255),
				function()
					local fmRemote = Remotes:FindFirstChild(&quot;FriendMatchAction&quot;) :: RemoteEvent?
					if fmRemote then
						fmRemote:FireServer(&quot;ChallengePlayer&quot;, { TargetName = plr.Name })
					end
				end
			)
		end
	end

	if otherPlayersCount == 0 then
		local emptyLbl = Instance.new(&quot;TextLabel&quot;)
		emptyLbl.Size = UDim2.new(1, -16, 0, 48)
		emptyLbl.BackgroundTransparency = 1
		emptyLbl.Font = Enum.Font.RobotoMono
		emptyLbl.Text = &quot;No other human players in this server instance yet. Invite a friend or click &apos;LAUNCH SPARRING BOT&apos; above!&quot;
		emptyLbl.TextColor3 = Color3.fromRGB(170, 185, 215)
		emptyLbl.TextSize = 13
		emptyLbl.TextWrapped = true
		emptyLbl.Parent = scroll
	end
end

-- ============================================================================
-- MODAL 3: SHOP (Weapon Skins &amp; Character Skins)
-- ============================================================================
local currentShopTab: &quot;WeaponSkin&quot; | &quot;CharacterSkin&quot; = &quot;WeaponSkin&quot;

function MainMenuUI.RenderShopModal()
	ActivePanelName = &quot;Shop&quot;
	clearModal()
	if not RightModalContainer then
		return
	end

	makeModalHeader(
		&quot;CYBER ARMORY &amp; SKIN SHOP&quot;,
		&quot;COINS BALANCE: &quot; .. tostring(CurrentProfile.Coins or 0) .. &quot; CR // CUSTOMIZE WEAPONS &amp; EXOSUITS&quot;
	)

	-- Tab Buttons
	makeCyberButton(
		RightModalContainer,
		&quot;WEAPON SKINS (&quot; .. tostring(#ShopConfig.WeaponSkins) .. &quot;)&quot;,
		UDim2.new(0.48, -22, 0, 38),
		UDim2.fromOffset(18, 82),
		if currentShopTab == &quot;WeaponSkin&quot; then Color3.fromRGB(0, 245, 255) else Color3.fromRGB(90, 100, 135),
		function()
			currentShopTab = &quot;WeaponSkin&quot;
			MainMenuUI.RenderShopModal()
		end
	)

	makeCyberButton(
		RightModalContainer,
		&quot;CHARACTER SKINS (&quot; .. tostring(#ShopConfig.CharacterSkins) .. &quot;)&quot;,
		UDim2.new(0.48, -22, 0, 38),
		UDim2.new(0.52, 4, 0, 82),
		if currentShopTab == &quot;CharacterSkin&quot; then Color3.fromRGB(225, 50, 255) else Color3.fromRGB(90, 100, 135),
		function()
			currentShopTab = &quot;CharacterSkin&quot;
			MainMenuUI.RenderShopModal()
		end
	)

	local gridScroll = Instance.new(&quot;ScrollingFrame&quot;)
	gridScroll.Size = UDim2.new(1, -36, 0, 365)
	gridScroll.Position = UDim2.fromOffset(18, 130)
	gridScroll.BackgroundTransparency = 1
	gridScroll.BorderSizePixel = 0
	gridScroll.ScrollBarThickness = 5
	gridScroll.CanvasSize = UDim2.fromOffset(0, 420)
	gridScroll.Parent = RightModalContainer

	local grid = Instance.new(&quot;UIGridLayout&quot;)
	grid.CellSize = UDim2.new(0.48, 0, 0, 112)
	grid.CellPadding = UDim2.fromOffset(12, 12)
	grid.Parent = gridScroll

	local items = if currentShopTab == &quot;WeaponSkin&quot;
		then ShopConfig.WeaponSkins
		else ShopConfig.CharacterSkins
	local ownedMap = if currentShopTab == &quot;WeaponSkin&quot;
		then (CurrentProfile.OwnedWeaponSkins or {})
		else (CurrentProfile.OwnedCharacterSkins or {})
	local equippedId = if currentShopTab == &quot;WeaponSkin&quot;
		then CurrentProfile.EquippedWeaponSkin
		else CurrentProfile.EquippedCharacterSkin

	for _, item in ipairs(items) do
		local card = Instance.new(&quot;Frame&quot;)
		card.BackgroundColor3 = Color3.fromRGB(16, 18, 32)
		card.BackgroundTransparency = 0.15
		card.BorderSizePixel = 0
		card.Parent = gridScroll

		local cardCorner = Instance.new(&quot;UICorner&quot;)
		cardCorner.CornerRadius = UDim.new(0, 6)
		cardCorner.Parent = card

		local cardStroke = Instance.new(&quot;UIStroke&quot;)
		cardStroke.Color = item.PrimaryNeon
		cardStroke.Thickness = if equippedId == item.Id then 2.4 else 1.2
		cardStroke.Parent = card

		-- Neon Color Swatch Preview Bar
		local swatch = Instance.new(&quot;Frame&quot;)
		swatch.Size = UDim2.new(0, 8, 1, -16)
		swatch.Position = UDim2.fromOffset(8, 8)
		swatch.BackgroundColor3 = item.PrimaryNeon
		swatch.BorderSizePixel = 0
		swatch.Parent = card

		local nameLbl = Instance.new(&quot;TextLabel&quot;)
		nameLbl.Size = UDim2.new(1, -28, 0, 22)
		nameLbl.Position = UDim2.fromOffset(22, 6)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.Text = item.Name
		nameLbl.TextColor3 = item.PrimaryNeon
		nameLbl.TextSize = 14
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.Parent = card

		local rarityLbl = Instance.new(&quot;TextLabel&quot;)
		rarityLbl.Size = UDim2.new(1, -28, 0, 16)
		rarityLbl.Position = UDim2.fromOffset(22, 26)
		rarityLbl.BackgroundTransparency = 1
		rarityLbl.Font = Enum.Font.RobotoMono
		rarityLbl.Text = string.upper(item.Rarity) .. &quot; // &quot; .. item.Description
		rarityLbl.TextColor3 = Color3.fromRGB(185, 195, 220)
		rarityLbl.TextSize = 11
		rarityLbl.TextTruncate = Enum.TextTruncate.AtEnd
		rarityLbl.TextXAlignment = Enum.TextXAlignment.Left
		rarityLbl.Parent = card

		local isOwned = (ownedMap[item.Id] == true)
		local isEquipped = (equippedId == item.Id)

		local btnText = if isEquipped
			then &quot;EQUIPPED&quot;
			elseif isOwned then &quot;EQUIP SKIN&quot;
			else (&quot;BUY — &quot; .. tostring(item.Price) .. &quot; COINS&quot;)
		local btnAccent = if isEquipped
			then Color3.fromRGB(0, 255, 180)
			elseif isOwned then Color3.fromRGB(0, 225, 255)
			else Color3.fromRGB(255, 50, 180)

		makeCyberButton(
			card,
			btnText,
			UDim2.new(1, -30, 0, 34),
			UDim2.fromOffset(22, 68),
			btnAccent,
			function()
				local shopFunc = Remotes:FindFirstChild(&quot;ShopAction&quot;) :: RemoteFunction?
				if shopFunc then
					local action = if isOwned then &quot;Equip&quot; else &quot;Buy&quot;
					local ok, msg = shopFunc:InvokeServer(action, currentShopTab, item.Id)
					if StatusBannerLabel and type(msg) == &quot;string&quot; then
						StatusBannerLabel.Text = string.upper(msg)
						StatusBannerLabel.TextColor3 = if ok
							then Color3.fromRGB(0, 255, 190)
							else Color3.fromRGB(255, 70, 110)
					end
					MainMenuUI.RenderShopModal()
				end
			end
		)
	end
end

-- ============================================================================
-- MODAL 4: PLAYER PROFILE, STATISTICS &amp; LEADERBOARD
-- ============================================================================
function MainMenuUI.RenderProfileModal()
	ActivePanelName = &quot;Profile&quot;
	clearModal()
	if not RightModalContainer then
		return
	end

	local lvl = CurrentProfile.Level or 1
	local xp = CurrentProfile.XP or 0
	local reqXP = ShopConfig.GetXPRequiredForLevel(lvl)
	local wins = CurrentProfile.Wins or 0
	local losses = CurrentProfile.Losses or 0
	local kills = CurrentProfile.Kills or 0
	local deaths = CurrentProfile.Deaths or 0
	local totalMatches = wins + losses
	local winRate = if totalMatches &gt; 0 then math.floor((wins / totalMatches) * 100) else 0
	local kdRatio = if deaths &gt; 0 then string.format(&quot;%.2f&quot;, kills / deaths) else tostring(kills)

	makeModalHeader(
		&quot;OPERATIVE PROFILE // &quot; .. string.upper(LocalPlayer.Name),
		&quot;LEVEL &quot; .. tostring(lvl) .. &quot; (&quot; .. tostring(xp) .. &quot;/&quot; .. tostring(reqXP) .. &quot; XP) // COINS: &quot; .. tostring(CurrentProfile.Coins or 0)
	)

	-- XP Progress Bar
	local xpBarBg = Instance.new(&quot;Frame&quot;)
	xpBarBg.Size = UDim2.new(1, -36, 0, 12)
	xpBarBg.Position = UDim2.fromOffset(18, 80)
	xpBarBg.BackgroundColor3 = Color3.fromRGB(16, 20, 34)
	xpBarBg.BorderSizePixel = 0
	xpBarBg.Parent = RightModalContainer

	local xpFill = Instance.new(&quot;Frame&quot;)
	xpFill.Size = UDim2.fromScale(math.clamp(xp / math.max(1, reqXP), 0, 1), 1)
	xpFill.BackgroundColor3 = Color3.fromRGB(0, 240, 255)
	xpFill.BorderSizePixel = 0
	xpFill.Parent = xpBarBg

	-- 6 Stat Cards Grid
	local statsContainer = Instance.new(&quot;Frame&quot;)
	statsContainer.Size = UDim2.new(1, -36, 0, 130)
	statsContainer.Position = UDim2.fromOffset(18, 102)
	statsContainer.BackgroundTransparency = 1
	statsContainer.Parent = RightModalContainer

	local statGrid = Instance.new(&quot;UIGridLayout&quot;)
	statGrid.CellSize = UDim2.new(0.31, 0, 0, 58)
	statGrid.CellPadding = UDim2.fromOffset(10, 10)
	statGrid.Parent = statsContainer

	local statItems = {
		{ Label = &quot;WINS&quot;, Value = tostring(wins), Color = Color3.fromRGB(0, 255, 190) },
		{ Label = &quot;LOSSES&quot;, Value = tostring(losses), Color = Color3.fromRGB(255, 65, 135) },
		{ Label = &quot;WIN RATE&quot;, Value = tostring(winRate) .. &quot;%&quot;, Color = Color3.fromRGB(0, 235, 255) },
		{ Label = &quot;TOTAL KILLS&quot;, Value = tostring(kills), Color = Color3.fromRGB(210, 65, 255) },
		{ Label = &quot;K/D RATIO&quot;, Value = kdRatio, Color = Color3.fromRGB(255, 210, 60) },
		{ Label = &quot;WIN STREAK&quot;, Value = tostring(CurrentProfile.WinStreak or 0), Color = Color3.fromRGB(0, 240, 255) },
	}

	for _, st in ipairs(statItems) do
		local box = Instance.new(&quot;Frame&quot;)
		box.BackgroundColor3 = Color3.fromRGB(15, 18, 32)
		box.BorderSizePixel = 0
		box.Parent = statsContainer

		local stroke = Instance.new(&quot;UIStroke&quot;)
		stroke.Color = st.Color
		stroke.Thickness = 1.2
		stroke.Transparency = 0.35
		stroke.Parent = box

		local valLbl = Instance.new(&quot;TextLabel&quot;)
		valLbl.Size = UDim2.new(1, 0, 0, 32)
		valLbl.Position = UDim2.fromOffset(0, 4)
		valLbl.BackgroundTransparency = 1
		valLbl.Font = Enum.Font.Michroma
		valLbl.Text = st.Value
		valLbl.TextColor3 = st.Color
		valLbl.TextSize = 19
		valLbl.Parent = box

		local capLbl = Instance.new(&quot;TextLabel&quot;)
		capLbl.Size = UDim2.new(1, 0, 0, 18)
		capLbl.Position = UDim2.fromOffset(0, 36)
		capLbl.BackgroundTransparency = 1
		capLbl.Font = Enum.Font.RobotoMono
		capLbl.Text = st.Label
		capLbl.TextColor3 = Color3.fromRGB(180, 195, 220)
		capLbl.TextSize = 11
		capLbl.Parent = box
	end

	-- Global &amp; Server Leaderboard
	local lbHeader = Instance.new(&quot;TextLabel&quot;)
	lbHeader.Size = UDim2.new(1, -36, 0, 24)
	lbHeader.Position = UDim2.fromOffset(18, 242)
	lbHeader.BackgroundTransparency = 1
	lbHeader.Font = Enum.Font.GothamBold
	lbHeader.Text = &quot;TOP CYBERCITY DUELISTS LEADERBOARD:&quot;
	lbHeader.TextColor3 = Color3.fromRGB(0, 240, 255)
	lbHeader.TextSize = 14
	lbHeader.TextXAlignment = Enum.TextXAlignment.Left
	lbHeader.Parent = RightModalContainer

	local lbList = Instance.new(&quot;ScrollingFrame&quot;)
	lbList.Size = UDim2.new(1, -36, 0, 225)
	lbList.Position = UDim2.fromOffset(18, 270)
	lbList.BackgroundColor3 = Color3.fromRGB(12, 14, 26)
	lbList.BackgroundTransparency = 0.25
	lbList.BorderSizePixel = 0
	lbList.ScrollBarThickness = 4
	lbList.Parent = RightModalContainer

	local lbLayout = Instance.new(&quot;UIListLayout&quot;)
	lbLayout.Padding = UDim.new(0, 4)
	lbLayout.Parent = lbList

	for rank, entry in ipairs(CurrentLeaderboard) do
		local row = Instance.new(&quot;Frame&quot;)
		row.Size = UDim2.new(1, -8, 0, 34)
		row.BackgroundColor3 = if entry.Name == LocalPlayer.Name
			then Color3.fromRGB(48, 24, 72)
			else Color3.fromRGB(18, 22, 36)
		row.BorderSizePixel = 0
		row.Parent = lbList

		local rowText = Instance.new(&quot;TextLabel&quot;)
		rowText.Size = UDim2.new(1, -20, 1, 0)
		rowText.Position = UDim2.fromOffset(10, 0)
		rowText.BackgroundTransparency = 1
		rowText.Font = Enum.Font.RobotoMono
		rowText.Text = string.format(
			&quot;#%02d   %-18s   WINS: %-4d   LVL: %d&quot;,
			rank,
			entry.Name,
			entry.Wins,
			entry.Level
		)
		rowText.TextColor3 = if rank == 1
			then Color3.fromRGB(255, 215, 55)
			elseif rank &lt;= 3 then Color3.fromRGB(0, 240, 255)
			else Color3.fromRGB(215, 225, 245)
		rowText.TextSize = 13
		rowText.TextXAlignment = Enum.TextXAlignment.Left
		rowText.Parent = row
	end
end

-- ============================================================================
-- MODAL 5: SETTINGS
-- ============================================================================
function MainMenuUI.RenderSettingsModal()
	ActivePanelName = &quot;Settings&quot;
	clearModal()
	if not RightModalContainer then
		return
	end

	makeModalHeader(
		&quot;SYSTEM SETTINGS // NEON DUEL 2.0&quot;,
		&quot;CONFIGURE CAMERA FOV, AIM SENSITIVITY, AUDIO &amp; CYBERPUNK POST-FX&quot;
	)

	local settings = CurrentProfile.Settings

	local function createSettingRow(
		index: number,
		label: string,
		valueText: string,
		onDecrease: () -&gt; (),
		onIncrease: () -&gt; ()
	)
		local yPos = 86 + (index - 1) * 64
		local row = Instance.new(&quot;Frame&quot;)
		row.Size = UDim2.new(1, -36, 0, 52)
		row.Position = UDim2.fromOffset(18, yPos)
		row.BackgroundColor3 = Color3.fromRGB(15, 18, 32)
		row.BorderSizePixel = 0
		row.Parent = RightModalContainer

		local lbl = Instance.new(&quot;TextLabel&quot;)
		lbl.Size = UDim2.new(0.55, 0, 1, 0)
		lbl.Position = UDim2.fromOffset(14, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.Text = label
		lbl.TextColor3 = Color3.fromRGB(220, 235, 255)
		lbl.TextSize = 14
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = row

		makeCyberButton(
			row,
			&quot;-&quot;,
			UDim2.fromOffset(42, 36),
			UDim2.new(0.58, 0, 0, 8),
			Color3.fromRGB(195, 55, 255),
			onDecrease
		)

		local valLbl = Instance.new(&quot;TextLabel&quot;)
		valLbl.Size = UDim2.new(0.18, 0, 1, 0)
		valLbl.Position = UDim2.new(0.68, 0, 0, 0)
		valLbl.BackgroundTransparency = 1
		valLbl.Font = Enum.Font.Michroma
		valLbl.Text = valueText
		valLbl.TextColor3 = Color3.fromRGB(0, 240, 255)
		valLbl.TextSize = 15
		valLbl.Parent = row

		makeCyberButton(
			row,
			&quot;+&quot;,
			UDim2.fromOffset(42, 36),
			UDim2.new(0.88, 0, 0, 8),
			Color3.fromRGB(0, 240, 255),
			onIncrease
		)
	end

	local function pushSettingsUpdate()
		SoundManager.SetVolumes(settings.SfxVolume, settings.MusicVolume)
		if MainMenuUI.OnSettingsChanged then
			MainMenuUI.OnSettingsChanged(settings)
		end
		local sRemote = Remotes:FindFirstChild(&quot;UpdateSettings&quot;) :: RemoteEvent?
		if sRemote then
			sRemote:FireServer(settings)
		end
		MainMenuUI.RenderSettingsModal()
	end

	createSettingRow(1, &quot;CAMERA FIELD OF VIEW (FOV)&quot;, tostring(settings.FOV) .. &quot;°&quot;, function()
		settings.FOV = math.clamp(settings.FOV - 4, 65, 105)
		pushSettingsUpdate()
	end, function()
		settings.FOV = math.clamp(settings.FOV + 4, 65, 105)
		pushSettingsUpdate()
	end)

	createSettingRow(2, &quot;LOOK SENSITIVITY&quot;, string.format(&quot;%.2f&quot;, settings.Sensitivity), function()
		settings.Sensitivity = math.clamp(math.floor((settings.Sensitivity - 0.1) * 100 + 0.5) / 100, 0.1, 2.0)
		pushSettingsUpdate()
	end, function()
		settings.Sensitivity = math.clamp(math.floor((settings.Sensitivity + 0.1) * 100 + 0.5) / 100, 0.1, 2.0)
		pushSettingsUpdate()
	end)

	createSettingRow(3, &quot;ADS AIM SENSITIVITY&quot;, string.format(&quot;%.2f&quot;, settings.AimSensitivity), function()
		settings.AimSensitivity = math.clamp(math.floor((settings.AimSensitivity - 0.05) * 100 + 0.5) / 100, 0.1, 1.5)
		pushSettingsUpdate()
	end, function()
		settings.AimSensitivity = math.clamp(math.floor((settings.AimSensitivity + 0.05) * 100 + 0.5) / 100, 0.1, 1.5)
		pushSettingsUpdate()
	end)

	createSettingRow(4, &quot;SFX AUDIO VOLUME&quot;, tostring(math.floor(settings.SfxVolume * 100 + 0.5)) .. &quot;%&quot;, function()
		settings.SfxVolume = math.clamp(settings.SfxVolume - 0.1, 0, 1)
		pushSettingsUpdate()
	end, function()
		settings.SfxVolume = math.clamp(settings.SfxVolume + 0.1, 0, 1)
		pushSettingsUpdate()
	end)

	createSettingRow(5, &quot;NEON BLOOM GRAPHICS&quot;, if settings.HighQualityNeon then &quot;ULTRA&quot; else &quot;LOW&quot;, function()
		settings.HighQualityNeon = not settings.HighQualityNeon
		pushSettingsUpdate()
	end, function()
		settings.HighQualityNeon = not settings.HighQualityNeon
		pushSettingsUpdate()
	end)
end

-- ============================================================================
-- MAIN MENU CREATION (IMAGE 1 &quot;CYBERCITY EDITION 2.0&quot; ARCHITECTURE)
-- ============================================================================
function MainMenuUI.Init()
	local existing = PlayerGui:FindFirstChild(&quot;NeonDuelMainMenu&quot;)
	if existing then
		existing:Destroy()
	end

	local gui = Instance.new(&quot;ScreenGui&quot;)
	gui.Name = &quot;NeonDuelMainMenu&quot;
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = PlayerGui
	MenuGui = gui

	-- 1. Left Translucent Dark Glass Sidebar Panel (Matches Image 1)
	local leftSidebar = Instance.new(&quot;Frame&quot;)
	leftSidebar.Name = &quot;CyberLeftSidebar&quot;
	leftSidebar.Size = UDim2.fromScale(0.31, 1.0)
	leftSidebar.Position = UDim2.fromScale(0.055, 0)
	leftSidebar.BackgroundColor3 = Color3.fromRGB(16, 12, 34)
	leftSidebar.BackgroundTransparency = 0.30
	leftSidebar.BorderSizePixel = 0
	leftSidebar.Parent = gui

	-- Subtle vertical edge lines on the frosted sidebar (like Image 1)
	local leftEdge = Instance.new(&quot;Frame&quot;)
	leftEdge.Size = UDim2.new(0, 1, 1, 0)
	leftEdge.BackgroundColor3 = Color3.fromRGB(120, 80, 200)
	leftEdge.BackgroundTransparency = 0.65
	leftEdge.BorderSizePixel = 0
	leftEdge.Parent = leftSidebar

	local rightEdge = Instance.new(&quot;Frame&quot;)
	rightEdge.Size = UDim2.new(0, 1, 1, 0)
	rightEdge.Position = UDim2.fromScale(1, 0)
	rightEdge.BackgroundColor3 = Color3.fromRGB(0, 225, 255)
	rightEdge.BackgroundTransparency = 0.65
	rightEdge.BorderSizePixel = 0
	rightEdge.Parent = leftSidebar

	-- 2. Top-Left &quot;NEON DUEL&quot; + &quot;Edition 2.0&quot; Logo (Styled like Image 1 &quot;CYBERCITY Edition 2.0&quot;)
	local logoContainer = Instance.new(&quot;Frame&quot;)
	logoContainer.Name = &quot;LogoContainer&quot;
	logoContainer.Size = UDim2.new(0.88, 0, 0, 115)
	logoContainer.Position = UDim2.new(0.06, 0, 0.08, 0)
	logoContainer.BackgroundTransparency = 1
	logoContainer.Parent = leftSidebar

	-- Glow Shadow Behind Title
	local logoGlow = Instance.new(&quot;TextLabel&quot;)
	logoGlow.Size = UDim2.new(1, 0, 0, 56)
	logoGlow.Position = UDim2.fromOffset(2, 3)
	logoGlow.BackgroundTransparency = 1
	logoGlow.Font = Enum.Font.Michroma
	logoGlow.Text = &quot;NEON DUEL&quot;
	logoGlow.TextColor3 = Color3.fromRGB(255, 25, 175)
	logoGlow.TextTransparency = 0.25
	logoGlow.TextScaled = true
	logoGlow.TextXAlignment = Enum.TextXAlignment.Left
	logoGlow.Parent = logoContainer

	-- Main Metallic Cyan/Magenta Gradient Title
	local logoMain = Instance.new(&quot;TextLabel&quot;)
	logoMain.Size = UDim2.new(1, 0, 0, 56)
	logoMain.BackgroundTransparency = 1
	logoMain.Font = Enum.Font.Michroma
	logoMain.Text = &quot;NEON DUEL&quot;
	logoMain.TextColor3 = Color3.fromRGB(255, 255, 255)
	logoMain.TextScaled = true
	logoMain.TextXAlignment = Enum.TextXAlignment.Left
	logoMain.Parent = logoContainer

	local titleGradient = Instance.new(&quot;UIGradient&quot;)
	titleGradient.Rotation = 90
	titleGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, Color3.fromRGB(0, 255, 245)),
		ColorSequenceKeypoint.new(0.46, Color3.fromRGB(190, 255, 255)),
		ColorSequenceKeypoint.new(0.52, Color3.fromRGB(28, 12, 48)),
		ColorSequenceKeypoint.new(0.62, Color3.fromRGB(255, 45, 190)),
		ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 185, 245)),
	})
	titleGradient.Parent = logoMain

	-- Cursive/Slanted &quot;Edition 2.0&quot; Subtitle overlapping bottom-right of logo (like Image 1)
	local editionLabel = Instance.new(&quot;TextLabel&quot;)
	editionLabel.Name = &quot;Edition2Label&quot;
	editionLabel.Size = UDim2.new(0.75, 0, 0, 36)
	editionLabel.Position = UDim2.new(0.22, 0, 0, 44)
	editionLabel.Rotation = -7
	editionLabel.BackgroundTransparency = 1
	editionLabel.Font = Enum.Font.GothamMedium
	editionLabel.RichText = true
	editionLabel.Text = &quot;&lt;i&gt;Edition 2.0&lt;/i&gt;&quot;
	editionLabel.TextColor3 = Color3.fromRGB(250, 235, 255)
	editionLabel.TextSize = 27
	editionLabel.TextStrokeColor3 = Color3.fromRGB(255, 40, 185)
	editionLabel.TextStrokeTransparency = 0.25
	editionLabel.TextXAlignment = Enum.TextXAlignment.Left
	editionLabel.Parent = logoContainer

	-- Mini Profile Status Bar under logo
	local profileSummary = Instance.new(&quot;TextLabel&quot;)
	profileSummary.Size = UDim2.new(0.88, 0, 0, 22)
	profileSummary.Position = UDim2.new(0.06, 0, 0.23, 0)
	profileSummary.BackgroundTransparency = 1
	profileSummary.Font = Enum.Font.RobotoMono
	profileSummary.Text = &quot;LVL 1 // 350 COINS // 0W - 0L&quot;
	profileSummary.TextColor3 = Color3.fromRGB(165, 225, 255)
	profileSummary.TextSize = 13
	profileSummary.TextXAlignment = Enum.TextXAlignment.Left
	profileSummary.Parent = leftSidebar
	TopProfileBadge = profileSummary

	-- 3. Left-Aligned Vertical Menu Items (Styled like Image 1 &quot;Continue / Load game / New game / Settings / Quit game&quot;)
	local menuItems = {
		{ Name = &quot;PLAY 1VS1&quot;, OpenPanel = MainMenuUI.RenderPlay1v1Modal },
		{ Name = &quot;FRIEND MATCH&quot;, OpenPanel = MainMenuUI.RenderFriendMatchModal },
		{ Name = &quot;SHOP&quot;, OpenPanel = MainMenuUI.RenderShopModal },
		{ Name = &quot;PLAYER PROFILE&quot;, OpenPanel = MainMenuUI.RenderProfileModal },
		{ Name = &quot;SETTINGS&quot;, OpenPanel = MainMenuUI.RenderSettingsModal },
	}

	local menuListFrame = Instance.new(&quot;Frame&quot;)
	menuListFrame.Name = &quot;MenuButtonsList&quot;
	menuListFrame.Size = UDim2.new(0.86, 0, 0, 340)
	menuListFrame.Position = UDim2.new(0.07, 0, 0.29, 0)
	menuListFrame.BackgroundTransparency = 1
	menuListFrame.Parent = leftSidebar

	local buttonRefs: { { Button: TextButton, Brackets: Frame } } = {}

	local function updateMenuSelection(newIndex: number)
		SelectedMenuIndex = math.clamp(newIndex, 1, #menuItems)
		for idx, ref in ipairs(buttonRefs) do
			local isSelected = (idx == SelectedMenuIndex)
			ref.Brackets.Visible = isSelected
			TweenService:Create(ref.Button, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {
				BackgroundTransparency = if isSelected then 0.32 else 1.0,
				BackgroundColor3 = if isSelected
					then Color3.fromRGB(122, 42, 148)
					else Color3.fromRGB(20, 12, 34),
				TextColor3 = if isSelected
					then Color3.fromRGB(250, 245, 255)
					else Color3.fromRGB(115, 245, 255),
			}):Play()
		end
	end

	for i, item in ipairs(menuItems) do
		local btn = Instance.new(&quot;TextButton&quot;)
		btn.Name = &quot;MenuBtn_&quot; .. tostring(i)
		btn.Size = UDim2.new(1, 0, 0, 52)
		btn.Position = UDim2.fromOffset(0, (i - 1) * 64)
		btn.BackgroundColor3 = Color3.fromRGB(122, 42, 148)
		btn.BackgroundTransparency = if i == 1 then 0.32 else 1.0
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Font = Enum.Font.RobotoMono
		btn.Text = &quot;  &quot; .. item.Name
		btn.TextColor3 = if i == 1 then Color3.fromRGB(250, 245, 255) else Color3.fromRGB(115, 245, 255)
		btn.TextSize = 22
		btn.TextStrokeColor3 = Color3.fromRGB(0, 185, 255)
		btn.TextStrokeTransparency = 0.65
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = menuListFrame

		local brackets = createCornerBrackets(btn)
		brackets.Visible = (i == 1)

		table.insert(buttonRefs, {
			Button = btn,
			Brackets = brackets,
		})

		btn.MouseEnter:Connect(function()
			SoundManager.Play2D(&quot;UIHover&quot;)
			updateMenuSelection(i)
		end)

		btn.MouseButton1Click:Connect(function()
			SoundManager.Play2D(&quot;UIClick&quot;)
			updateMenuSelection(i)
			item.OpenPanel()
		end)
	end

	-- Status Banner at Bottom of Left Sidebar
	local statusLabel = Instance.new(&quot;TextLabel&quot;)
	statusLabel.Size = UDim2.new(0.86, 0, 0, 42)
	statusLabel.Position = UDim2.new(0.07, 0, 0.88, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.RobotoMono
	statusLabel.Text = &quot;READY // SELECT A MODE TO DEPLOY&quot;
	statusLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
	statusLabel.TextSize = 13
	statusLabel.TextWrapped = true
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.Parent = leftSidebar
	StatusBannerLabel = statusLabel

	-- 4. Right Interactive Sub-Panel Container (Translucent Cyber Glass Frame)
	local rightModal = Instance.new(&quot;Frame&quot;)
	rightModal.Name = &quot;RightSubPanel&quot;
	rightModal.Size = UDim2.fromScale(0.54, 0.72)
	rightModal.Position = UDim2.fromScale(0.41, 0.13)
	rightModal.BackgroundColor3 = Color3.fromRGB(12, 10, 26)
	rightModal.BackgroundTransparency = 0.22
	rightModal.BorderSizePixel = 0
	rightModal.Parent = gui
	RightModalContainer = rightModal

	local modalCorner = Instance.new(&quot;UICorner&quot;)
	modalCorner.CornerRadius = UDim.new(0, 8)
	modalCorner.Parent = rightModal

	local modalStroke = Instance.new(&quot;UIStroke&quot;)
	modalStroke.Color = Color3.fromRGB(0, 230, 255)
	modalStroke.Thickness = 1.5
	modalStroke.Transparency = 0.25
	modalStroke.Parent = rightModal

	-- 5. Bottom-Right Controller/Keyboard Navigation Prompt (Matches Image 1: &quot;+ NAVIGATE   (X) SELECT&quot;)
	local navLegend = Instance.new(&quot;Frame&quot;)
	navLegend.Name = &quot;BottomRightNavLegend&quot;
	navLegend.Size = UDim2.fromOffset(270, 38)
	navLegend.Position = UDim2.new(1, -295, 1, -52)
	navLegend.BackgroundTransparency = 1
	navLegend.Parent = gui

	local dpadIcon = Instance.new(&quot;TextLabel&quot;)
	dpadIcon.Size = UDim2.fromOffset(28, 28)
	dpadIcon.Position = UDim2.fromOffset(0, 5)
	dpadIcon.BackgroundColor3 = Color3.fromRGB(240, 248, 255)
	dpadIcon.BackgroundTransparency = 0.85
	dpadIcon.Font = Enum.Font.GothamBlack
	dpadIcon.Text = &quot;┼&quot;
	dpadIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
	dpadIcon.TextSize = 20
	dpadIcon.Parent = navLegend

	local navText = Instance.new(&quot;TextLabel&quot;)
	navText.Size = UDim2.fromOffset(90, 28)
	navText.Position = UDim2.fromOffset(36, 5)
	navText.BackgroundTransparency = 1
	navText.Font = Enum.Font.GothamBold
	navText.Text = &quot;NAVIGATE&quot;
	navText.TextColor3 = Color3.fromRGB(240, 245, 255)
	navText.TextSize = 13
	navText.TextXAlignment = Enum.TextXAlignment.Left
	navText.Parent = navLegend

	local selectCircle = Instance.new(&quot;TextLabel&quot;)
	selectCircle.Size = UDim2.fromOffset(26, 26)
	selectCircle.Position = UDim2.fromOffset(145, 6)
	selectCircle.BackgroundColor3 = Color3.fromRGB(220, 240, 255)
	selectCircle.Font = Enum.Font.GothamBlack
	selectCircle.Text = &quot;✕&quot;
	selectCircle.TextColor3 = Color3.fromRGB(16, 18, 30)
	selectCircle.TextSize = 14
	selectCircle.Parent = navLegend

	local selCorner = Instance.new(&quot;UICorner&quot;)
	selCorner.CornerRadius = UDim.new(1, 0)
	selCorner.Parent = selectCircle

	local selText = Instance.new(&quot;TextLabel&quot;)
	selText.Size = UDim2.fromOffset(80, 28)
	selText.Position = UDim2.fromOffset(180, 5)
	selText.BackgroundTransparency = 1
	selText.Font = Enum.Font.GothamBold
	selText.Text = &quot;SELECT&quot;
	selText.TextColor3 = Color3.fromRGB(240, 245, 255)
	selText.TextSize = 13
	selText.TextXAlignment = Enum.TextXAlignment.Left
	selText.Parent = navLegend

	-- Keyboard Up/Down/Enter Navigation Support
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not gui.Enabled then
			return
		end
		if input.KeyCode == Enum.KeyCode.Down or input.KeyCode == Enum.KeyCode.S then
			SoundManager.Play2D(&quot;UIHover&quot;)
			local nextIdx = (SelectedMenuIndex % #menuItems) + 1
			updateMenuSelection(nextIdx)
			menuItems[nextIdx].OpenPanel()
		elseif input.KeyCode == Enum.KeyCode.Up or input.KeyCode == Enum.KeyCode.W then
			SoundManager.Play2D(&quot;UIHover&quot;)
			local prevIdx = ((SelectedMenuIndex - 2) % #menuItems) + 1
			updateMenuSelection(prevIdx)
			menuItems[prevIdx].OpenPanel()
		elseif input.KeyCode == Enum.KeyCode.Return then
			SoundManager.Play2D(&quot;UIClick&quot;)
			menuItems[SelectedMenuIndex].OpenPanel()
		end
	end)

	-- Render initial panel
	MainMenuUI.RenderPlay1v1Modal()
end

function MainMenuUI.SetVisible(visible: boolean)
	if MenuGui then
		MenuGui.Enabled = visible
	end
	if visible then
		InQueue = false
	end
end

function MainMenuUI.IsVisible(): boolean
	return if MenuGui then MenuGui.Enabled else false
end

function MainMenuUI.UpdateProfileData(profile: any, leaderboard: any)
	if type(profile) == &quot;table&quot; then
		CurrentProfile = profile
		if TopProfileBadge then
			TopProfileBadge.Text = string.format(
				&quot;LVL %d // %d COINS // %dW - %dL // KILLS: %d&quot;,
				profile.Level or 1,
				profile.Coins or 0,
				profile.Wins or 0,
				profile.Losses or 0,
				profile.Kills or 0
			)
		end
		if MainMenuUI.OnSettingsChanged and profile.Settings then
			MainMenuUI.OnSettingsChanged(profile.Settings)
		end
	end
	if type(leaderboard) == &quot;table&quot; then
		CurrentLeaderboard = leaderboard
	end

	if MenuGui and MenuGui.Enabled then
		if ActivePanelName == &quot;Shop&quot; then
			MainMenuUI.RenderShopModal()
		elseif ActivePanelName == &quot;Profile&quot; then
			MainMenuUI.RenderProfileModal()
		end
	end
end

function MainMenuUI.HandleNotification(notifType: string, payload: { [string]: any })
	if not StatusBannerLabel then
		return
	end
	if notifType == &quot;QueueStatus&quot; then
		InQueue = payload.InQueue == true
		StatusBannerLabel.Text = tostring(payload.Message or &quot;&quot;)
		StatusBannerLabel.TextColor3 = Color3.fromRGB(0, 245, 255)
		if ActivePanelName == &quot;Play1v1&quot; then
			MainMenuUI.RenderPlay1v1Modal()
		end
	elseif notifType == &quot;PrivateRoomCreated&quot; then
		StatusBannerLabel.Text = &quot;PRIVATE ROOM CREATED! CODE: &quot;
			.. tostring(payload.RoomCode)
			.. &quot; (SHARE WITH FRIEND OR CLICK JOIN TO TEST SOLO)&quot;
		StatusBannerLabel.TextColor3 = Color3.fromRGB(0, 255, 190)
	elseif notifType == &quot;IncomingChallenge&quot; then
		local challenger = tostring(payload.ChallengerName or &quot;Player&quot;)
		StatusBannerLabel.Text = &quot;DUEL CHALLENGE FROM &quot; .. challenger .. &quot;! CLICK FRIEND MATCH TO ACCEPT&quot;
		StatusBannerLabel.TextColor3 = Color3.fromRGB(255, 50, 185)
		local fmRemote = Remotes:FindFirstChild(&quot;FriendMatchAction&quot;) :: RemoteEvent?
		if fmRemote then
			-- Auto-display accept button on right modal
			if RightModalContainer then
				makeCyberButton(
					RightModalContainer,
					&quot;ACCEPT 1VS1 DUEL FROM &quot; .. string.upper(challenger),
					UDim2.new(1, -36, 0, 44),
					UDim2.new(0, 18, 1, -56),
					Color3.fromRGB(0, 255, 190),
					function()
						fmRemote:FireServer(&quot;AcceptChallenge&quot;, {})
					end
				)
			end
		end
	elseif notifType == &quot;Error&quot; then
		StatusBannerLabel.Text = tostring(payload.Message or &quot;ERROR&quot;)
		StatusBannerLabel.TextColor3 = Color3.fromRGB(255, 70, 100)
	elseif notifType == &quot;Info&quot; then
		StatusBannerLabel.Text = tostring(payload.Message or &quot;&quot;)
		StatusBannerLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
	end
end

function MainMenuUI.GetProfile(): any
	return CurrentProfile
end

return MainMenuUI

</ProtectedString>
        </Properties>
      </Item>
